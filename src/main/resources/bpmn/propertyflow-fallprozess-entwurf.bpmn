<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_PropertyFlow_Draft" targetNamespace="https://propertyflow.local/bpmn/draft" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Message_CaseDataChange" name="Falldaten ergänzen angefordert">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= processInstanceKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_StaffTakeover" name="Bearbeitung während Abklärung übernehmen">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= processInstanceKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_StaffFollowClarification" name="Direkte Wiedervorlage angefordert">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= processInstanceKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_StaffCloseClarification" name="Mitarbeiterabschluss während Abklärung angefordert">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= processInstanceKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:escalation id="Escalation_StaffCloseCommitted" name="Mitarbeiterabschluss aus Abklärung gespeichert" escalationCode="STAFF_CLARIFICATION_CLOSURE_COMMITTED" />
  <bpmn:message id="Message_StaffQuestionClarification" name="Mitarbeiternachricht während Abklärung angefordert">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=processInstanceKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_ReviewRequired" name="Fachlicher Prüfbedarf festgestellt">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= processInstanceKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_StaffCloseReply" name="Mitarbeiterabschluss im Mieterwartepfad angefordert">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= processInstanceKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_ClearAnswer" name="Antwortbedarf aufheben angefordert">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= processInstanceKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Error_ReopenRejected" name="Wiedereröffnung abgelehnt" errorCode="REOPEN_REJECTED" />
  <bpmn:error id="Error_ClosureMessageInvalid" name="LLM-Nachricht inhaltlich unzulässig" errorCode="CLOSURE_MESSAGE_INVALID" />
  <bpmn:error id="Error_AutoClosureStale" name="Automatischer Abschluss veraltet" errorCode="AUTO_CLOSURE_STALE" />
  <bpmn:message id="Message_TenantMessage" name="Mieternachricht gespeichert">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= processInstanceKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Error_TriageFailure" name="KI-Analyse fehlgeschlagen" errorCode="TRIAGE_ANALYSIS_FAILED">
    <bpmn:documentation>Fachliche Fehlerreaktion des Entwurfs. Der spätere Worker meldet eine festgestellte fehlgeschlagene Analyse oder ungültige Modellausgabe ausdrücklich als diesen BPMN-Fehler. Ein technischer Jobfehler allein aktiviert den Fehlerpfad nicht. Die Mitarbeiterprüfung wartet nicht auf das Ausschöpfen automatischer Wiederholungen.</bpmn:documentation>
  </bpmn:error>
  <bpmn:error id="Error_StaffClosureStale" name="Mitarbeiterentscheidung veraltet" errorCode="STAFF_CLOSURE_STALE">
    <bpmn:documentation>Fachlicher Konflikt des bestätigten Mitarbeiterabschlusses gemäss FALL-07 / FALL-AK-22. Der Dienst hat vor erfolgreicher Abschlussspeicherung festgestellt, dass die bestätigte Entscheidungsgrundlage nicht mehr aktuell ist. Der spätere Worker meldet den Fehler ausdrücklich; ein technischer Speicherfehler oder bloss laufende KI genügt nicht. Ein bereits erfolgreich gespeicherter identischer Abschluss wird idempotent bestätigt und meldet diesen Fehler nicht. Kein pauschaler Fehlerpfad für doppelte oder überholte automatische Empfehlungen.</bpmn:documentation>
  </bpmn:error>
  <bpmn:error id="Error_PublicationStale" name="Veröffentlichungsgrundlage überholt" errorCode="PUBLICATION_BASIS_STALE">
    <bpmn:documentation>Zeile 2, fachlicher Platzhalter: Dienst erkennt bei synchronisierter Prüfung vor Veröffentlichung eine neue relevante gespeicherte Mieternachricht, die die Grundlage überholt. Keine Nachricht gespeichert, kein neuer Antwortbedarf und kein zugehöriger Mailauftrag. Technische Speicherfehler und Wiederholung einer bereits erfolgreichen Veröffentlichung sind keine solchen Konflikte. Nicht direkt durch Nachrichteneingang ausgelöst; keine ausführbare Implementierung.</bpmn:documentation>
  </bpmn:error>
  <bpmn:error id="Error_AnalysisStale" name="Analysegrundlage überholt" errorCode="ANALYSIS_BASIS_STALE">
    <bpmn:documentation>Fachlicher Platzhalter für Zeilen 1 und 3: Die Auswertung enthält neue relevante gespeicherte Mieternachrichten noch nicht. In Validate führt der Konflikt zur aktuellen Analysegrundlage; in RValidate zur aktuellen Antwortauswertung. Kein technischer Jobfehler und kein Analysefehler. Meldung durch den späteren Prüfdienst, nicht automatisch durch blossen Nachrichteneingang. Keine zweite unabhängige Verarbeitung; aktuelle Mitarbeiterentscheidung und Abschluss schützen. Keine Ausführungsimplementierung.</bpmn:documentation>
  </bpmn:error>
  <bpmn:process id="PropertyFlow_Case_Draft" name="PropertyFlow · Fallprozess · Fachentwurf 0.35" isExecutable="true">
    <bpmn:documentation>Fachentwurf 0.13, nicht ausführbar. Individuelle LLM-Nachricht im AutoAnswer-Worker erzeugen, prüfen, speichern und Versand beauftragen; danach Close. Kein Vorlagenkatalog, keine zusätzliche Abschlussmail. Mitarbeiterabschluss ohne Nachricht. Menschliche Priorität, Aktualität, Rückfragen, Wiedervorlage und bisherige Konfliktrückwege bleiben. Technische Fehler: Job-Retries/Incidents. Start-/Kindinstanz-Verträge weiterhin vor Ausführung konkretisieren; keine Backend-Implementierung.
Fachentwurf 0.15: Wiedereröffnung startet eine neue Instanz für denselben Fall; direkter Mitarbeiterpfad gemäss FALL-07. Keine Backend-Implementierung.</bpmn:documentation>
    <bpmn:subProcess id="ActiveCase" name="REVIEW">
      <bpmn:documentation>Empfangsbereich der führenden Fallprozessinstanz. Der Prozessschlüssel ist beim Eintritt bereits als Korrelationswert verfügbar. Der einzige Empfänger für Mieternachrichten bleibt über Analyse, Rückfrage, Mitarbeiterprüfung und Wiedervorlage hinweg aktiv. Register bestätigt die führende Zuordnung erst innerhalb dieses Bereichs. Das terminierende Ende wird ausschliesslich nach erfolgreichem fachlichem Abschluss erreicht und beendet nur diesen Bereich samt seinen laufenden Nachrichtenauswertungen. Späte externe Ergebnisse bleiben zusätzlich durch fachliche Versions- und Statusprüfungen gesperrt.
Die Calls Reply und Staff sowie verschachtelte Calls gehören zum aktiven Ausführungsbaum. Fachlichen Abschluss zuerst speichern, dann aktiven Bereich samt untergeordneten Ausführungen beenden. Späte Worker bleiben durch serverseitige Prüfung gesperrt. Call-Abbruch darf keine normale Abschlussentscheidung liefern.
Wiedereröffnung: Der Empfang wird ebenfalls vor der bestätigten neuen Zuordnung vorbereitet. ReopenRejectedEnd beendet ausschliesslich einen abgelehnten neuen Start ohne fachlichen Abschluss oder Statusänderung. Der bisherige Abschluss bleibt dann bestehen.</bpmn:documentation>
      <bpmn:incoming>P02</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:startEvent id="Start" name="Empfangsbereich aktiv">
        <bpmn:outgoing>F01</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Register" name="Führenden Prozess&#10;dem Fall zuordnen">
        <bpmn:documentation>ADR-002: processInstanceKey und Erledigung des Startauftrags gemeinsam speichern. Gleiche Instanz idempotent bestätigen, abweichende Instanz nicht weiterbearbeiten. Bis zum Commit bleibt Eingegangen. Die zentrale Nachrichten-Subscription ist beim Start dieses Jobs bereits aktiv. Die vorgelagerte Bereitstellung des Korrelationswerts allein aktiviert den Fall nicht.
Nur Erstanlage. Eine Wiedereröffnung darf ausschliesslich ReopenCase zuordnen; keine allgemeine Erlaubnis zum Überschreiben einer führenden Instanz.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow-register-case" />
        </bpmn:extensionElements>
        <bpmn:incoming>F_Initial</bpmn:incoming>
        <bpmn:outgoing>F02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Merge_Reply" gatewayDirection="Converging">
        <bpmn:incoming>F17</bpmn:incoming>
        <bpmn:incoming>F19</bpmn:incoming>
        <bpmn:incoming>CA06</bpmn:incoming>
        <bpmn:incoming>Flow_03pax24</bpmn:incoming>
        <bpmn:outgoing>Flow_Merge_Reply</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:callActivity id="Reply" name="Mieterantwort abwarten&#10;und Fortsetzung prüfen">
        <bpmn:documentation>
Ruft mieterantwort-pruefen.bpmn auf. Vertrag: teilprozess-vertraege.md. Untergeordnete Instanz mit eigenem Scope; führende Fallzuordnung bleibt im Hauptprozess. Eingangsreferenz vor Aktivierung bereitstellen. Nur explizite Outputs übernehmen; aktueller Fallstand bleibt vor Wirkung zu prüfen.
0.27: StaffFollowAtReply unterbricht den gesamten Call erst nach bestätigter Terminsetzung. Laufende Auswertungen verlieren bereits ab Commit die Wirkungsfreigabe; offene Fragen bleiben erhalten. Marker gilt nur für den betroffenen Aufruf und muss auch den Übergang zu Folgeschritten zuverlässig abdecken.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:calledElement processId="PropertyFlow_TenantReply_Draft" propagateAllChildVariables="false" propagateAllParentVariables="false" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= caseId" target="caseId" />
            <zeebe:input source="= processInstanceKey" target="leadingProcessInstanceKey" />
            <zeebe:input source="= replyEntryContextRef" target="entryContextRef" />
            <zeebe:input source="= staffEntryContextRef" target="staffEntryContextRef" />
            <zeebe:output source="= outcome" target="replyOutcome" />
            <zeebe:output source="= decisionRef" target="replyDecisionRef" />
            <zeebe:output source="= if outcome = &#34;REVIEW&#34; then decisionRef else staffEntryContextRef" target="staffEntryContextRef" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Merge_Reply</bpmn:incoming>
        <bpmn:outgoing>F09</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="Flow_Merge_Reply" sourceRef="Merge_Reply" targetRef="Reply" />
      <bpmn:exclusiveGateway id="ReplyRoute" name="Ergebnis der Antwortprüfung">
        <bpmn:documentation>
Nur das aktuell geprüfte Fortsetzungsergebnis verwenden; genau einen Ausgang wählen. Keine erneute eigene Klassifikation oder Bewertung. FEEL-Ergebniswerte noch festzulegen.
Nach Call-Rückkehr ausschliesslich replyOutcome / replyDecisionRef auswerten. Unbekannte oder fehlende Rückgabe ist technischer Vertragsfehler, kein Default-Fachentscheid. Aktuellen Fallstand und Aufrufzuordnung prüfen. Werte und Zuweisungen stehen in teilprozess-vertraege.md; FEEL-Routing weiterhin nicht ausführbar.</bpmn:documentation>
        <bpmn:incoming>F09</bpmn:incoming>
        <bpmn:outgoing>F19</bpmn:outgoing>
        <bpmn:outgoing>F21</bpmn:outgoing>
        <bpmn:outgoing>F18</bpmn:outgoing>
        <bpmn:outgoing>F20</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Merge_Close" gatewayDirection="Converging">
        <bpmn:incoming>F16</bpmn:incoming>
        <bpmn:incoming>CR06</bpmn:incoming>
        <bpmn:outgoing>Flow_Merge_Close</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Close" name="Mitarbeiterabschluss prüfen&#10;und speichern">
        <bpmn:documentation>FALL-07: Ausschliesslich Mitarbeiterabschluss aus aktueller bestätigter Entscheidung. Derselbe fachliche Abschlussvertrag wie AutoClose; keine zweite Domänenlogik. Berechtigung, führenden Durchlauf und aktuellen Fallstand einschliesslich neuer Nachrichten prüfen. Laufende KI allein blockiert den Mitarbeiterabschluss nicht. Ohne Nachrichten- oder Kommentarpflicht. Speicherung konsistent gegen konkurrierende Änderungen prüfen; veraltet -&gt; STAFF_CLOSURE_STALE und CloseConflict zur Mitarbeiterprüfung. Technische Fehler Retry/Incident. Bereits erfolgreicher identischer Auftrag bleibt Erfolg. Antwortbedarf/Wiedervorlage bei Erfolg beenden; keine zusätzliche Abschlussmail, frühere Nachrichten und Mailpflichten erhalten. Nach Commit beendet ActiveEnd den aktiven Bereich; späte Worker dürfen nicht wirken.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.staff.close" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Merge_Close</bpmn:incoming>
        <bpmn:outgoing>FActiveClose</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_Merge_Close" sourceRef="Merge_Close" targetRef="Close" />
      <bpmn:boundaryEvent id="CloseConflict" name="Mitarbeiterentscheidung&#10;veraltet" attachedToRef="Close">
        <bpmn:documentation>Unterbricht nur den Abschlussversuch vor erfolgreicher fachlicher Speicherung. FActiveClose und damit das terminierende Ende werden nicht erreicht. Die erledigte Mitarbeiteraufgabe wird nicht reaktiviert: Rückkehr in Staff stellt genau eine neue Aufgabe für den aktuellen Fallstand bereit. Alte Abschlussfreigabe verwerfen; internen Grund Fallstand seit Abschlussbestätigung geändert übernehmen. Kein Abschlussnachweis, kein Abschlussmailauftrag und keine Wiedereröffnung. ActiveCase und der zentrale Mieternachrichtenempfang bleiben aktiv. Wiederholungen dürfen die neue Aufgabe nicht duplizieren. Vor User-Task-Abschluss abgewiesene veraltete Aktionen lassen die bisherige Aufgabe offen und laufen nicht über dieses Ereignis.
0.20: Gilt auch für direkten Mitarbeiterabschluss aus Wartet auf Mieterantwort. Nach übernommener Entscheidung festgestellter Konflikt führt genau einmal zu Mitarbeiterprüfung am aktuellen Fallstand; offener Antwortbedarf bleibt bis zur zulässigen Erledigung bestehen. Vor Übernahme abgelehnte Aufträge erreichen diesen Pfad nicht.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= staffEntryContextRef" target="staffEntryContextRef" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:outgoing>F_CloseConflict_Staff</bpmn:outgoing>
        <bpmn:errorEventDefinition id="CloseConflict_definition" errorRef="Error_StaffClosureStale" />
      </bpmn:boundaryEvent>
      <bpmn:callActivity id="Staff" name="Mitarbeiterprüfung&#10;und weitere Bearbeitung">
        <bpmn:documentation>
Ruft mitarbeiterbearbeitung.bpmn auf. Vertrag: teilprozess-vertraege.md. Untergeordnete Instanz mit eigenem Scope; führende Fallzuordnung bleibt im Hauptprozess. Eingangsreferenz vor Aktivierung bereitstellen. Nur explizite Outputs übernehmen; aktueller Fallstand bleibt vor Wirkung zu prüfen.
0.19: Geprüfter Eintritt nach manueller Aufhebung des letzten Antwortbedarfs ohne Prüfbedarf führt direkt zu SWork. entryContextRef wird durch ClearAnswerContinue serverseitig bereitgestellt; mit Prüfbedarf regulärer Review-Eintritt.
0.35: Einziger Eingang SCStart nach exklusiver Übernahme. entryContextRef enthält den gültigen Anspruch für diesen Ausführungspfad. SEntryCheck registriert die tatsächliche Kindinstanz dazu. Reservierung und Engine-Call müssen nach Absturz abgeglichen werden, kein zweiter paralleler Call bei unklarer Startantwort.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:calledElement processId="PropertyFlow_Staff_Draft" propagateAllChildVariables="false" propagateAllParentVariables="false" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= caseId" target="caseId" />
            <zeebe:input source="= processInstanceKey" target="leadingProcessInstanceKey" />
            <zeebe:input source="= staffEntryContextRef" target="entryContextRef" />
            <zeebe:output source="= outcome" target="staffOutcome" />
            <zeebe:output source="= decisionRef" target="staffDecisionRef" />
            <zeebe:output source="= if outcome = &#34;WAIT_FOR_REPLY&#34; then decisionRef else &#34;&#34;" target="replyEntryContextRef" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>SCStart</bpmn:incoming>
        <bpmn:outgoing>F15</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="EntryRoute" />
      <bpmn:sequenceFlow id="F09" sourceRef="Reply" targetRef="ReplyRoute" />
      <bpmn:sequenceFlow id="F15" sourceRef="Staff" targetRef="StaffRoute" />
      <bpmn:sequenceFlow id="F17" name="Rückfrage veröffentlicht" sourceRef="StaffRoute" targetRef="Merge_Reply">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffOutcome = "WAIT_FOR_REPLY"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F19" name="Fragen bleiben offen" sourceRef="ReplyRoute" targetRef="Merge_Reply">
        <bpmn:documentation>
Geprüftes Ergebnis Weiter warten übernehmen. Verbrauch dieses Ergebnisstands nachvollziehbar sichern; derselbe Stand darf nicht erneut wecken, ein bereits verfügbarer neuerer Stand darf nicht verloren gehen.</bpmn:documentation>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyOutcome = "WAIT"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F21" name="Prüfung erforderlich" sourceRef="ReplyRoute" targetRef="Merge_StaffContinuationClaim">
        <bpmn:documentation>
Nur fachliches Prüfergebnis aus RReview: Pflichtprüfbedarf/Analysefehler oder vollständige Beantwortung ohne zulässigen Abschluss beziehungsweise andere bestehende fachliche Prüfgründe. Kein Fallback für veraltete oder doppelte Auswertungen.</bpmn:documentation>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyOutcome = "REVIEW"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:exclusiveGateway id="Merge_ActiveEnd" gatewayDirection="Converging">
        <bpmn:incoming>FActiveClose</bpmn:incoming>
        <bpmn:outgoing>Flow_Merge_ActiveEnd</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="ActiveEnd" name="Aktive Bearbeitung beendet">
        <bpmn:documentation>Erst nach erfolgreichem Close-Commit. Terminiert nur ActiveCase samt laufenden Ereignis-Teilprozessen und Empfang; der äussere Prozess endet danach ohne Abschlussmail. Kein fachlicher Abschluss allein durch ein technisches Endereignis.</bpmn:documentation>
        <bpmn:incoming>Flow_Merge_ActiveEnd</bpmn:incoming>
        <bpmn:terminateEventDefinition id="ActiveEnd_definition" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Merge_ActiveEnd" sourceRef="Merge_ActiveEnd" targetRef="ActiveEnd" />
      <bpmn:sequenceFlow id="FActiveClose" sourceRef="Close" targetRef="Merge_ActiveEnd" />
      <bpmn:sequenceFlow id="F_CloseConflict_Staff" name="Aktuellen Fallstand erneut prüfen" sourceRef="CloseConflict" targetRef="Event_1fbvxyl" />
      <bpmn:subProcess id="TenantInbox" name="Mieternachrichten&#10;durchgängig empfangen" triggeredByEvent="true">
        <bpmn:documentation>Einziger externer Empfänger für Message_TenantMessage in der führenden Prozessinstanz. Nicht unterbrechend und je Nachricht aktivierbar. Eingangs-ID und Analysekontext müssen pro Aufruf lokal bleiben. Keine globale überschreibbare letzte Nachricht. Steuerinformationen werden versionsgeprüft bereitgestellt: im ActiveCase-Bereich für den Hauptpfad und ausdrücklich in der aktuellen Kindinstanz für ausgelagerte Wartepunkte (teilprozess-vertraege.md). Rechteprüfung und Speicherung erfolgen vor Korrelation gemäss SS-003; Korrelation bestätigt Empfang, nicht abgeschlossene LLM-Auswertung. Keine eigene Veröffentlichung, Statusfreigabe oder Schliessung aus diesem Nebenpfad.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="= null" target="tenantMessageId" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:startEvent id="NStart" name="Mieternachricht gespeichert" isInterrupting="false">
          <bpmn:outgoing>NReceive_Call</bpmn:outgoing>
          <bpmn:messageEventDefinition id="NStart_definition" messageRef="Message_TenantMessage" />
        </bpmn:startEvent>
        <bpmn:callActivity id="ProcessTenantMessage" name="Mieternachricht&#10;verarbeiten">
          <bpmn:documentation>Ruft mieternachricht-verarbeiten.bpmn je empfangener Nachricht auf. tenantMessageId muss lokal aus der korrelierten gespeicherten Nachricht übernommen werden, niemals in einer überschreibbaren Root-Variable. Keine Outputs; keine Antwort-, Status- oder Abschlussfreigabe durch Call-Ende. Empfangsbestätigung wartet nicht auf Verarbeitung. Interne Bereitstellung gemäss teilprozess-vertraege.md.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:calledElement processId="PropertyFlow_TenantMessage_Draft" propagateAllChildVariables="false" propagateAllParentVariables="false" bindingType="deployment" />
            <zeebe:ioMapping>
              <zeebe:input source="= caseId" target="caseId" />
              <zeebe:input source="= processInstanceKey" target="leadingProcessInstanceKey" />
              <zeebe:input source="= tenantMessageId" target="tenantMessageId" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:incoming>NReceive_Call</bpmn:incoming>
          <bpmn:outgoing>NReceive_End</bpmn:outgoing>
        </bpmn:callActivity>
        <bpmn:endEvent id="NReceptionEnd" name="Dieser Eingang verarbeitet">
          <bpmn:incoming>NReceive_End</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="NReceive_Call" sourceRef="NStart" targetRef="ProcessTenantMessage" />
        <bpmn:sequenceFlow id="NReceive_End" sourceRef="ProcessTenantMessage" targetRef="NReceptionEnd" />
      </bpmn:subProcess>
      <bpmn:exclusiveGateway id="EntryRoute" name="Erstanlage oder&#10;Wiedereröffnung?">
        <bpmn:incoming>F01</bpmn:incoming>
        <bpmn:outgoing>F_Initial</bpmn:outgoing>
        <bpmn:outgoing>F_Reopen</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="ReopenCase" name="Wiedereröffnung prüfen&#10;Neuen Durchlauf zuordnen">
        <bpmn:documentation>BEN-03 / 0.23: Bei tatsächlicher benachrichtigungspflichtiger Änderung Ereignis und Mailpflicht dauerhaft zusammen sichern. Der dauerhafte Starter startet fallbenachrichtigung-versenden.bpmn mit mailOrderRef; dort beauftragen Camunda-Send-Tasks den Mail-Worker. Hier kein direkter SMTP-Aufruf und kein Warten auf SMTP. Unveränderte Werte und identische Wiederholungen erzeugen keine neue Mailpflicht.
FALL-07 / ADR-002 Ergänzung 15.11.2026: Autorisierten Wiedereröffnungsauftrag, abgeschlossenen Fall, beendete Vorgängerinstanz und aktuelle Generation prüfen. Neue führende Instanz, Generation, Zielstatus, Mitarbeiter und Auftragserledigung konsistent speichern. Ohne offenen Prüfbedarf In Bearbeitung, sonst Mitarbeiterprüfung erforderlich. Geprüften staffEntryContextRef bereitstellen. Bis Commit bleibt der Fall abgeschlossen und gesperrt. Identischen erfolgreichen Auftrag mit derselben Instanz idempotent bestätigen; fremde oder überholte Instanz niemals übernehmen. Fachliche Ablehnung ausdrücklich REOPEN_REJECTED; technische Fehler bleiben Job-Retries/Incidents. Keine neue Fallanlage, Ersttriage oder Reaktivierung alter Aufgaben.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.case.reopen" />
        </bpmn:extensionElements>
        <bpmn:incoming>F_Reopen</bpmn:incoming>
        <bpmn:outgoing>F_Reopen_Staff</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="F_Initial" name="Erstanlage" sourceRef="EntryRoute" targetRef="Register">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= startKind = "INITIAL"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F_Reopen" name="Wiedereröffnung" sourceRef="EntryRoute" targetRef="ReopenCase">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= startKind = "REOPEN"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F_Reopen_Staff" name="" sourceRef="ReopenCase" targetRef="Event_1bcg88b" />
      <bpmn:boundaryEvent id="ReopenRejected" name="Auftrag nicht mehr gültig" attachedToRef="ReopenCase">
        <bpmn:outgoing>F_ReopenRejected</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ReopenRejected_definition" errorRef="Error_ReopenRejected" />
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="ReopenRejectedEnd" name="Start abgelehnt&#10;Keine Falländerung">
        <bpmn:incoming>F_ReopenRejected</bpmn:incoming>
        <bpmn:terminateEventDefinition id="ReopenRejectedEnd_definition" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="F_ReopenRejected" name="" sourceRef="ReopenRejected" targetRef="ReopenRejectedEnd" />
      <bpmn:subProcess id="ClearAnswerSide" name="Mitarbeiteraktion: Antwortbedarf aufheben" triggeredByEvent="true">
        <bpmn:documentation>
Nicht unterbrechender Mitarbeitereingang in jeder aktiven Phase. Keine Mieternachricht und keine KI-Auswertung erforderlich. Lokale Auftragsdaten; keine pauschale Überschreibung von Hauptpfadvariablen. Nach Fallabschluss keine neuen Wirkungen.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="= null" target="clearAnswerCommandRef" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:startEvent id="ClearAnswerStart" name="Geprüfter Mitarbeiterauftrag" isInterrupting="false">
          <bpmn:outgoing>CA01</bpmn:outgoing>
          <bpmn:messageEventDefinition id="ClearAnswerStart_definition" messageRef="Message_ClearAnswer" />
        </bpmn:startEvent>
        <bpmn:serviceTask id="ClearAnswerApply" name="Antwortbedarf geprüft aufheben&#10;Fortsetzung bereitstellen">
          <bpmn:documentation>
KOM-03: Berechtigung, aktuellen Fall, Nachricht, Antwortbedarf, führende Instanz und Auftragsversion prüfen. Nur gezielten Bedarf idempotent aufheben, Nachricht erhalten und nicht als beantwortet markieren. Weitere offene Fragen: keine Statusänderung. Laufende Mitarbeiterprüfung, Wiedervorlage und externe Wartephase erhalten. Nur beim aktuellen Reply-Aufruf und letztem aufgehobenen Bedarf den geprüften Fortsetzungsmarker mit Call-Bezug dauerhaft bereitstellen. Bereits bestehende Prüfgründe haben Vorrang. Neue Fragen und konkurrierende Entscheidungen dürfen nicht überschrieben werden. Abgelehnte oder veraltete Aktionen bleiben ohne Wirkung; technische Fehler Retry/Incident. Speicherung und Markerzustellung müssen wiederholbar ohne Lücke sein. Keine direkte User-Task-Erledigung.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.answer.clear" />
          </bpmn:extensionElements>
          <bpmn:incoming>CA01</bpmn:incoming>
          <bpmn:outgoing>CA02</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="ClearAnswerEnd" name="Nur Nebenaktion beendet">
          <bpmn:incoming>CA02</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="CA01" name="" sourceRef="ClearAnswerStart" targetRef="ClearAnswerApply" />
        <bpmn:sequenceFlow id="CA02" name="" sourceRef="ClearAnswerApply" targetRef="ClearAnswerEnd" />
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="ReplyCleared" name="Antwortbedarf aufgehoben" attachedToRef="Reply">
        <bpmn:documentation>
Nur aktuell freigegebenen Aufhebungsmarker zum aktiven Reply-Call verwenden. Teilaufhebung unterbricht den Call nicht. Marker und Unterbrechung vor Ausführung mit neuen Fragen, Mitarbeiterentscheidung, Fallabschluss und Call-Wechsel koordinieren; alte Marker niemals auf neuere Calls anwenden. Kein normaler Output des abgebrochenen Calls.</bpmn:documentation>
        <bpmn:outgoing>CA03</bpmn:outgoing>
        <bpmn:conditionalEventDefinition id="ReplyCleared_definition">
          <bpmn:condition xsi:type="bpmn:tFormalExpression">= (clearedAnswerCallRef != null and clearedAnswerCallRef = activeReplyCallRef and activeReplyEntryRef != null and activeReplyEntryRef = replyEntryContextRef) or (clearedReplyEntryRef != null and clearedReplyEntryRef = replyEntryContextRef)</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="AutomaticResultCleared" name="Antwortbedarf bei Übergabe aufgehoben" attachedToRef="AutomaticResult">
        <bpmn:outgoing>AutomaticResultClearFlow</bpmn:outgoing>
        <bpmn:conditionalEventDefinition id="AutomaticResultCleared_definition">
          <bpmn:condition xsi:type="bpmn:tFormalExpression">= clearedAutomaticCallRef != null and clearedAutomaticCallRef = automaticCallRef</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="AutomaticResultClearFlow" sourceRef="AutomaticResultCleared" targetRef="Merge_ClearAnswerContinue" />
      <bpmn:exclusiveGateway id="Merge_ClearAnswerContinue" gatewayDirection="Converging">
        <bpmn:incoming>CA03</bpmn:incoming>
        <bpmn:incoming>AutomaticResultClearFlow</bpmn:incoming>
        <bpmn:outgoing>Merge_ClearAnswerContinueFlow</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Merge_ClearAnswerContinueFlow" sourceRef="Merge_ClearAnswerContinue" targetRef="ClearAnswerContinue" />
      <bpmn:serviceTask id="ClearAnswerContinue" name="Aktuelle Fortsetzung prüfen&#10;Mitarbeitereintritt vorbereiten">
        <bpmn:documentation>BEN-03 / 0.23: Bei tatsächlicher benachrichtigungspflichtiger Änderung Ereignis und Mailpflicht dauerhaft zusammen sichern. Der dauerhafte Starter startet fallbenachrichtigung-versenden.bpmn mit mailOrderRef; dort beauftragen Camunda-Send-Tasks den Mail-Worker. Hier kein direkter SMTP-Aufruf und kein Warten auf SMTP. Unveränderte Werte und identische Wiederholungen erzeugen keine neue Mailpflicht.
Dauerhaften Aufhebungsentscheid und aktuellen Fall-/Call-Stand laden, nicht auf Outputs des abgebrochenen Calls warten. Ohne offenen Antwortbedarf und ohne vorrangigen Prüfbedarf In Bearbeitung konsistent speichern und staffEntryContextRef für direkten SWork-Eintritt bereitstellen. Bei aktuellem Prüfbedarf Kontext für Mitarbeiterprüfung setzen. Bei inzwischen neuen offenen Fragen ohne Prüfbedarf aktuellen Reply-Kontext bereitstellen und weiter warten. Bestehende Mitarbeiter-/Wiedervorlageinstanz nicht duplizieren; überholte Aufträge dürfen keine neuere Bearbeitung verdrängen. Keine erneute KI-Analyse, keine Abschlussfreigabe. Technische Konfliktkoordination bleibt offen.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.answer.continue" />
        </bpmn:extensionElements>
        <bpmn:incoming>Merge_ClearAnswerContinueFlow</bpmn:incoming>
        <bpmn:outgoing>CA04</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="ClearAnswerRoute" name="Aktueller&#10;Fortsetzungsweg">
        <bpmn:incoming>CA04</bpmn:incoming>
        <bpmn:outgoing>CA05</bpmn:outgoing>
        <bpmn:outgoing>CA06</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="CA03" name="" sourceRef="ReplyCleared" targetRef="Merge_ClearAnswerContinue" />
      <bpmn:sequenceFlow id="CA04" name="" sourceRef="ClearAnswerContinue" targetRef="ClearAnswerRoute" />
      <bpmn:sequenceFlow id="CA05" name="In Bearbeitung / vorrangige Prüfung" sourceRef="ClearAnswerRoute" targetRef="Merge_StaffContinuationClaim">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clearAnswerOutcome = "STAFF"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CA06" name="Neue offene Fragen; weiter warten" sourceRef="ClearAnswerRoute" targetRef="Merge_Reply">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clearAnswerOutcome = "WAIT"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:subProcess id="StaffCloseReplySide" name="Mitarbeiterabschluss während Warten auf Mieterantwort" triggeredByEvent="true">
        <bpmn:documentation>
Nicht unterbrechender Auftragseingang. Keine vorgängige Aufhebung des Antwortbedarfs nötig. Dieser Eingang gilt ausschliesslich für den aktuellen Reply-Call bei Wartet auf Mieterantwort; bestehende Abschlussaktionen anderer Phasen bleiben unverändert. Auftragsdaten lokal halten.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="= null" target="replyClosureCommandRef" />
            <zeebe:input source="= null" target="replyClosureOutcome" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:startEvent id="StaffCloseReplyStart" name="Mitarbeiter bestätigt Abschluss" isInterrupting="false">
          <bpmn:outgoing>CR01</bpmn:outgoing>
          <bpmn:messageEventDefinition id="StaffCloseReplyStart_definition" messageRef="Message_StaffCloseReply" />
        </bpmn:startEvent>
        <bpmn:serviceTask id="StaffCloseReplyCheck" name="Abschlussauftrag und&#10;aktuellen Fallstand prüfen">
          <bpmn:documentation>
Berechtigte Mitarbeiteridentität, bestätigten fachlichen Fallstand, Status Wartet auf Mieterantwort, führende Instanz und aktuellen Reply-Call serverseitig prüfen. Keine offene Mitarbeiter-User-Task erfinden: Autorisierung bindet hier an den aktuellen Warteaufruf. Unberechtigter, veralteter oder inzwischen anders zugeordneter Auftrag wird ohne Unterbrechung abgelehnt. Gültige Entscheidung mit Quelle Mitarbeiter, Auftragsschlüssel und Call-Bezug dauerhaft nachweisen. Keine neue KI-Auswertung, keine Nachricht und kein Kommentar erforderlich. Technischer Fehler bleibt Retry/Incident. Wiederholung eines bereits gespeicherten identischen Abschlusses als Erfolg ohne neue Wirkung behandeln, nicht als neuen Auftrag übernehmen.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.reply-closure.check" />
          </bpmn:extensionElements>
          <bpmn:incoming>CR01</bpmn:incoming>
          <bpmn:outgoing>CR02</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="StaffCloseReplyAccepted" name="Auftrag&#10;übernommen?">
          <bpmn:incoming>CR02</bpmn:incoming>
          <bpmn:outgoing>CR03</bpmn:outgoing>
          <bpmn:outgoing>CR04</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="StaffCloseReplySignal" name="Geprüften Abschluss&#10;für aktuellen Warteaufruf bereitstellen">
          <bpmn:documentation>
Persistierten Entscheidungsbezug samt Quelle Mitarbeiter und aktuellem Call-Bezug zuverlässig bereitstellen. Marker und Unterbrechung atomar gegen Call-Wechsel, manuelles Aufheben, neue Fragen, automatische Veröffentlichung und Fallabschluss abstimmen. Nach Übernahme geänderte fachliche Grundlage führt über Close zur Mitarbeiterprüfung, niemals stillschweigend die alte Bestätigung aktualisieren. Eine andere bereits aktive Bearbeitung nicht abbrechen. Technische Koordination bleibt offen.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.reply-closure.signal" />
          </bpmn:extensionElements>
          <bpmn:incoming>CR03</bpmn:incoming>
          <bpmn:outgoing>CR05</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="StaffCloseReplyRejected" name="Abgelehnt&#10;Aktueller Pfad bleibt">
          <bpmn:incoming>CR04</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:endEvent id="StaffCloseReplyReady" name="Nur Auftrag bereitgestellt">
          <bpmn:incoming>CR05</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="CR01" name="" sourceRef="StaffCloseReplyStart" targetRef="StaffCloseReplyCheck" />
        <bpmn:sequenceFlow id="CR02" name="" sourceRef="StaffCloseReplyCheck" targetRef="StaffCloseReplyAccepted" />
        <bpmn:sequenceFlow id="CR03" name="Ja" sourceRef="StaffCloseReplyAccepted" targetRef="StaffCloseReplySignal">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyClosureOutcome = "ACCEPTED"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="CR04" name="Nein: Konflikt / nicht zulässig" sourceRef="StaffCloseReplyAccepted" targetRef="StaffCloseReplyRejected">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyClosureOutcome = "REJECTED"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="CR05" name="" sourceRef="StaffCloseReplySignal" targetRef="StaffCloseReplyReady" />
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="ReplyStaffClose" name="Abschluss bestätigt" attachedToRef="Reply">
        <bpmn:documentation>
Unterbrechung ausschliesslich für den aktuell gebundenen Reply-Aufruf. Keine normale Call-Rückgabe übernehmen. Close lädt den dauerhaft gespeicherten Mitarbeiterentscheid; Quelle niemals System. Erst nach erfolgreicher Abschlussspeicherung endet Antwortbedarf. Bei früher Ablehnung bleibt der aktuelle Pfad bestehen. Später fachlicher Konflikt nutzt STAFF_CLOSURE_STALE und CloseConflict.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &#34;CLOSE&#34;" target="staffOutcome" />
            <zeebe:output source="= staffReplyClosureDecisionRef" target="staffDecisionRef" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:outgoing>CR06</bpmn:outgoing>
        <bpmn:conditionalEventDefinition id="ReplyStaffClose_definition">
          <bpmn:condition xsi:type="bpmn:tFormalExpression">= staffCloseReplyCallRef != null and staffCloseReplyCallRef = activeReplyCallRef and staffCloseReplyEntryRef = replyEntryContextRef</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="CR06" name="Direkter Mitarbeiterabschluss" sourceRef="ReplyStaffClose" targetRef="Merge_Close" />
      <bpmn:subProcess id="ReviewNeedSide" name="Neuer Prüfbedarf – unabhängig von Mieternachrichten" triggeredByEvent="true">
        <bpmn:documentation>
Nicht unterbrechender interner Eingang für serverseitig festgestellten fachlichen Prüfbedarf. Keine neue öffentliche Schnittstelle und kein LLM-Auftrag. Nach beendetem ActiveCase existiert dieser Empfang nicht; nach Abschluss eintreffende Hinweise werden ausserhalb des beendeten Prozesses intern gespeichert, ohne Neustart.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="= null" target="reviewSignalRef" />
            <zeebe:input source="= null" target="reviewRoute" />
            <zeebe:input source="= null" target="reviewContinuationRef" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:startEvent id="ReviewNeedStart" name="Prüfbedarf gemeldet" isInterrupting="false">
          <bpmn:outgoing>PN01</bpmn:outgoing>
          <bpmn:messageEventDefinition id="ReviewNeedStart_definition" messageRef="Message_ReviewRequired" />
        </bpmn:startEvent>
        <bpmn:serviceTask id="ReviewNeedCheck" name="Grund und aktuellen&#10;Bearbeitungsstand prüfen">
          <bpmn:documentation>
FALL-06: Vertrauenswürdige Quelle, Fall, führenden Durchlauf, fachlichen Grund und Erkenntnisversion prüfen. Blosser Retry/Incident ist kein fachlicher Grund. Gleicher bereits berücksichtigter Grund ohne neue Erkenntnis erzeugt keine Prüfung. Wiederholungen idempotent verarbeiten. Neue Gründe dauerhaft erfassen, Entscheidung gegen aktuellen Status und Aufruf prüfen. Bereits abgeschlossener Fall: nur interner Hinweis, keine Statusänderung oder Wiedereröffnung. Lokale Nebenaktionsvariablen; aktuelle Mitarbeiterentscheidung nicht zurücknehmen.
0.30: Mit dauerhafter Bestätigung neuen zwingenden Prüfbedarfs alte automatische Wirkungsfreigaben sperren, bereits vor BPMN-Unterbrechung. Worker prüfen dies unmittelbar vor jeder Veröffentlichung, Statusänderung oder Abschluss. Gegen bereits wirksamen Abschluss und neuere Mitarbeiterentscheidung koordinieren; bereits veröffentlichte Nachrichten und Mailpflichten erhalten.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.review.check" />
          </bpmn:extensionElements>
          <bpmn:incoming>PN01</bpmn:incoming>
          <bpmn:outgoing>PN02</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="ReviewNeedRoute" name="Aktuelle&#10;Situation">
          <bpmn:incoming>PN02</bpmn:incoming>
          <bpmn:outgoing>PN03</bpmn:outgoing>
          <bpmn:outgoing>PN04</bpmn:outgoing>
          <bpmn:outgoing>PN05</bpmn:outgoing>
          <bpmn:outgoing>PN08</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="ReviewNeedExisting" name="Bestehende Prüfaufgabe&#10;um Grund ergänzen">
          <bpmn:documentation>
Aktuelle offene Mitarbeiterprüfung und ihren Kind-/Task-Bezug serverseitig prüfen. Dieselbe Aufgabe ergänzen, nicht abschliessen oder duplizieren. Keine erneute Prüfung aus identischen oder bereits berücksichtigten Erkenntnissen. Bei konkurrierendem Aufgabenwechsel aktuellen Stand neu prüfen, keine alte Aufgabe reaktivieren.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.review.merge" />
          </bpmn:extensionElements>
          <bpmn:incoming>PN03</bpmn:incoming>
          <bpmn:outgoing>PN06</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:serviceTask id="ReviewNeedWakeReply" name="Prüfbedarf für aktuellen&#10;Mieterwarte-Aufruf bereitstellen">
          <bpmn:documentation>
Nur für aktuellen Reply-Call bei Wartet auf Mieterantwort mit neuem fachlichem Prüfbedarf. Dauerhaften Prüfentscheid und aktuellen Call-Bezug zuverlässig bereitstellen. Markerbereitstellung und Unterbrechung gegen Call-Wechsel, Mitarbeiterabschluss, Aufhebung und neue Erkenntnisse koordinieren. Keine KI-Auswertung abwarten. Keine normalen Outputs vom abgebrochenen Call erwarten. Technische Realisierung bleibt offen.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.reply.wake-review" />
          </bpmn:extensionElements>
          <bpmn:incoming>PN04</bpmn:incoming>
          <bpmn:outgoing>PN07</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="ReviewNeedNoAction" name="Keine neue Prüfung&#10;aus dieser Meldung">
          <bpmn:incoming>PN05</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:exclusiveGateway id="Merge_ReviewNeedDone" gatewayDirection="Converging">
          <bpmn:incoming>PN06</bpmn:incoming>
          <bpmn:incoming>PN07</bpmn:incoming>
          <bpmn:incoming>PN09</bpmn:incoming>
          <bpmn:outgoing>Flow_Merge_ReviewNeedDone</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="ReviewNeedDone" name="Nur Nebenaktion beendet">
          <bpmn:incoming>Flow_Merge_ReviewNeedDone</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_Merge_ReviewNeedDone" sourceRef="Merge_ReviewNeedDone" targetRef="ReviewNeedDone" />
        <bpmn:sequenceFlow id="PN01" name="" sourceRef="ReviewNeedStart" targetRef="ReviewNeedCheck" />
        <bpmn:sequenceFlow id="PN02" name="" sourceRef="ReviewNeedCheck" targetRef="ReviewNeedRoute" />
        <bpmn:sequenceFlow id="PN03" name="Prüfung bereits offen" sourceRef="ReviewNeedRoute" targetRef="ReviewNeedExisting">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewRoute = "EXISTING"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="PN04" name="Neuer Grund im Mieterwartepfad" sourceRef="ReviewNeedRoute" targetRef="ReviewNeedWakeReply">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewRoute = "REPLY"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="PN05" name="Wiederholung / berücksichtigt / abgeschlossen" sourceRef="ReviewNeedRoute" targetRef="ReviewNeedNoAction">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewRoute = "NONE"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="PN06" name="" sourceRef="ReviewNeedExisting" targetRef="Merge_ReviewNeedDone" />
        <bpmn:sequenceFlow id="PN07" name="" sourceRef="ReviewNeedWakeReply" targetRef="Merge_ReviewNeedDone" />
        <bpmn:serviceTask id="ReviewNeedOther" name="Automatik unterbrechen oder&#10;aktuelle Mitarbeiterphase informieren">
          <bpmn:documentation>0.31: Bei Automatic bestätigten neuen zwingenden Prüfentscheid für aktuellen automaticCallRef im Elternscope bereitstellen und automaticInterruptionReady setzen. Gemeinsames Randereignis unterbricht auch blockierte Jobs/Incident. Ab Bestätigung alte Wirkungen sperren. Bei In Bearbeitung, Wiedervorlage oder externer Wartephase weiterhin vorhandenen SWorkReviewNeeded/SFollowUpReviewNeeded/SExternalReview bedienen. Aktuellen Scope serverseitig ermitteln, keine parallele Mitarbeiterinstanz, keine verlorene Meldung bei Phasenwechsel; zuverlässig nachholen.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.review.interrupt-automatic" />
          </bpmn:extensionElements>
          <bpmn:incoming>PN08</bpmn:incoming>
          <bpmn:outgoing>PN09</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="PN08" name="Andere aktive Phase" sourceRef="ReviewNeedRoute" targetRef="ReviewNeedOther">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewRoute = "OTHER"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="PN09" name="" sourceRef="ReviewNeedOther" targetRef="Merge_ReviewNeedDone" />
      </bpmn:subProcess>
      <bpmn:serviceTask id="ReviewNeedPrepare" name="Aktuellen Prüfkontext&#10;für Mitarbeiter bereitstellen">
        <bpmn:documentation>
Prüfentscheid, aktuelle führende Instanz und unterbrochenen Call verifizieren. staffEntryContextRef zur regulären Mitarbeiterprüfung bereitstellen. Eine bereits gleichzeitig entstandene Prüfung muss einmalig wiederverwendet werden; keine zweite Mitarbeiteraufgabe. Offenen Antwortbedarf nicht aufheben. Nach Abschluss oder neuerer Mitarbeiterentscheidung keine neue Wirkung. Koordination vor Ausführung implementieren.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.reply.prepare-review" />
        </bpmn:extensionElements>
        <bpmn:incoming>PN10</bpmn:incoming>
        <bpmn:outgoing>PN11</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="PN10" name="" sourceRef="ReplyReviewNeeded" targetRef="ReviewNeedPrepare" />
      <bpmn:sequenceFlow id="PN11" name="Aktuelle Mitarbeiterprüfung" sourceRef="ReviewNeedPrepare" targetRef="Merge_StaffContinuationClaim" />
      <bpmn:subProcess id="StaffQuestionSide" name="Nachricht während In Abklärung senden" triggeredByEvent="true">
        <bpmn:documentation>0.33 / KOM-AK-31: Bestehender nicht unterbrechender Sendeweg für Informationen und Rückfragen während In Abklärung. Lokale Auftragsdaten, kein neuer Mieternachrichtenempfänger. Eine Information beendet nur die Nebenaktion. Nur eine erfolgreich veröffentlichte Rückfrage mit Antwortbedarf veranlasst Übergang 29 und gemeinsame Automatik-Ablösung. Ablehnung verändert den laufenden Pfad nicht.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="=null" target="staffMessageCommandRef" />
            <zeebe:input source="=null" target="staffMessageOutcome" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:startEvent id="StaffQuestionStart" name="Sendeauftrag eingegangen" isInterrupting="false">
          <bpmn:outgoing>SQ01</bpmn:outgoing>
          <bpmn:messageEventDefinition id="StaffQuestionStart_definition" messageRef="Message_StaffQuestionClarification" />
        </bpmn:startEvent>
        <bpmn:serviceTask id="StaffQuestionPublish" name="Auftrag prüfen und Nachricht&#10;mit optionalem Antwortbedarf speichern">
          <bpmn:documentation>Berechtigten Mitarbeiter, Auftrags-ID, bestätigte Fallversion, aktuellen führenden Durchlauf und Status In Abklärung prüfen. Text und Antwortbedarf nur aus bestätigtem Auftrag übernehmen. Nachricht und Mailpflicht konsistent speichern; keine Katalogpflicht für Mitarbeitertext. Ohne neuen Antwortbedarf: Status, bestehende Fragen und automatische Bearbeitung erhalten, kein Ablösemarker. Relevante neue Information vor Wirkung alter KI-Ergebnisse berücksichtigen; bestehender Aktualitätsschutz, keine pauschale Unterbrechung. Mit Antwortbedarf: bestehende FALL-06-Regel, zwingender Prüfbedarf sperrt Übergang 29; Nachricht, neuen Bedarf, Wartet auf Mieterantwort und Mailpflicht konsistent sichern, automatische Wirkungsfreigaben entziehen. Gespeichertes Auftragsergebnis unterscheidet INFORMATION, QUESTION und REJECTED; erfolgreiche Wiederholung liest dasselbe Ergebnis ohne erneute Veröffentlichung oder Mailpflicht. Veralteten unveröffentlichten Auftrag ohne Wirkung ablehnen, Eingabe erhalten. Technische Fehler Retry/Incident. Dauerhafter Versandauftrag an eigenständigen Camunda-Mailprozess, kein direkter SMTP-Versand und kein Warten auf SMTP. Neuer zwingender Prüfbedarf bleibt separater Eingang; Information allein erledigt keine Prüfgründe.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.staff-message.publish" retries="5" />
          </bpmn:extensionElements>
          <bpmn:incoming>SQ01</bpmn:incoming>
          <bpmn:outgoing>SQ02</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="StaffQuestionResult" name="Gespeichertes Ergebnis" default="SQ05">
          <bpmn:incoming>SQ02</bpmn:incoming>
          <bpmn:outgoing>SQ03</bpmn:outgoing>
          <bpmn:outgoing>SQ05</bpmn:outgoing>
          <bpmn:outgoing>SQInfo</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="StaffQuestionSignal" name="Bestätigte Ablösung&#10;für Automatik bereitstellen">
          <bpmn:documentation>0.31: Bestätigten persistierten Entscheid für aktuellen Automatic-Call mit automaticCallRef in dessen Elternscope bereitstellen und automaticInterruptionReady setzen. Keine weitere Flagfamilie je Service Task. Aktuellen Fallstand/Durchlauf prüfen; nachholbar und idempotent. Unveröffentlichte/abgelehnte Aufträge unterbrechen nicht. Marker bis Verbrauch gültig, nicht auf spätere Calls übertragen. Neue zwingende Prüfgründe während Übergabe zuverlässig erhalten; keine Outputs des abgebrochenen Kindes.
0.33: Ausschliesslich Ergebnis QUESTION darf diesen Schritt erreichen. INFORMATION setzt automaticInterruptionReady nicht und entzieht keine pauschale Automatikfreigabe.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.clarification-question.signal" />
          </bpmn:extensionElements>
          <bpmn:incoming>SQ03</bpmn:incoming>
          <bpmn:outgoing>SQ04</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="StaffQuestionDone" name="Übernahme bereitgestellt">
          <bpmn:incoming>SQ04</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:endEvent id="StaffQuestionRejected" name="Abgelehnt: aktuellen Stand anzeigen&#10;Laufender Pfad bleibt">
          <bpmn:incoming>SQ05</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="SQ01" sourceRef="StaffQuestionStart" targetRef="StaffQuestionPublish" />
        <bpmn:sequenceFlow id="SQ02" sourceRef="StaffQuestionPublish" targetRef="StaffQuestionResult" />
        <bpmn:sequenceFlow id="SQ03" name="QUESTION: Rückfrage gespeichert" sourceRef="StaffQuestionResult" targetRef="StaffQuestionSignal">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=staffMessageOutcome = "QUESTION"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="SQ04" sourceRef="StaffQuestionSignal" targetRef="StaffQuestionDone" />
        <bpmn:sequenceFlow id="SQ05" name="REJECTED: abgelehnt" sourceRef="StaffQuestionResult" targetRef="StaffQuestionRejected" />
        <bpmn:endEvent id="StaffInformationDone" name="Information gespeichert&#10;Automatik bleibt aktiv">
          <bpmn:incoming>SQInfo</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="SQInfo" name="INFORMATION: ohne Antwortbedarf" sourceRef="StaffQuestionResult" targetRef="StaffInformationDone">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=staffMessageOutcome = "INFORMATION"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
      </bpmn:subProcess>
      <bpmn:subProcess id="StaffCloseClarificationSide" name="Direkter Mitarbeiterabschluss während In Abklärung" triggeredByEvent="true">
        <bpmn:documentation>FALL-06 Übergang 30 / FALL-AK-36. Nicht unterbrechender interner Mitarbeitereingang. Erst erfolgreicher Abschlusscommit beendet den aktiven Fallbereich; unberechtigte oder veraltete Aufträge verändern den aktuellen Pfad nicht. Keine offene Mitarbeiter-User-Task erfinden. Auftrag und Ergebnis lokal halten, an Fall und führenden Durchlauf binden.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="= null" target="clarificationClosureCommandRef" />
            <zeebe:input source="= null" target="clarificationClosureOutcome" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:startEvent id="StaffCloseClarificationStart" name="Mitarbeiter bestätigt Abschluss" isInterrupting="false">
          <bpmn:outgoing>SC01</bpmn:outgoing>
          <bpmn:messageEventDefinition id="StaffCloseClarificationStart_definition" messageRef="Message_StaffCloseClarification" />
        </bpmn:startEvent>
        <bpmn:serviceTask id="StaffCloseClarificationApply" name="Mitarbeiterabschluss prüfen&#10;und Abgeschlossen speichern">
          <bpmn:documentation>FALL-06 Übergang 30: denselben fachlichen Mitarbeiter-Abschlussvertrag wie Close verwenden, keine abweichende Abschlusslogik. Berechtigung, führenden Durchlauf, Status In Abklärung und vom Mitarbeiter bestätigten aktuellen Fallstand einschliesslich neuer Nachrichten und Prüfhinweise prüfen. Prüfung und Speicherung atomar gegen konkurrierende Änderungen absichern. Kein Warten auf LLM, keine Nachricht, kein Kommentar, kein Versandauftrag. Erfolgreicher Commit speichert Abgeschlossen, beendet Antwortbedarf, auditiert die bewusste Entscheidung und entzieht allen alten Jobs die Schreibfreigabe. Bereits gespeicherte Nachrichten samt Mailpflichten erhalten. Bei fachlichem Konflikt Ergebnis ABGELEHNT: keine Speicherung, aktuellen Stand anzeigen, erneute Mitarbeiterentscheidung nötig; keine automatische Aktualisierung der alten Zustimmung. Technischer Fehler bleibt Retry/Incident. Identischer bereits erfolgreicher Auftrag ist Erfolg, muss aber zum ursprünglichen Durchlauf gehören und darf keine Wiedereröffnung beenden. Abschlusscommit und zuverlässige Prozessfortsetzung koordinieren; Runtime noch nicht implementiert.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.clarification.close" />
          </bpmn:extensionElements>
          <bpmn:incoming>SC01</bpmn:incoming>
          <bpmn:outgoing>SC02</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="StaffCloseClarificationResult" name="Abschluss&#10;gespeichert?">
          <bpmn:incoming>SC02</bpmn:incoming>
          <bpmn:outgoing>SC03</bpmn:outgoing>
          <bpmn:outgoing>SC04</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="StaffCloseClarificationCommitted" name="Gespeichert: aktive&#10;Bearbeitung beenden">
          <bpmn:documentation>Erfolgssignal, kein fachlicher Fehler. Das unterbrechende Eskalations-Randereignis am umschliessenden ActiveCase beendet dessen Aktivitäten und alle Nebenpfade. Erst nach gesichertem Abschluss auslösen. Zuverlässige Wiederaufnahme nach Commit und vor diesem Ereignis ist vor ausführbarer Fassung nachzuweisen.</bpmn:documentation>
          <bpmn:incoming>SC03</bpmn:incoming>
          <bpmn:escalationEventDefinition id="StaffCloseClarificationCommitted_definition" escalationRef="Escalation_StaffCloseCommitted" />
        </bpmn:endEvent>
        <bpmn:endEvent id="StaffCloseClarificationRejected" name="Nicht abgeschlossen&#10;Aktuellen Stand erneut entscheiden">
          <bpmn:incoming>SC04</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="SC01" sourceRef="StaffCloseClarificationStart" targetRef="StaffCloseClarificationApply" />
        <bpmn:sequenceFlow id="SC02" sourceRef="StaffCloseClarificationApply" targetRef="StaffCloseClarificationResult" />
        <bpmn:sequenceFlow id="SC03" name="Ja / identischer Erfolg" sourceRef="StaffCloseClarificationResult" targetRef="StaffCloseClarificationCommitted">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clarificationClosureOutcome = "APPLIED"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="SC04" name="Nein: Konflikt / nicht zulässig" sourceRef="StaffCloseClarificationResult" targetRef="StaffCloseClarificationRejected">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clarificationClosureOutcome = "REJECTED"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
      </bpmn:subProcess>
      <bpmn:subProcess id="StaffFollowSide" name="Direkte Wiedervorlage aus Abklärung oder Mieterwartephase" triggeredByEvent="true">
        <bpmn:documentation>FALL-11 Übergang 31 / FALL-AK-37. Nicht unterbrechender interner Mitarbeiterauftrag. Ungültige oder veraltete Aufträge verändern den laufenden Pfad nicht. Lokale Auftragsvariablen, kein zusätzlicher Mieternachrichtenempfänger.
0.27: Zusätzlich FALL-11 Übergang 32 / FALL-AK-38. Derselbe geprüfte Auftragseingang gilt aus Wartet auf Mieterantwort; keine zweite Terminsetzungslogik.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="=directFollowCommandRef" target="directFollowCommandRef" />
            <zeebe:input source="=null" target="directFollowOutcome" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:startEvent id="StaffFollowStart" name="Wiedervorlage angefordert" isInterrupting="false">
          <bpmn:outgoing>SF01</bpmn:outgoing>
          <bpmn:messageEventDefinition id="StaffFollowStart_definition" messageRef="Message_StaffFollowClarification" />
        </bpmn:startEvent>
        <bpmn:serviceTask id="StaffFollowPublish" name="Auftrag prüfen: Termin und&#10;Wartet auf Wiedervorlage speichern">
          <bpmn:documentation>Berechtigung, aktuellen führenden Durchlauf, Status In Abklärung oder Wartet auf Mieterantwort, bestätigten Fallstand und zukünftigen Termin prüfen. FALL-11: Kalendertage, 08:00 Europe/Zurich, optionale interne Begründung. Termin, Version, Status, bewusste Berücksichtigung bekannter Prüfgründe und erforderliche Mailpflicht konsistent sichern. Offene Mieterfragen erhalten. Keine pauschale Kosten- oder Abschlussfreigabe. Alte automatische Schreibfreigaben entziehen. Konkurrierende Änderungen machen den Auftrag ungültig, keine stillschweigende Übernahme neuer Erkenntnisse. Erfolgreiche Wiederholung liefert denselben Termin und dieselbe Version ohne neue Mailpflicht. Technischer Fehler bleibt Retry/Incident. BEN-03: zuverlässige Übergabe an Mailprozess, kein Warten auf SMTP.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.direct-follow-up.apply" />
          </bpmn:extensionElements>
          <bpmn:incoming>SF01</bpmn:incoming>
          <bpmn:outgoing>SF02</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="StaffFollowResult" name="Terminsetzung&#10;gespeichert?">
          <bpmn:incoming>SF02</bpmn:incoming>
          <bpmn:outgoing>SF03</bpmn:outgoing>
          <bpmn:outgoing>SF05</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="StaffFollowSignal" name="Übernahme für aktuellen&#10;Bearbeitungspfad bereitstellen">
          <bpmn:documentation>0.31: Gespeicherten Terminauftrag zum aktuellen Aufruf bereitstellen. Bei Automatic: automaticCallRef + automaticInterruptionReady im Elternscope. Bei Reply: bestehenden staffFollowTakeoverReady zum Reply-Aufruf verwenden. Keine zweite Terminversion/Mailpflicht. Kontakte und neue Prüfgründe nach Speicherung auch während Übergabe nachliefern, aufgehobenen Termin nicht wiederherstellen.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.direct-follow-up.signal" />
          </bpmn:extensionElements>
          <bpmn:incoming>SF03</bpmn:incoming>
          <bpmn:outgoing>SF04</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="StaffFollowDone" name="Übernahme bereitgestellt">
          <bpmn:incoming>SF04</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:endEvent id="StaffFollowRejected" name="Abgelehnt: aktuellen Stand anzeigen&#10;Laufender Pfad bleibt">
          <bpmn:incoming>SF05</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="SF01" sourceRef="StaffFollowStart" targetRef="StaffFollowPublish" />
        <bpmn:sequenceFlow id="SF02" sourceRef="StaffFollowPublish" targetRef="StaffFollowResult" />
        <bpmn:sequenceFlow id="SF03" name="Ja / bereits übernommen" sourceRef="StaffFollowResult" targetRef="StaffFollowSignal">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= directFollowOutcome = "APPLIED"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="SF04" sourceRef="StaffFollowSignal" targetRef="StaffFollowDone" />
        <bpmn:sequenceFlow id="SF05" name="Nein" sourceRef="StaffFollowResult" targetRef="StaffFollowRejected">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= directFollowOutcome = "REJECTED"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
      </bpmn:subProcess>
      <bpmn:serviceTask id="StaffFollowContinue" name="Aktuellen Wiedervorlage-&#10;Eintritt bereitstellen">
        <bpmn:documentation>FALL-11 Übergang 31. Gespeicherten Terminsetzungsauftrag und aktuelle Terminversion laden, nicht neu berechnen oder erneut speichern. staffEntryContextRef für direkten Eintritt in FollowUp vorbereiten; Marker konsumieren. Neue Mieternachricht oder neuer zwingender Prüfgrund nach Terminsetzung: betroffenen Termin idempotent aufheben und Mitarbeiterprüfung vorbereiten, genau eine Prüfung auch bei gleichzeitigem Timer. Keine Wiederherstellung eines aufgehobenen Termins. Alte automatische Ergebnisse bleiben gesperrt. Übergabekontext und Ereignisse zuverlässig an SEntryCheck übergeben; keine live gemeinsam genutzten Kindvariablen.
0.27: Auch Übergang 32. Keine Rückgaben des abgebrochenen Reply-Calls verwenden; offene Antwortbedarfe unverändert erhalten. Derselbe geprüfte FollowUp-Eintritt wie bei Übergang 31.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.direct-follow-up.continue" />
        </bpmn:extensionElements>
        <bpmn:incoming>SF_Takeover_Reply</bpmn:incoming>
        <bpmn:outgoing>SF07</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="SF07" name="Geprüfter Eintritt: Wiedervorlage / neuer Prüfbedarf" sourceRef="StaffFollowContinue" targetRef="Merge_StaffContinuationClaim" />
      <bpmn:boundaryEvent id="StaffFollowAtReply" name="Wiedervorlage bestätigt" attachedToRef="Reply">
        <bpmn:documentation>FALL-11 Übergänge 31/32: Unterbrechung nur für bestätigte Terminsetzung aus In Abklärung oder Wartet auf Mieterantwort im aktuellen Durchlauf. Marker und Zustellverfahren sind Fachentwurf. Nach Speicherung keine automatische Wirkung des abgelösten Laufs; technische Umsetzung offen.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=staffFollowCommandRef" target="directFollowContinuationRef" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:outgoing>SF_Takeover_Reply</bpmn:outgoing>
        <bpmn:conditionalEventDefinition id="StaffFollowAtReply_definition">
          <bpmn:condition xsi:type="bpmn:tFormalExpression">= staffFollowReplyEntryRef != null and staffFollowReplyEntryRef != "" and staffFollowReplyEntryRef = replyEntryContextRef and (staffFollowReplyCallRef = "" or staffFollowReplyCallRef = activeReplyCallRef)</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="SF_Takeover_Reply" sourceRef="StaffFollowAtReply" targetRef="StaffFollowContinue" />
      <bpmn:subProcess id="StaffTakeoverSide" name="Bearbeitung während In Abklärung übernehmen" triggeredByEvent="true">
        <bpmn:documentation>FALL-06 Übergang 33 / FALL-AK-40. Nicht unterbrechender interner Auftrag zur direkten Übernahme aus In Abklärung. Ungültige Aufträge lassen den aktuellen Pfad bestehen. Lokale Auftragsreferenz, keine zusätzliche Mieter-Subscription.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="= null" target="staffTakeoverCommandRef" />
            <zeebe:input source="= null" target="staffTakeoverOutcome" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:startEvent id="StaffTakeoverStart" name="Übernahme angefordert" isInterrupting="false">
          <bpmn:outgoing>ST01</bpmn:outgoing>
          <bpmn:messageEventDefinition id="StaffTakeoverStart_definition" messageRef="Message_StaffTakeover" />
        </bpmn:startEvent>
        <bpmn:serviceTask id="StaffTakeoverPublish" name="Auftrag und Prüfbedarf prüfen&#10;Übernahme speichern">
          <bpmn:documentation>Berechtigung, führenden Durchlauf, Status In Abklärung und bestätigte Fallversion prüfen. Ohne zwingenden Prüfbedarf In Bearbeitung, andernfalls Mitarbeiterprüfung erforderlich speichern. Übernahme, Zielstatus und erforderliche Mailpflicht konsistent sichern; bestehender unabhängiger Camunda-Mailprozess beauftragt den Mail-Worker. Prüfgründe nicht als erledigt behandeln. Offene Fragen und manuelle Dringlichkeit erhalten. Ab Commit alte automatische Wirkungsfreigaben entziehen. Veraltete Aufträge ohne Wirkung ablehnen. Erfolgreiche Wiederholung ohne zweite Aufgabe, Nachweis oder Mailpflicht; technische Fehler Retry/Incident.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.takeover.apply" />
          </bpmn:extensionElements>
          <bpmn:incoming>ST01</bpmn:incoming>
          <bpmn:outgoing>ST02</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="StaffTakeoverResult" name="Übernahme&#10;gespeichert?">
          <bpmn:incoming>ST02</bpmn:incoming>
          <bpmn:outgoing>ST03</bpmn:outgoing>
          <bpmn:outgoing>ST05</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="StaffTakeoverSignal" name="Bestätigte Ablösung&#10;für Automatik bereitstellen">
          <bpmn:documentation>0.31: Bestätigten persistierten Entscheid für aktuellen Automatic-Call mit automaticCallRef in dessen Elternscope bereitstellen und automaticInterruptionReady setzen. Keine weitere Flagfamilie je Service Task. Aktuellen Fallstand/Durchlauf prüfen; nachholbar und idempotent. Unveröffentlichte/abgelehnte Aufträge unterbrechen nicht. Marker bis Verbrauch gültig, nicht auf spätere Calls übertragen. Neue zwingende Prüfgründe während Übergabe zuverlässig erhalten; keine Outputs des abgebrochenen Kindes.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.takeover.signal" />
          </bpmn:extensionElements>
          <bpmn:incoming>ST03</bpmn:incoming>
          <bpmn:outgoing>ST04</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="StaffTakeoverDone" name="Übernahme bereitgestellt">
          <bpmn:incoming>ST04</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:endEvent id="StaffTakeoverRejected" name="Abgelehnt: aktuellen Stand anzeigen&#10;Laufender Pfad bleibt">
          <bpmn:incoming>ST05</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="ST01" sourceRef="StaffTakeoverStart" targetRef="StaffTakeoverPublish" />
        <bpmn:sequenceFlow id="ST02" sourceRef="StaffTakeoverPublish" targetRef="StaffTakeoverResult" />
        <bpmn:sequenceFlow id="ST03" name="Ja / bereits übernommen" sourceRef="StaffTakeoverResult" targetRef="StaffTakeoverSignal">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffTakeoverOutcome = "APPLIED"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="ST04" sourceRef="StaffTakeoverSignal" targetRef="StaffTakeoverDone" />
        <bpmn:sequenceFlow id="ST05" name="Nein" sourceRef="StaffTakeoverResult" targetRef="StaffTakeoverRejected">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffTakeoverOutcome = "REJECTED"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
      </bpmn:subProcess>
      <bpmn:serviceTask id="PrepareInitialAuto" name="Automatik-Eintritt&#10;INITIAL vorbereiten">
        <bpmn:documentation>Aktuellen Fallstand, führenden Durchlauf und Herkunft INITIAL prüfen; automaticEntryContextRef bereitstellen. Für QUESTION/CLOSE aktuellen replyDecisionRef verwenden, keine alte Freigabe und kein Statusreset. automaticCallRef für genau diesen Aufruf und Unterbrechungsbezug bereitstellen; nachholbare Registrierung mit offenen Prüfentscheiden koordinieren. Alte konsumierte Marker nicht wiederverwenden, neuen Prüfbedarf nicht löschen.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow-prepare-initial" />
        </bpmn:extensionElements>
        <bpmn:incoming>F02</bpmn:incoming>
        <bpmn:outgoing>PrepareInitialAutoFlow</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="PrepareInitialAutoFlow" name="" sourceRef="PrepareInitialAuto" targetRef="Merge_Automatic" />
      <bpmn:serviceTask id="PrepareQuestionAuto" name="Automatik-Eintritt&#10;QUESTION vorbereiten">
        <bpmn:documentation>Aktuellen Fallstand, führenden Durchlauf und Herkunft QUESTION prüfen; automaticEntryContextRef bereitstellen. Für QUESTION/CLOSE aktuellen replyDecisionRef verwenden, keine alte Freigabe und kein Statusreset. automaticCallRef für genau diesen Aufruf und Unterbrechungsbezug bereitstellen; nachholbare Registrierung mit offenen Prüfentscheiden koordinieren. Alte konsumierte Marker nicht wiederverwenden, neuen Prüfbedarf nicht löschen.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.automatic.prepare-question-round" />
        </bpmn:extensionElements>
        <bpmn:incoming>F18</bpmn:incoming>
        <bpmn:outgoing>PrepareQuestionAutoFlow</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="PrepareCloseAuto" name="Automatik-Eintritt&#10;CLOSE vorbereiten">
        <bpmn:documentation>Aktuellen Fallstand, führenden Durchlauf und Herkunft CLOSE prüfen; automaticEntryContextRef bereitstellen. Für QUESTION/CLOSE aktuellen replyDecisionRef verwenden, keine alte Freigabe und kein Statusreset. automaticCallRef für genau diesen Aufruf und Unterbrechungsbezug bereitstellen; nachholbare Registrierung mit offenen Prüfentscheiden koordinieren. Alte konsumierte Marker nicht wiederverwenden, neuen Prüfbedarf nicht löschen.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.automatic.prepare-close-round" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>F20</bpmn:incoming>
        <bpmn:outgoing>PrepareCloseAutoFlow</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="PrepareCloseAutoFlow" name="" sourceRef="PrepareCloseAuto" targetRef="Gateway_1mtzd0x" />
      <bpmn:sequenceFlow id="F02" name="" sourceRef="Register" targetRef="PrepareInitialAuto" />
      <bpmn:sequenceFlow id="F18" name="Weitere Katalogfrage zulässig" sourceRef="ReplyRoute" targetRef="PrepareQuestionAuto">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyOutcome = "QUESTION"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="F20" name="Systemabschluss vorgeschlagen" sourceRef="ReplyRoute" targetRef="PrepareCloseAuto">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyOutcome = "CLOSE"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:exclusiveGateway id="Merge_Automatic" gatewayDirection="Converging">
        <bpmn:incoming>PrepareInitialAutoFlow</bpmn:incoming>
        <bpmn:incoming>Flow_12mi7n8</bpmn:incoming>
        <bpmn:outgoing>Flow_Merge_Automatic</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:callActivity id="Automatic" name="Automatische Abklärung">
        <bpmn:documentation>Ruft automatische-abklaerung.bpmn auf. Eigener Scope; führende Fallzuordnung bleibt im Elternprozess. Genau eine aktuelle Call-Zuordnung. Normale Outputs nur bei regulärem Ende; bei Unterbrechung aktuellen persistierten Entscheid laden. Unterbrechung beendet auch Kindjobs, nicht zuverlässig bereits gestartete externe Nebenwirkungen. Deshalb Wirkungsprüfung im Dienst ab bestätigtem Prüfbedarf/Mitarbeiterentscheid.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:calledElement processId="PropertyFlow_Automatic_Draft" propagateAllChildVariables="false" propagateAllParentVariables="false" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= caseId" target="caseId" />
            <zeebe:input source="= processInstanceKey" target="leadingProcessInstanceKey" />
            <zeebe:input source="= automaticEntryContextRef" target="entryContextRef" />
            <zeebe:input source="= automaticCallRef" target="automaticCallRef" />
            <zeebe:output source="= outcome" target="automaticOutcome" />
            <zeebe:output source="= decisionRef" target="automaticDecisionRef" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Merge_Automatic</bpmn:incoming>
        <bpmn:outgoing>AParent01</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="Flow_Merge_Automatic" sourceRef="Merge_Automatic" targetRef="Automatic" />
      <bpmn:serviceTask id="AutomaticResult" name="Aktuelles Automatik-Ergebnis&#10;übernehmen">
        <bpmn:documentation>automaticOutcome/automaticDecisionRef gegen aktuellen Fallstand und Call prüfen. WAIT_FOR_REPLY: replyEntryContextRef bereitstellen; REVIEW: staffEntryContextRef; CLOSED nur nach gespeichertem Abschluss. Neuen zwingenden Prüfbedarf vor Fortsetzung berücksichtigen. Übergabe am Call-Ende und Unterbrechung atomar/logisch exklusiv koordinieren; keine parallelen Staff-Calls. Unbekannte Rückgabe ist Vertragsfehler, kein fachlicher Default.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.automatic.accept-result" />
        </bpmn:extensionElements>
        <bpmn:incoming>AParent01</bpmn:incoming>
        <bpmn:outgoing>AParent02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="AutomaticRoute" name="Fortsetzung">
        <bpmn:incoming>AParent02</bpmn:incoming>
        <bpmn:outgoing>AParentWait</bpmn:outgoing>
        <bpmn:outgoing>AParentReview</bpmn:outgoing>
        <bpmn:outgoing>AParentClosed</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="AParent01" name="" sourceRef="Automatic" targetRef="AutomaticResult" />
      <bpmn:sequenceFlow id="AParent02" name="" sourceRef="AutomaticResult" targetRef="AutomaticRoute" />
      <bpmn:sequenceFlow id="AParentWait" name="WAIT_FOR_REPLY" sourceRef="AutomaticRoute" targetRef="Gateway_1eukhr4">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= automaticOutcome = "WAIT_FOR_REPLY"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="AParentReview" name="REVIEW" sourceRef="AutomaticRoute" targetRef="Event_14iaxoj">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= automaticOutcome = "REVIEW"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="AParentClosed" name="CLOSED" sourceRef="AutomaticRoute" targetRef="Event_00yzly3">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= automaticOutcome = "CLOSED"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:boundaryEvent id="AutomaticInterrupted" name="Bestätigte Ablösung" attachedToRef="Automatic">
        <bpmn:documentation>Gemeinsamer Unterbrechungspfad für geprüfte Mitarbeiterrückfrage, Terminsetzung, Übernahme oder neuen zwingenden Prüfbedarf. Nur bestätigte persistierte Entscheide zum aktuellen automaticCallRef. Condition sieht Elternvariablen; keine implizite Synchronisierung mit Kind oder Datenbank. Auch Retry/Incident unterbrechen; technische Realisierung und Runtime-Nachweis offen.</bpmn:documentation>
        <bpmn:outgoing>AI01</bpmn:outgoing>
        <bpmn:conditionalEventDefinition id="AutomaticInterrupted_definition">
          <bpmn:condition xsi:type="bpmn:tFormalExpression">= automaticInterruptionReady = true and automaticInterruptionCallRef = automaticCallRef</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="AutomaticFailure" name="Fachlicher Analysefehler" attachedToRef="Automatic">
        <bpmn:outgoing>AutoFail01</bpmn:outgoing>
        <bpmn:errorEventDefinition id="AutomaticFailure_definition" errorRef="Error_TriageFailure" />
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="AutomaticFailurePrepare" name="Analysefehler und&#10;Prüfkontext sichern">
        <bpmn:documentation>Tatsächlich gemeldeten fachlichen Analysefehler speichern und staffEntryContextRef zur Mitarbeiterprüfung bereitstellen. Aktuellen Durchlauf/Fallstand prüfen; vorhandene Prüfung wiederverwenden, keinen neueren Entscheid zurücknehmen. Kein Zugriff auf normale Outputs des abgebrochenen Kindes. Technische Retries sind keine fachlichen Fehler.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.review.analysis-failure" />
        </bpmn:extensionElements>
        <bpmn:incoming>AutoFail01</bpmn:incoming>
        <bpmn:outgoing>AutoFail02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="AutoFail01" name="" sourceRef="AutomaticFailure" targetRef="AutomaticFailurePrepare" />
      <bpmn:sequenceFlow id="AutoFail02" name="" sourceRef="AutomaticFailurePrepare" targetRef="Event_1yujcek" />
      <bpmn:boundaryEvent id="AutomaticResultTakenOver" name="Mitarbeiterübernahme bestätigt" attachedToRef="AutomaticResult">
        <bpmn:outgoing>AutomaticResultTakenOverFlow</bpmn:outgoing>
        <bpmn:conditionalEventDefinition id="AutomaticResultTakenOver_definition">
          <bpmn:condition xsi:type="bpmn:tFormalExpression">= (staffTakeoverCallRef != null and staffTakeoverCallRef = automaticCallRef) or (staffFollowAutomaticCallRef != null and staffFollowAutomaticCallRef = automaticCallRef)</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="AutomaticResultTakenOverFlow" sourceRef="AutomaticResultTakenOver" targetRef="Merge_AutomaticInterruption" />
      <bpmn:sequenceFlow id="ReplyTakenOverFlow" sourceRef="ReplyTakenOver" targetRef="Merge_AutomaticInterruption" />
      <bpmn:boundaryEvent id="AutomaticResultManualQuestion" name="Mitarbeiterrückfrage veröffentlicht" attachedToRef="AutomaticResult">
        <bpmn:outgoing>AutomaticResultManualQuestionFlow</bpmn:outgoing>
        <bpmn:conditionalEventDefinition id="AutomaticResultManualQuestion_definition">
          <bpmn:condition xsi:type="bpmn:tFormalExpression">= manualQuestionCallRef != null and manualQuestionCallRef = automaticCallRef</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="AutomaticResultManualQuestionFlow" sourceRef="AutomaticResultManualQuestion" targetRef="Merge_AutomaticInterruption" />
      <bpmn:sequenceFlow id="ReplyManualQuestionFlow" sourceRef="ReplyManualQuestion" targetRef="Merge_AutomaticInterruption" />
      <bpmn:exclusiveGateway id="Merge_AutomaticInterruption" gatewayDirection="Converging">
        <bpmn:incoming>AI01</bpmn:incoming>
        <bpmn:incoming>AutomaticResultTakenOverFlow</bpmn:incoming>
        <bpmn:incoming>ReplyTakenOverFlow</bpmn:incoming>
        <bpmn:incoming>AutomaticResultManualQuestionFlow</bpmn:incoming>
        <bpmn:incoming>ReplyManualQuestionFlow</bpmn:incoming>
        <bpmn:outgoing>Merge_AutomaticInterruptionFlow</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Merge_AutomaticInterruptionFlow" sourceRef="Merge_AutomaticInterruption" targetRef="AutomaticInterruptionPrepare" />
      <bpmn:serviceTask id="AutomaticInterruptionPrepare" name="Bestätigten Entscheid und&#10;aktuellen Fallstand prüfen">
        <bpmn:documentation>Persistierten Unterbrechungsentscheid gegen automaticCallRef, führenden Durchlauf und aktuellen Fallstand prüfen; automaticInterruptionReady konsumieren. Zwingender neuer Prüfbedarf hat Vorrang -&gt; staffEntryContextRef zur Prüfung. Erfolgreiche Rückfrage ohne Vorrang -&gt; replyEntryContextRef. Übernahme ohne Prüfbedarf -&gt; staffEntryContextRef zu SWork. Gespeicherter Termin -&gt; direkter FollowUp-Kontext, bei Kontakt/neuem Prüfbedarf seit Terminsetzung Termin aufheben und Prüfung vorbereiten. Bestehende Prüfung genau einmal ergänzen. Keine Rückgaben des abgebrochenen Kindes; keine doppelte Veröffentlichung, Terminversion oder Mailpflicht. Neueren Fallstand/Abschluss nicht zurücksetzen. Geschützte Übergabe bis Zielaktivierung zuverlässig nachholen.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.review.prepare-staff" />
        </bpmn:extensionElements>
        <bpmn:incoming>Merge_AutomaticInterruptionFlow</bpmn:incoming>
        <bpmn:outgoing>AI02</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="AutomaticInterruptionRoute" name="Geprüfte Fortsetzung">
        <bpmn:incoming>AI02</bpmn:incoming>
        <bpmn:outgoing>AIWait</bpmn:outgoing>
        <bpmn:outgoing>AIStaff</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="AI01" name="" sourceRef="AutomaticInterrupted" targetRef="Merge_AutomaticInterruption" />
      <bpmn:sequenceFlow id="AI02" name="" sourceRef="AutomaticInterruptionPrepare" targetRef="AutomaticInterruptionRoute" />
      <bpmn:sequenceFlow id="AIWait" name="Veröffentlichte Rückfrage" sourceRef="AutomaticInterruptionRoute" targetRef="Gateway_1eukhr4">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= automaticInterruptionOutcome = "WAIT_FOR_REPLY"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="AIStaff" name="Prüfung / Bearbeitung / Wiedervorlage" sourceRef="AutomaticInterruptionRoute" targetRef="Event_0mtg60i">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= automaticInterruptionOutcome = "STAFF"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:subProcess id="CaseDataSide" name="Falldaten ergänzen – Bearbeitung bleibt bestehen" triggeredByEvent="true">
        <bpmn:documentation>0.34 / FALL-06 / FALL-AK-43: Ein gemeinsamer nicht unterbrechender Eingang für ADD_MEMO, SET_OBJECT_ASSIGNMENT und SET_MANUAL_URGENCY. Nur autorisierte Mitarbeiteraufträge für einen zugeordneten aktiven Fall. Kein neuer öffentlicher Endpunkt durch dieses Modell und kein Mieternachrichtenempfänger. Keine User-Task-Completion, kein neuer Call und kein Statuswechsel durch die Aktion. Lokale Auftragsreferenz je Ausführung, keine Überschreibung von Hauptpfadvariablen. Bei konkurrierendem Abschluss unveröffentlichte alte Aufträge ohne Wirkung auflösen; bereits gespeicherte Änderungen und Mailpflichten erhalten. Technische Korrelation und Transaktionskoordination noch umzusetzen.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="= null" target="caseDataCommandRef" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:startEvent id="CaseDataStart" name="Änderungsauftrag eingegangen" isInterrupting="false">
          <bpmn:outgoing>CD01</bpmn:outgoing>
          <bpmn:messageEventDefinition id="CaseDataStart_definition" messageRef="Message_CaseDataChange" />
        </bpmn:startEvent>
        <bpmn:serviceTask id="CaseDataApply" name="Berechtigung und Fallstand prüfen&#10;Falldaten + Änderungsnachweis speichern">
          <bpmn:documentation>FALL-06 Aktionsvertrag Falldaten ergänzen: authentifizierte Mitarbeiteridentität und Berechtigung, aktuelle führende Instanz, aktiven Status und bestätigte Fallversion serverseitig prüfen. Erreichbares Camunda ist Voraussetzung der Auftragsannahme; erneute Prüfung unmittelbar vor Speicherung. Keine frei übergebene Prozess-ID als Autorisierung, keine Mitarbeiter-User-Task voraussetzen. Fest definierte Aktionsart und deren Payload prüfen, an zuständige Fachlogik delegieren. ADD_MEMO nur intern, keine Mieter-Mail und kein Kommunikations-LLM-Kontext. SET_OBJECT_ASSIGNMENT nur zulässige Zuordnung, relevante alte Auswertungsgrundlage sperren, keine automatische Erledigung einer Mitarbeiterprüfung. SET_MANUAL_URGENCY validiert Stufe und schützt menschlichen Vorrang; wirksame Änderungen nach DRING historisieren/benachrichtigen, bestehende Regeln für unveränderte Werte erhalten. Änderung, erforderlichen Nachweis, Operationsausgang und gegebenenfalls Mailpflicht konsistent sichern. Status/Task/Timer unverändert. Neuer zwingender Prüfbedarf folgt separatem bestehenden Eingang und wird zuverlässig übergeben. Wiederholung desselben erfolgreichen Auftrags ohne zweite Wirkung; gleiche Operations-ID mit geändertem Inhalt ablehnen. Ungültiger/veralteter unverarbeiteter Auftrag ohne Änderung ablehnen, Eingabe erhalten. Technische Fehler Retry/Incident, nicht als fachliche Ablehnung tarnen. Bei Timeout keinen Erfolg behaupten und dieselbe Operations-ID wiederverwenden. Engine-Unterbrechung allein verhindert keine späte DB-Wirkung; Abschluss und Fallversion vor Commit koordinieren. Nur lokale Ergebnisdaten, keine Änderung von outcome/decisionRef des Hauptpfads.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.case-data.apply" />
          </bpmn:extensionElements>
          <bpmn:incoming>CD01</bpmn:incoming>
          <bpmn:outgoing>CD02</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="CaseDataEnd" name="Nur Änderungsauftrag beendet">
          <bpmn:incoming>CD02</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="CD01" sourceRef="CaseDataStart" targetRef="CaseDataApply" />
        <bpmn:sequenceFlow id="CD02" sourceRef="CaseDataApply" targetRef="CaseDataEnd" />
      </bpmn:subProcess>
      <bpmn:exclusiveGateway id="Merge_StaffContinuationClaim" gatewayDirection="Converging">
        <bpmn:incoming>F21</bpmn:incoming>
        <bpmn:incoming>CA05</bpmn:incoming>
        <bpmn:incoming>SF07</bpmn:incoming>
        <bpmn:incoming>Flow_1aejmfo</bpmn:incoming>
        <bpmn:incoming>PN11</bpmn:incoming>
        <bpmn:outgoing>Flow_Merge_StaffContinuationClaim</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="StaffContinuationClaim" name="Fortsetzung am aktuellen&#10;Fallstand exklusiv übernehmen">
        <bpmn:documentation>FALL-06 Fortsetzungsvertrag B07 / FALL-AK-44: Persistierten Fortsetzungsauftrag mit Fall, führendem Durchlauf, Erkenntnis-/Fallversion, Operations-ID und Quell-/Zielbezug prüfen. Exklusiven Bearbeitungsanspruch konsistent sichern; konkurrierende Auftragseingänge dürfen keinen zweiten Staff-Aufruf beanspruchen. Drei Ergebnisse: START für diesen berechtigten Ausführungspfad, EXISTING für einen anderen nachweislich laufenden zuständigen Staff-Call, SUPERSEDED für erledigten/überholten Auftrag mit gesichertem anderem zuständigem Pfad. Wiederholung derselben eigenen Übernahme bleibt START und verwendet denselben Anspruch, nicht EXISTING. Neuer zwingender Prüfgrund wird bei Versionskonflikt am aktuellen Stand erneut eingeordnet und darf nicht verloren gehen. Veraltete Mitarbeiterentscheidung dagegen ohne Übernahme neuer Erkenntnisse ablehnen. Unklare Zuordnung, nur reservierter aber noch nicht bestätigter anderer Call oder fehlender lebender Nachfolgepfad: technische Klärung/Retry/Incident, kein fachlicher Endausgang. Anspruch, Engine-Aktivierung und Wiederaufnahme zuverlässig koordinieren; gespeicherte Reservierung ist kein Beweis einer laufenden Aufgabe. staffEntryContextRef mit Übernahmebezug bereitstellen; bestehende Eintrittsarten REVIEW, direkte Bearbeitung und Wiedervorlage erhalten.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.staff.claim" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Merge_StaffContinuationClaim</bpmn:incoming>
        <bpmn:outgoing>SCClaim</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_Merge_StaffContinuationClaim" sourceRef="Merge_StaffContinuationClaim" targetRef="StaffContinuationClaim" />
      <bpmn:exclusiveGateway id="StaffContinuationRoute" name="Wer führt weiter?">
        <bpmn:documentation>Ausgang staffContinuationOutcome aus bestätigter Übernahme prüfen: START, EXISTING oder SUPERSEDED. Unbekannte/fehlende Werte sind technische Fehler, kein Default-Endpfad. Gateway-Bedingungen noch nicht ausführbar gebunden.</bpmn:documentation>
        <bpmn:incoming>SCClaim</bpmn:incoming>
        <bpmn:outgoing>SCStart</bpmn:outgoing>
        <bpmn:outgoing>SCExisting</bpmn:outgoing>
        <bpmn:outgoing>SCSuperseded</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="StaffContinuationMerge" name="Bestehende Bearbeitung&#10;zuverlässig ergänzen">
        <bpmn:documentation>Vorhandenen aktuellen Staff-Call und gegebenenfalls dieselbe Prüfaufgabe anhand Engine-/Dienstzuordnung verifizieren. Neuer Prüfgrund wird nachvollziehbar und idempotent der aktuellen Bearbeitung zugestellt. Bei bestehender Prüfung dieselbe Aufgabe ergänzen; bei anderer Mitarbeiterphase vorhandenen Prüfbedarfspfad nutzen, keinen zweiten Staff-Call starten. Veraltete Mitarbeiterentscheidung nicht neu ausführen. Erst bestätigte Übernahme beziehungsweise dauerhafte nachholbare Zuständigkeit mit weiterhin lebendem Ausführungspfad erlaubt Ende dieser redundanten Fortsetzung. Bei Zielwechsel erneut einordnen; keine Meldung verlieren und keinen alten Call reaktivieren.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.staff.merge-continuation" />
        </bpmn:extensionElements>
        <bpmn:incoming>SCExisting</bpmn:incoming>
        <bpmn:outgoing>SCMerged</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="StaffContinuationReconcile" name="Überholten Auftrag und&#10;zuständige Fortsetzung abgleichen">
        <bpmn:documentation>Auftrag ist bereits erledigt oder anderer aktueller Pfad zuständig. Noch relevanten neuen Prüfgrund dauerhaft an aktuelle Bearbeitung übergeben, bei bereits abgeschlossenem Fall nur interner Hinweis ohne Wiedereröffnung. Alten Mitarbeiterentscheid nicht erneut anwenden. Ende nur wenn ein anderer zuständiger Ausführungspfad in ActiveCase nachweislich weiterläuft; niemals den letzten aktiven Hauptpfad wegen eines vermeintlichen Duplikats beenden. Bereits wirksamer Abschluss verwendet den bestehenden geschützten Abschluss-/Prozessbeendigungsvertrag, nicht dieses normale Endereignis. Fehlender/unklarer Eigentümer bleibt technische Klärung/Retry/Incident und verliert den Auftrag nicht.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.staff.reconcile-continuation" />
        </bpmn:extensionElements>
        <bpmn:incoming>SCSuperseded</bpmn:incoming>
        <bpmn:outgoing>SCObsolete</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="StaffContinuationMerged" name="Nur redundante&#10;Fortsetzung beendet">
        <bpmn:documentation>Normales Endereignis, kein terminate. Kein Fallabschluss, keine Beendigung der zuständigen Bearbeitung. Erreichbar nur nach Bestätigung, dass ein anderer aktueller Ausführungspfad in ActiveCase weiterläuft. Das blosse Vorhandensein einer Datenbankreferenz genügt nicht. Technischer Schutz ist noch nicht implementiert.</bpmn:documentation>
        <bpmn:incoming>SCMerged</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="StaffContinuationObsolete" name="Nur redundante&#10;Fortsetzung beendet">
        <bpmn:documentation>Normales Endereignis, kein terminate. Kein Fallabschluss, keine Beendigung der zuständigen Bearbeitung. Erreichbar nur nach Bestätigung, dass ein anderer aktueller Ausführungspfad in ActiveCase weiterläuft. Das blosse Vorhandensein einer Datenbankreferenz genügt nicht. Technischer Schutz ist noch nicht implementiert.</bpmn:documentation>
        <bpmn:incoming>SCObsolete</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SCClaim" name="" sourceRef="StaffContinuationClaim" targetRef="StaffContinuationRoute" />
      <bpmn:sequenceFlow id="SCStart" name="START: neuer Aufruf" sourceRef="StaffContinuationRoute" targetRef="Staff">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffContinuationOutcome = "START"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="SCExisting" name="EXISTING: bereits aktiv" sourceRef="StaffContinuationRoute" targetRef="StaffContinuationMerge">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffContinuationOutcome = "EXISTING"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="SCSuperseded" name="SUPERSEDED: überholt" sourceRef="StaffContinuationRoute" targetRef="StaffContinuationReconcile">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffContinuationOutcome = "SUPERSEDED"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="SCMerged" name="" sourceRef="StaffContinuationMerge" targetRef="StaffContinuationMerged" />
      <bpmn:sequenceFlow id="SCObsolete" name="" sourceRef="StaffContinuationReconcile" targetRef="StaffContinuationObsolete" />
      <bpmn:intermediateCatchEvent id="Event_0pfpy79">
        <bpmn:outgoing>Flow_1aejmfo</bpmn:outgoing>
        <bpmn:linkEventDefinition id="LinkEventDefinition_0iro179" name="FORTSETZEN" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_1aejmfo" sourceRef="Event_0pfpy79" targetRef="Merge_StaffContinuationClaim" />
      <bpmn:intermediateThrowEvent id="Event_0mtg60i" name="Prüfung / Bearbeitung / Wiedervorlage">
        <bpmn:documentation>Prüfung / Bearbeitung / Wiedervorlage</bpmn:documentation>
        <bpmn:incoming>AIStaff</bpmn:incoming>
        <bpmn:linkEventDefinition id="LinkEventDefinition_1pbf2eu" name="FORTSETZEN" />
      </bpmn:intermediateThrowEvent>
      <bpmn:boundaryEvent id="ReplyManualQuestion" name="Mitarbeiterrückfrage veröffentlicht" attachedToRef="Reply">
        <bpmn:outgoing>ReplyManualQuestionFlow</bpmn:outgoing>
        <bpmn:conditionalEventDefinition id="ConditionalEventDefinition_1wq68dd">
          <bpmn:condition xsi:type="bpmn:tFormalExpression">= manualQuestionPreviousReplyEntryRef != null and manualQuestionPreviousReplyEntryRef != "" and manualQuestionPreviousReplyEntryRef = replyEntryContextRef</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="ReplyReviewNeeded" name="Neuer Prüfbedarf" attachedToRef="Reply">
        <bpmn:documentation>
Unterbrechung nur bei geprüftem neuen Grund zum aktuellen Reply-Call. Bereits bereitgestellte Gründe bei Eintritt erkennen. Alter Marker darf keine neuere Bearbeitung unterbrechen. Kein normaler Reply-Output; ReviewNeedPrepare lädt den persistierten Prüfentscheid.</bpmn:documentation>
        <bpmn:outgoing>PN10</bpmn:outgoing>
        <bpmn:conditionalEventDefinition id="ConditionalEventDefinition_1c3mp64">
          <bpmn:condition xsi:type="bpmn:tFormalExpression">= reviewNeedReplyCallRef != null and reviewNeedReplyCallRef = activeReplyCallRef and activeReplyEntryRef != null and activeReplyEntryRef = replyEntryContextRef</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:intermediateThrowEvent id="Event_1fbvxyl" name="Aktuellen Fallstand erneut prüfen">
        <bpmn:documentation>Prüfung / Bearbeitung / Wiedervorlage</bpmn:documentation>
        <bpmn:incoming>F_CloseConflict_Staff</bpmn:incoming>
        <bpmn:linkEventDefinition id="LinkEventDefinition_1cgam8g" name="FORTSETZEN" />
      </bpmn:intermediateThrowEvent>
      <bpmn:intermediateThrowEvent id="Event_1yujcek" name="Prüfung / Bearbeitung / Wiedervorlage">
        <bpmn:documentation>Prüfung / Bearbeitung / Wiedervorlage</bpmn:documentation>
        <bpmn:incoming>AutoFail02</bpmn:incoming>
        <bpmn:linkEventDefinition id="LinkEventDefinition_0wa7l0k" name="FORTSETZEN" />
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="PrepareQuestionAutoFlow" name="" sourceRef="PrepareQuestionAuto" targetRef="Gateway_1mtzd0x" />
      <bpmn:exclusiveGateway id="Gateway_1mtzd0x">
        <bpmn:incoming>PrepareCloseAutoFlow</bpmn:incoming>
        <bpmn:incoming>PrepareQuestionAutoFlow</bpmn:incoming>
        <bpmn:outgoing>Flow_12mi7n8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_12mi7n8" sourceRef="Gateway_1mtzd0x" targetRef="Merge_Automatic" />
      <bpmn:boundaryEvent id="ReplyTakenOver" name="Mitarbeiterübernahme bestätigt" attachedToRef="Reply">
        <bpmn:outgoing>ReplyTakenOverFlow</bpmn:outgoing>
        <bpmn:conditionalEventDefinition id="ConditionalEventDefinition_0bcks3j">
          <bpmn:condition xsi:type="bpmn:tFormalExpression">= staffTakeoverReplyEntryRef != null and staffTakeoverReplyEntryRef != "" and staffTakeoverReplyEntryRef = replyEntryContextRef</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:intermediateThrowEvent id="Event_14iaxoj" name="REVIEW">
        <bpmn:documentation>Prüfung / Bearbeitung / Wiedervorlage</bpmn:documentation>
        <bpmn:incoming>AParentReview</bpmn:incoming>
        <bpmn:linkEventDefinition id="LinkEventDefinition_0ik7ddd" name="FORTSETZEN" />
      </bpmn:intermediateThrowEvent>
      <bpmn:intermediateThrowEvent id="Event_1bcg88b" name="Prüfung / Bearbeitung / Wiedervorlage">
        <bpmn:documentation>Prüfung / Bearbeitung / Wiedervorlage</bpmn:documentation>
        <bpmn:incoming>F_Reopen_Staff</bpmn:incoming>
        <bpmn:linkEventDefinition id="LinkEventDefinition_18velnp" name="FORTSETZEN" />
      </bpmn:intermediateThrowEvent>
      <bpmn:endEvent id="Event_00yzly3" name="Aktive Bearbeitung beendet">
        <bpmn:documentation>Erst nach erfolgreichem Close-Commit. Terminiert nur ActiveCase samt laufenden Ereignis-Teilprozessen und Empfang; der äussere Prozess endet danach ohne Abschlussmail. Kein fachlicher Abschluss allein durch ein technisches Endereignis.</bpmn:documentation>
        <bpmn:incoming>AParentClosed</bpmn:incoming>
        <bpmn:terminateEventDefinition id="TerminateEventDefinition_1b3fs9g" />
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="Gateway_1eukhr4">
        <bpmn:incoming>AIWait</bpmn:incoming>
        <bpmn:incoming>AParentWait</bpmn:incoming>
        <bpmn:outgoing>Flow_03pax24</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_03pax24" sourceRef="Gateway_1eukhr4" targetRef="Merge_Reply" />
      <bpmn:exclusiveGateway id="StaffRoute" name="Fortsetzung">
        <bpmn:incoming>F15</bpmn:incoming>
        <bpmn:outgoing>F16</bpmn:outgoing>
        <bpmn:outgoing>F17</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="F16" name="Abschluss bestätigt" sourceRef="StaffRoute" targetRef="Merge_Close">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffOutcome = "CLOSE"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:textAnnotation id="TextAnnotation_11bg4o9" />
      <bpmn:association id="Association_14axxrg" associationDirection="None" sourceRef="ReplyManualQuestion" targetRef="TextAnnotation_11bg4o9" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Merge_End" gatewayDirection="Converging">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>SC05</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End" name="Durchlauf beendet">
      <bpmn:documentation>
Technisches Ende: nach regulärem Fallabschluss oder abgelehntem Wiedereröffnungsstart. Dieses Ereignis selbst ändert keinen Status und verschickt keine Nachricht.</bpmn:documentation>
      <bpmn:incoming>Flow_Merge_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Merge_End" sourceRef="Merge_End" targetRef="End" />
    <bpmn:sequenceFlow id="F12" sourceRef="ActiveCase" targetRef="Merge_End" />
    <bpmn:startEvent id="ProcessStart" name="Startauftrag übernommen">
      <bpmn:outgoing>P01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="PrepareProcessKey" name="Prozessschlüssel&#10;bereitstellen">
      <bpmn:documentation>Technische Vorstufe des Entwurfs: processInstanceKey aus den Jobmetadaten als String im Prozess bereitstellen, bevor der Empfangsbereich aktiviert wird. Noch keine führende Fallzuordnung, kein Erledigen des Startauftrags und keine fachliche Aktivierung. Derselbe Schlüssel wird anschliessend von Register in der bestehenden Zuordnungstransaktion gespeichert. Implementierung und Präzisierung gegenüber dem ersten Zuordnungsjob in ADR-002/SS-003 sind noch offen.
Startart und Auftragsreferenz aus einem serverseitig autorisierten Startauftrag prüfen. INITIAL oder REOPEN sind keine frei wählbaren Clientwerte. Ungültige Aufträge stoppen vor fachlicher Wirkung. Prozessschlüsselbereitstellung allein ersetzt niemals die führende Zuordnung.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="propertyflow-prepare-process-key" />
      </bpmn:extensionElements>
      <bpmn:incoming>P01</bpmn:incoming>
      <bpmn:outgoing>P02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="P01" sourceRef="ProcessStart" targetRef="PrepareProcessKey" />
    <bpmn:sequenceFlow id="P02" sourceRef="PrepareProcessKey" targetRef="ActiveCase" />
    <bpmn:boundaryEvent id="StaffClosureCommitted" name="Mitarbeiterabschluss&#10;aus Abklärung gespeichert" attachedToRef="ActiveCase">
      <bpmn:documentation>Nur Erfolg nach geprüftem und gespeichertem Mitarbeiterabschluss aus In Abklärung. Unterbricht gesamten ActiveCase samt untergeordneten Aktivitäten und Nebenaktionen; danach Durchlaufende. Datenbanksperre gegen verspätete Worker gilt bereits seit Abschlusscommit, nicht erst seit BPMN-Unterbrechung. Bereits gestartete eigenständige Mailprozesse bleiben erhalten.</bpmn:documentation>
      <bpmn:outgoing>SC05</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="StaffClosureCommitted_definition" escalationRef="Escalation_StaffCloseCommitted" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="SC05" sourceRef="StaffClosureCommitted" targetRef="Merge_End" />
    <bpmn:textAnnotation id="ProcessScopeNote">
      <bpmn:text>FACHENTWURF 0.26 · nicht ausführbar
Im Teilprozess «Aktiven Fall bearbeiten» liegen der bisherige Hauptablauf
und der durchgängige Mieternachrichteneingang.
Empfang vor fachlicher Aktivierung; Ende erst nach gespeichertem Abschluss.
Technische Startpräzisierung mit ADR-002 / SS-003 noch abzustimmen.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
