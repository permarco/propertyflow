        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="Erneut_warten_zusammenfuehren_zu_Erneut_warten_END_FLOW" sourceRef="Erneut_warten_zusammenfuehren_XOR" targetRef="Erneut_warten_END" />
        <bpmn:sequenceFlow id="Mitarbeiterbearbeitung_zusammenfuehren_XOR_zu_Mitarbeiterbearbeitung_END_FLOW" sourceRef="Mitarbeiterbearbeitung_zusammenfuehren_XOR" targetRef="Mitarbeiterbearbeitung_END" />
        <bpmn:endEvent id="Erneut_warten_END" name="Erneut warten">
          <bpmn:extensionElements>
