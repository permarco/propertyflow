          <bpmn:incoming>Pruefkontext_fuer_Mitarbeiter_Aktuelle_Mitarbeiterpruefung_zu_Mitarbeiterbearbeitung_zusammenfuehren_XOR_FLOW</bpmn:incoming>
          <bpmn:incoming>Wiedervorlage_Eintritt_vorbereiten_Gepruefter_Eintritt_Wiedervorlage_neuer_Pruefbedarf_zu_Mitarbeiterbearbeitung_zusammenfuehren_XOR_FLOW</bpmn:incoming>
          <bpmn:incoming>Gepruefte_Fortsetzung_XOR_Pruefung_Bearbeitung_Wiedervorlage_zu_Mitarbeiterbearbeitung_zusammenfuehren_XOR_FLOW</bpmn:incoming>
