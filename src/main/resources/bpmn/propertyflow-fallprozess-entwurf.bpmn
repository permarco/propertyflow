          <bpmn:extensionElements>
            <zeebe:ioMapping>
              <zeebe:output source="= &#34;AUTOMATIC&#34;" target="replyContinuationOutcome" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:incoming>Automatik_fortsetzen_zusammenfuehren_zu_Automatik_fortsetzen_END_FLOW</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:endEvent id="Mitarbeiterabschluss_pruefen_END" name="Mitarbeiterabschluss pruefen">
          <bpmn:extensionElements>
            <zeebe:ioMapping>
              <zeebe:output source="= &#34;CLOSE&#34;" target="replyContinuationOutcome" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:incoming>Warum_endet_das_Mitarbeiterabschluss_bestaetigt_zu_Mitarbeiterabschluss_pruefen_END_FLOW</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:group id="Automatik_vorbereiten_GROUP" categoryValueRef="Automatik_vorbereiten_CATEGORY_VALUE" />
        <bpmn:group id="Grund_der_Abloesung_pruefen_und_uebergeben_GROUP" categoryValueRef="Grund_der_Abloesung_pruefen_und_uebergeben_CATEGORY_VALUE" />
        <bpmn:textAnnotation id="Antwort_oder_bestaetigte_Abloesung_fuehren_NOTE">
          <bpmn:text>Antwort oder bestätigte Ablösung führen zur passenden
Fortsetzung. Rechts stehen die nächsten Fallphasen.</bpmn:text>
        </bpmn:textAnnotation>
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="Fortsetzung_bestimmen_SUBPROCESS_zu_Naechste_Fallphase_XOR_FLOW" sourceRef="Fortsetzung_bestimmen_SUBPROCESS" targetRef="Naechste_Fallphase_XOR">
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:exclusiveGateway id="Naechste_Fallphase_XOR" name="Naechste Fallphase" gatewayDirection="Diverging">
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Fortsetzung_bestimmen_SUBPROCESS_zu_Naechste_Fallphase_XOR_FLOW</bpmn:incoming>
        <bpmn:outgoing>Naechste_Fallphase_XOR_Erneut_warten_zu_Auf_ausgewertete_Mieterantwort_warten_FLOW</bpmn:outgoing>
        <bpmn:outgoing>Naechste_Fallphase_XOR_zu_Mitarbeiterbearbeitung_THROW_FLOW</bpmn:outgoing>
        <bpmn:outgoing>Naechste_Fallphase_XOR_zu_Automatik_fortsetzen_THROW_FLOW</bpmn:outgoing>
        <bpmn:outgoing>Naechste_Fallphase_XOR_zu_Fall_abschliessen_THROW_FLOW</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Naechste_Fallphase_XOR_Erneut_warten_zu_Auf_ausgewertete_Mieterantwort_warten_FLOW" name="Erneut warten" sourceRef="Naechste_Fallphase_XOR" targetRef="Auf_ausgewertete_Mieterantwort_warten_zusammenfuehren_XOR">
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyContinuationOutcome = "WAIT"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Naechste_Fallphase_XOR_zu_Mitarbeiterbearbeitung_THROW_FLOW" sourceRef="Naechste_Fallphase_XOR" targetRef="Mitarbeiterbearbeitung_THROW">
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyContinuationOutcome = "STAFF"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Naechste_Fallphase_XOR_zu_Automatik_fortsetzen_THROW_FLOW" sourceRef="Naechste_Fallphase_XOR" targetRef="Automatik_fortsetzen_THROW">
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyContinuationOutcome = "AUTOMATIC"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Naechste_Fallphase_XOR_zu_Fall_abschliessen_THROW_FLOW" sourceRef="Naechste_Fallphase_XOR" targetRef="Fall_abschliessen_THROW">
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyContinuationOutcome = "CLOSE"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:intermediateThrowEvent id="Automatik_fortsetzen_THROW" name="Automatik fortsetzen">
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Naechste_Fallphase_XOR_zu_Automatik_fortsetzen_THROW_FLOW</bpmn:incoming>
        <bpmn:linkEventDefinition id="Automatik_fortsetzen_THROW_LINK_DEF" name="REPLYCONTINUEAUTOMATIC" />
      </bpmn:intermediateThrowEvent>
      <bpmn:intermediateCatchEvent id="Automatik_fortsetzen_CATCH" name="Automatik fortsetzen">
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:outgoing>Automatik_fortsetzen_CATCH_zu_Automatische_Abklaerung_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
        <bpmn:linkEventDefinition id="Automatik_fortsetzen_CATCH_LINK_DEF" name="REPLYCONTINUEAUTOMATIC" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Automatik_fortsetzen_CATCH_zu_Automatische_Abklaerung_zusammenfuehren_XOR_FLOW" sourceRef="Automatik_fortsetzen_CATCH" targetRef="Automatische_Abklaerung_zusammenfuehren_XOR">
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:intermediateThrowEvent id="Fall_abschliessen_THROW" name="Fall abschliessen">
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Naechste_Fallphase_XOR_zu_Fall_abschliessen_THROW_FLOW</bpmn:incoming>
        <bpmn:linkEventDefinition id="Fall_abschliessen_THROW_LINK_DEF" name="REPLYCONTINUECLOSE" />
      </bpmn:intermediateThrowEvent>
      <bpmn:intermediateCatchEvent id="Fall_abschliessen_CATCH" name="Fall abschliessen">
        <bpmn:categoryValueRef>Fallabschluss_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:outgoing>Fall_abschliessen_CATCH_zu_Mitarbeiterabschluss_pruefen_und_speichern_FLOW</bpmn:outgoing>
        <bpmn:linkEventDefinition id="Fall_abschliessen_CATCH_LINK_DEF" name="REPLYCONTINUECLOSE" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Fall_abschliessen_CATCH_zu_Mitarbeiterabschluss_pruefen_und_speichern_FLOW" sourceRef="Fall_abschliessen_CATCH" targetRef="Mitarbeiterabschluss_pruefen_und_speichern_zusammenfuehren_XOR">
        <bpmn:categoryValueRef>Fallabschluss_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:exclusiveGateway id="Mitarbeiterabschluss_pruefen_und_speichern_zusammenfuehren_XOR" gatewayDirection="Converging">
        <bpmn:categoryValueRef>Fallabschluss_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Fortsetzung_Aktiven_Fall_Abschluss_bestaetigt_zu_Mitarbeiterabschluss_pruefen_und_speichern_FLOW</bpmn:incoming>
        <bpmn:incoming>Fall_abschliessen_CATCH_zu_Mitarbeiterabschluss_pruefen_und_speichern_FLOW</bpmn:incoming>
        <bpmn:outgoing>Mitarbeiterabschluss_pruefen_und_zu_Mitarbeiterabschluss_pruefen_und_speichern_FLOW</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Mitarbeiterabschluss_pruefen_und_speichern_SERVICE" name="Mitarbeiterabschluss&#10;pruefen und speichern">
        <bpmn:documentation>FALL-07: Ausschliesslich Mitarbeiterabschluss aus aktueller bestätigter Entscheidung. Derselbe fachliche Abschlussvertrag wie AutoClose; keine zweite Domänenlogik. Berechtigung, führenden Durchlauf und aktuellen Fallstand einschliesslich neuer Nachrichten prüfen. Laufende KI allein blockiert den Mitarbeiterabschluss nicht. Ohne Nachrichten- oder Kommentarpflicht. Speicherung konsistent gegen konkurrierende Änderungen prüfen; veraltet -&gt; STAFF_CLOSURE_STALE und CloseConflict zur Mitarbeiterprüfung. Technische Fehler Retry/Incident. Bereits erfolgreicher identischer Auftrag bleibt Erfolg. Antwortbedarf/Wiedervorlage bei Erfolg beenden; keine zusätzliche Abschlussmail, frühere Nachrichten und Mailpflichten erhalten. Nach Commit beendet ActiveEnd den aktiven Bereich; späte Worker dürfen nicht wirken.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.staff.close" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>Fallabschluss_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Mitarbeiterabschluss_pruefen_und_zu_Mitarbeiterabschluss_pruefen_und_speichern_FLOW</bpmn:incoming>
        <bpmn:outgoing>Mitarbeiterabschluss_pruefen_und_zu_Mitarbeiterabschluss_pruefen_und_speichern_2_FLOW</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Mitarbeiterabschluss_pruefen_und_zu_Mitarbeiterabschluss_pruefen_und_speichern_FLOW" sourceRef="Mitarbeiterabschluss_pruefen_und_speichern_zusammenfuehren_XOR" targetRef="Mitarbeiterabschluss_pruefen_und_speichern_SERVICE">
        <bpmn:categoryValueRef>Fallabschluss_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:boundaryEvent id="Mitarbeiterentscheidung_veraltet_BOUNDARY" name="Mitarbeiterentscheidung&#10;veraltet" attachedToRef="Mitarbeiterabschluss_pruefen_und_speichern_SERVICE">
        <bpmn:documentation>Unterbricht nur den Abschlussversuch vor erfolgreicher fachlicher Speicherung. FActiveClose und damit das terminierende Ende werden nicht erreicht. Die erledigte Mitarbeiteraufgabe wird nicht reaktiviert: Rückkehr in Staff stellt genau eine neue Aufgabe für den aktuellen Fallstand bereit. Alte Abschlussfreigabe verwerfen; internen Grund Fallstand seit Abschlussbestätigung geändert übernehmen. Kein Abschlussnachweis, kein Abschlussmailauftrag und keine Wiedereröffnung. ActiveCase und der zentrale Mieternachrichtenempfang bleiben aktiv. Wiederholungen dürfen die neue Aufgabe nicht duplizieren. Vor User-Task-Abschluss abgewiesene veraltete Aktionen lassen die bisherige Aufgabe offen und laufen nicht über dieses Ereignis.
0.20: Gilt auch für direkten Mitarbeiterabschluss aus Wartet auf Mieterantwort. Nach übernommener Entscheidung festgestellter Konflikt führt genau einmal zu Mitarbeiterprüfung am aktuellen Fallstand; offener Antwortbedarf bleibt bis zur zulässigen Erledigung bestehen. Vor Übernahme abgelehnte Aufträge erreichen diesen Pfad nicht.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= staffEntryContextRef" target="staffEntryContextRef" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>Fallabschluss_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:outgoing>Mitarbeiterentscheidung_veraltet_BOUNDARY_Aktuellen_Fallstand_erneut_pruefen_zu_Aktuellen_Fallstand_erneut_pruefen_FLOW</bpmn:outgoing>
        <bpmn:errorEventDefinition id="Mitarbeiterentscheidung_veraltet_BOUNDARY_ERROR_DEF" errorRef="Mitarbeiterentscheidung_veraltet_ERROR" />
      </bpmn:boundaryEvent>
      <bpmn:callActivity id="Mitarbeiterpruefung_und_Bearbeitung_CALL" name="Mitarbeiterpruefung und Bearbeitung">
        <bpmn:documentation>
Ruft mitarbeiterbearbeitung.bpmn auf. Vertrag: teilprozess-vertraege.md. Untergeordnete Instanz mit eigenem Scope; führende Fallzuordnung bleibt im Hauptprozess. Eingangsreferenz vor Aktivierung bereitstellen. Nur explizite Outputs übernehmen; aktueller Fallstand bleibt vor Wirkung zu prüfen.
0.19: Geprüfter Eintritt nach manueller Aufhebung des letzten Antwortbedarfs ohne Prüfbedarf führt direkt zu SWork. entryContextRef wird durch ClearAnswerContinue serverseitig bereitgestellt; mit Prüfbedarf regulärer Review-Eintritt.
0.35: Einziger Eingang SCStart nach exklusiver Übernahme. entryContextRef enthält den gültigen Anspruch für diesen Ausführungspfad. SEntryCheck registriert die tatsächliche Kindinstanz dazu. Reservierung und Engine-Call müssen nach Absturz abgeglichen werden, kein zweiter paralleler Call bei unklarer Startantwort.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:calledElement processId="Mitarbeiterbearbeitung_PROCESS" propagateAllChildVariables="false" propagateAllParentVariables="false" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= caseId" target="caseId" />
            <zeebe:input source="= processInstanceKey" target="leadingProcessInstanceKey" />
            <zeebe:input source="= staffEntryContextRef" target="entryContextRef" />
            <zeebe:output source="= outcome" target="staffOutcome" />
            <zeebe:output source="= decisionRef" target="staffDecisionRef" />
            <zeebe:output source="= if outcome = &#34;WAIT_FOR_REPLY&#34; then decisionRef else &#34;&#34;" target="replyEntryContextRef" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>Mitarbeiterpruefung_und_Bearbeitung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Wer_fuehrt_weiter_START_neuer_Aufruf_zu_Mitarbeiterpruefung_und_Bearbeitung_CALL_FLOW</bpmn:incoming>
        <bpmn:outgoing>Mitarbeiterpruefung_und_Bearbeitung_zu_Fortsetzung_Aktiven_Fall_bearbeiten_FLOW</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="Empfangsbereich_aktiv_START_zu_Erstanlage_oder_Wiedereroeffnung_XOR_FLOW" sourceRef="Empfangsbereich_aktiv_START" targetRef="Erstanlage_oder_Wiedereroeffnung_XOR">
        <bpmn:categoryValueRef>Fallstart_und_Wiedereroeffnung_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Auf_ausgewertete_Mieterantwort_Antwort_ausgewertet_zu_Fortsetzung_bestimmen_zusammenfuehren_XOR_FLOW" name="Antwort ausgewertet" sourceRef="Auf_ausgewertete_Mieterantwort_warten_CALL" targetRef="Fortsetzung_bestimmen_zusammenfuehren_XOR">
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Mitarbeiterpruefung_und_Bearbeitung_zu_Fortsetzung_Aktiven_Fall_bearbeiten_FLOW" sourceRef="Mitarbeiterpruefung_und_Bearbeitung_CALL" targetRef="Fortsetzung_Aktiven_Fall_bearbeiten_2_XOR" />
      <bpmn:sequenceFlow id="Fortsetzung_Aktiven_Fall_Rueckfrage_veroeffentlicht_zu_Auf_ausgewertete_Mieterantwort_warten_FLOW" name="Rueckfrage veroeffentlicht" sourceRef="Fortsetzung_Aktiven_Fall_bearbeiten_2_XOR" targetRef="Auf_ausgewertete_Mieterantwort_warten_zusammenfuehren_XOR">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffOutcome = "WAIT_FOR_REPLY"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:exclusiveGateway id="Mitarbeiterabschluss_pruefen_und_speichern_verzweigen_XOR" gatewayDirection="Converging">
        <bpmn:categoryValueRef>Fallabschluss_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Mitarbeiterabschluss_pruefen_und_zu_Mitarbeiterabschluss_pruefen_und_speichern_2_FLOW</bpmn:incoming>
        <bpmn:outgoing>Mitarbeiterabschluss_pruefen_und_zu_Aktive_Bearbeitung_beendet_Aktiven_FLOW</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="Aktive_Bearbeitung_beendet_Aktiven_Fall_bearbeiten_END" name="Aktive Bearbeitung beendet">
        <bpmn:documentation>Erst nach erfolgreichem Close-Commit. Terminiert nur ActiveCase samt laufenden Ereignis-Teilprozessen und Empfang; der äussere Prozess endet danach ohne Abschlussmail. Kein fachlicher Abschluss allein durch ein technisches Endereignis.</bpmn:documentation>
        <bpmn:categoryValueRef>Fallabschluss_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Mitarbeiterabschluss_pruefen_und_zu_Aktive_Bearbeitung_beendet_Aktiven_FLOW</bpmn:incoming>
        <bpmn:terminateEventDefinition id="Aktive_Bearbeitung_beendet_Aktiven_Fall_bearbeiten_END_TERMINATE_DEF" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Mitarbeiterabschluss_pruefen_und_zu_Aktive_Bearbeitung_beendet_Aktiven_FLOW" sourceRef="Mitarbeiterabschluss_pruefen_und_speichern_verzweigen_XOR" targetRef="Aktive_Bearbeitung_beendet_Aktiven_Fall_bearbeiten_END">
        <bpmn:categoryValueRef>Fallabschluss_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Mitarbeiterabschluss_pruefen_und_zu_Mitarbeiterabschluss_pruefen_und_speichern_2_FLOW" sourceRef="Mitarbeiterabschluss_pruefen_und_speichern_SERVICE" targetRef="Mitarbeiterabschluss_pruefen_und_speichern_verzweigen_XOR">
        <bpmn:categoryValueRef>Fallabschluss_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Mitarbeiterentscheidung_veraltet_BOUNDARY_Aktuellen_Fallstand_erneut_pruefen_zu_Aktuellen_Fallstand_erneut_pruefen_FLOW" name="Aktuellen Fallstand erneut pruefen" sourceRef="Mitarbeiterentscheidung_veraltet_BOUNDARY" targetRef="Aktuellen_Fallstand_erneut_pruefen_THROW" />
      <bpmn:exclusiveGateway id="Erstanlage_oder_Wiedereroeffnung_XOR" name="Erstanlage oder&#10;Wiedereroeffnung?">
        <bpmn:categoryValueRef>Fallstart_und_Wiedereroeffnung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Empfangsbereich_aktiv_START_zu_Erstanlage_oder_Wiedereroeffnung_XOR_FLOW</bpmn:incoming>
        <bpmn:outgoing>Erstanlage_oder_Wiedereroeffnung_Erstanlage_zu_Fuehrenden_Prozess_zuordnen_SERVICE_FLOW</bpmn:outgoing>
        <bpmn:outgoing>Erstanlage_oder_Wiedereroeffnung_Wiedereroeffnung_zu_Wiedereroeffnung_pruefen_und_zuordnen_FLOW</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Wiedereroeffnung_pruefen_und_zuordnen_SERVICE" name="Wiedereroeffnung&#10;pruefen und zuordnen">
        <bpmn:documentation>BEN-03 / 0.23: Bei tatsächlicher benachrichtigungspflichtiger Änderung Ereignis und Mailpflicht dauerhaft zusammen sichern. Der dauerhafte Starter startet fallbenachrichtigung-versenden.bpmn mit mailOrderRef; dort beauftragen Camunda-Send-Tasks den Mail-Worker. Hier kein direkter SMTP-Aufruf und kein Warten auf SMTP. Unveränderte Werte und identische Wiederholungen erzeugen keine neue Mailpflicht.
FALL-07 / ADR-002 Ergänzung 15.11.2026: Autorisierten Wiedereröffnungsauftrag, abgeschlossenen Fall, beendete Vorgängerinstanz und aktuelle Generation prüfen. Neue führende Instanz, Generation, Zielstatus, Mitarbeiter und Auftragserledigung konsistent speichern. Ohne offenen Prüfbedarf In Bearbeitung, sonst Mitarbeiterprüfung erforderlich. Geprüften staffEntryContextRef bereitstellen. Bis Commit bleibt der Fall abgeschlossen und gesperrt. Identischen erfolgreichen Auftrag mit derselben Instanz idempotent bestätigen; fremde oder überholte Instanz niemals übernehmen. Fachliche Ablehnung ausdrücklich REOPEN_REJECTED; technische Fehler bleiben Job-Retries/Incidents. Keine neue Fallanlage, Ersttriage oder Reaktivierung alter Aufgaben.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.case.reopen" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>Fallstart_und_Wiedereroeffnung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Erstanlage_oder_Wiedereroeffnung_Wiedereroeffnung_zu_Wiedereroeffnung_pruefen_und_zuordnen_FLOW</bpmn:incoming>
        <bpmn:outgoing>Wiedereroeffnung_pruefen_und_zu_Pruefung_Bearbeitung_Wiedervorlage_Aktiven_FLOW</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Erstanlage_oder_Wiedereroeffnung_Erstanlage_zu_Fuehrenden_Prozess_zuordnen_SERVICE_FLOW" name="Erstanlage" sourceRef="Erstanlage_oder_Wiedereroeffnung_XOR" targetRef="Fuehrenden_Prozess_zuordnen_SERVICE">
        <bpmn:categoryValueRef>Fallstart_und_Wiedereroeffnung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= startKind = "INITIAL"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Erstanlage_oder_Wiedereroeffnung_Wiedereroeffnung_zu_Wiedereroeffnung_pruefen_und_zuordnen_FLOW" name="Wiedereroeffnung" sourceRef="Erstanlage_oder_Wiedereroeffnung_XOR" targetRef="Wiedereroeffnung_pruefen_und_zuordnen_SERVICE">
        <bpmn:categoryValueRef>Fallstart_und_Wiedereroeffnung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= startKind = "REOPEN"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Wiedereroeffnung_pruefen_und_zu_Pruefung_Bearbeitung_Wiedervorlage_Aktiven_FLOW" name="" sourceRef="Wiedereroeffnung_pruefen_und_zuordnen_SERVICE" targetRef="Pruefung_Bearbeitung_Wiedervorlage_Aktiven_Fall_bearbeiten_2_THROW">
        <bpmn:categoryValueRef>Fallstart_und_Wiedereroeffnung_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:boundaryEvent id="Auftrag_nicht_mehr_gueltig_BOUNDARY" name="Auftrag nicht mehr gueltig" attachedToRef="Wiedereroeffnung_pruefen_und_zuordnen_SERVICE">
        <bpmn:categoryValueRef>Fallstart_und_Wiedereroeffnung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:outgoing>Auftrag_nicht_mehr_zu_Start_abgelehnt_Keine_Fallaenderung_FLOW</bpmn:outgoing>
        <bpmn:errorEventDefinition id="Auftrag_nicht_mehr_gueltig_BOUNDARY_ERROR_DEF" errorRef="Wiedereroeffnung_abgelehnt_ERROR" />
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="Start_abgelehnt_Keine_Fallaenderung_END" name="Start abgelehnt&#10;Keine Fallaenderung">
        <bpmn:categoryValueRef>Fallstart_und_Wiedereroeffnung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Auftrag_nicht_mehr_zu_Start_abgelehnt_Keine_Fallaenderung_FLOW</bpmn:incoming>
        <bpmn:terminateEventDefinition id="Start_abgelehnt_Keine_Fallaenderung_END_TERMINATE_DEF" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Auftrag_nicht_mehr_zu_Start_abgelehnt_Keine_Fallaenderung_FLOW" name="" sourceRef="Auftrag_nicht_mehr_gueltig_BOUNDARY" targetRef="Start_abgelehnt_Keine_Fallaenderung_END">
        <bpmn:categoryValueRef>Fallstart_und_Wiedereroeffnung_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:boundaryEvent id="Wartephase_abgeloest_BOUNDARY" name="Wartephase abgeloest" attachedToRef="Auf_ausgewertete_Mieterantwort_warten_CALL">
        <bpmn:documentation>Unterbricht nur den aktuellen Mieterwarteaufruf. Ob einer der sechs gespeicherten und zum Aufruf passenden Gründe vorliegt, wird mit den bisherigen Bedingungen geprüft. Beim Verlassen des Calls wird der Grund für das folgende Gateway gespeichert. Bei gleichzeitig passenden Bedingungen gilt die bisherige Auslösereihenfolge von Camunda 8.9.19 (umgekehrte XML-Deklarationsreihenfolge). Die bisherigen Abschluss- und Wiedervorlagereferenzen werden für den jeweiligen Pfad übernommen. Ein abgebrochener Aufruf liefert kein normales Antwortergebnis.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= if (staffTakeoverReplyEntryRef != null and staffTakeoverReplyEntryRef != &#34;&#34; and staffTakeoverReplyEntryRef = replyEntryContextRef) then &#34;TAKEOVER&#34;&#10;else if (reviewNeedReplyCallRef != null and reviewNeedReplyCallRef = activeReplyCallRef and activeReplyEntryRef != null and activeReplyEntryRef = replyEntryContextRef) then &#34;REVIEW&#34;&#10;else if (manualQuestionPreviousReplyEntryRef != null and manualQuestionPreviousReplyEntryRef != &#34;&#34; and manualQuestionPreviousReplyEntryRef = replyEntryContextRef) then &#34;MANUAL_QUESTION&#34;&#10;else if (staffFollowReplyEntryRef != null and staffFollowReplyEntryRef != &#34;&#34; and staffFollowReplyEntryRef = replyEntryContextRef and (staffFollowReplyCallRef = &#34;&#34; or staffFollowReplyCallRef = activeReplyCallRef)) then &#34;FOLLOW_UP&#34;&#10;else if (staffCloseReplyCallRef != null and staffCloseReplyCallRef = activeReplyCallRef and staffCloseReplyEntryRef = replyEntryContextRef) then &#34;CLOSE&#34;&#10;else if ((clearedAnswerCallRef != null and clearedAnswerCallRef = activeReplyCallRef and activeReplyEntryRef != null and activeReplyEntryRef = replyEntryContextRef) or (clearedReplyEntryRef != null and clearedReplyEntryRef = replyEntryContextRef)) then &#34;CLEAR_ANSWER&#34;&#10;else null" target="replyExitReason" />
            <zeebe:output source="= if replyExitReason = &#34;CLOSE&#34; then &#34;CLOSE&#34; else staffOutcome" target="staffOutcome" />
            <zeebe:output source="= if replyExitReason = &#34;CLOSE&#34; then staffReplyClosureDecisionRef else staffDecisionRef" target="staffDecisionRef" />
            <zeebe:output source="= if replyExitReason = &#34;FOLLOW_UP&#34; then staffFollowCommandRef else directFollowContinuationRef" target="directFollowContinuationRef" />
            <zeebe:output source="= &#34;INTERRUPTED&#34;" target="replyContinuationSource" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:outgoing>Wartephase_abgeloest_BOUNDARY_zu_Fortsetzung_bestimmen_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
        <bpmn:conditionalEventDefinition id="Wartephase_abgeloest_BOUNDARY_CONDITIONAL_DEF">
          <bpmn:condition xsi:type="bpmn:tFormalExpression">= (staffTakeoverReplyEntryRef != null and staffTakeoverReplyEntryRef != "" and staffTakeoverReplyEntryRef = replyEntryContextRef)
or (reviewNeedReplyCallRef != null and reviewNeedReplyCallRef = activeReplyCallRef and activeReplyEntryRef != null and activeReplyEntryRef = replyEntryContextRef)
or (manualQuestionPreviousReplyEntryRef != null and manualQuestionPreviousReplyEntryRef != "" and manualQuestionPreviousReplyEntryRef = replyEntryContextRef)
or (staffFollowReplyEntryRef != null and staffFollowReplyEntryRef != "" and staffFollowReplyEntryRef = replyEntryContextRef and (staffFollowReplyCallRef = "" or staffFollowReplyCallRef = activeReplyCallRef))
or (staffCloseReplyCallRef != null and staffCloseReplyCallRef = activeReplyCallRef and staffCloseReplyEntryRef = replyEntryContextRef)
or ((clearedAnswerCallRef != null and clearedAnswerCallRef = activeReplyCallRef and activeReplyEntryRef != null and activeReplyEntryRef = replyEntryContextRef) or (clearedReplyEntryRef != null and clearedReplyEntryRef = replyEntryContextRef))</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Wartephase_abgeloest_BOUNDARY_zu_Fortsetzung_bestimmen_zusammenfuehren_XOR_FLOW" sourceRef="Wartephase_abgeloest_BOUNDARY" targetRef="Fortsetzung_bestimmen_zusammenfuehren_XOR">
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:serviceTask id="Erste_Abklaerung_vorbereiten_SERVICE" name="Erste Abklaerung vorbereiten">
        <bpmn:documentation>Aktuellen Fallstand, führenden Durchlauf und Herkunft INITIAL prüfen; automaticEntryContextRef bereitstellen. Für QUESTION/CLOSE aktuellen replyDecisionRef verwenden, keine alte Freigabe und kein Statusreset. automaticCallRef für genau diesen Aufruf und Unterbrechungsbezug bereitstellen; nachholbare Registrierung mit offenen Prüfentscheiden koordinieren. Alte konsumierte Marker nicht wiederverwenden, neuen Prüfbedarf nicht löschen.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow-prepare-initial" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Fuehrenden_Prozess_zuordnen_zu_Erste_Abklaerung_vorbereiten_SERVICE_FLOW</bpmn:incoming>
        <bpmn:outgoing>Erste_Abklaerung_vorbereiten_zu_Automatische_Abklaerung_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Erste_Abklaerung_vorbereiten_zu_Automatische_Abklaerung_zusammenfuehren_XOR_FLOW" name="" sourceRef="Erste_Abklaerung_vorbereiten_SERVICE" targetRef="Automatische_Abklaerung_zusammenfuehren_XOR">
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Fuehrenden_Prozess_zuordnen_zu_Erste_Abklaerung_vorbereiten_SERVICE_FLOW" name="" sourceRef="Fuehrenden_Prozess_zuordnen_SERVICE" targetRef="Erste_Abklaerung_vorbereiten_SERVICE" />
      <bpmn:exclusiveGateway id="Automatische_Abklaerung_zusammenfuehren_XOR" gatewayDirection="Converging">
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Erste_Abklaerung_vorbereiten_zu_Automatische_Abklaerung_zusammenfuehren_XOR_FLOW</bpmn:incoming>
        <bpmn:incoming>Automatik_fortsetzen_CATCH_zu_Automatische_Abklaerung_zusammenfuehren_XOR_FLOW</bpmn:incoming>
        <bpmn:outgoing>Automatische_Abklaerung_zusammenfuehren_zu_Automatische_Abklaerung_CALL_FLOW</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:callActivity id="Automatische_Abklaerung_CALL" name="Automatische Abklaerung">
        <bpmn:documentation>Ruft automatische-abklaerung.bpmn auf. Eigener Scope; führende Fallzuordnung bleibt im Elternprozess. Genau eine aktuelle Call-Zuordnung. Normale Outputs nur bei regulärem Ende; bei Unterbrechung aktuellen persistierten Entscheid laden. Unterbrechung beendet auch Kindjobs, nicht zuverlässig bereits gestartete externe Nebenwirkungen. Deshalb Wirkungsprüfung im Dienst ab bestätigtem Prüfbedarf/Mitarbeiterentscheid.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:calledElement processId="Automatische_Abklaerung_PROCESS" propagateAllChildVariables="false" propagateAllParentVariables="false" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= caseId" target="caseId" />
            <zeebe:input source="= processInstanceKey" target="leadingProcessInstanceKey" />
            <zeebe:input source="= automaticEntryContextRef" target="entryContextRef" />
            <zeebe:input source="= automaticCallRef" target="automaticCallRef" />
            <zeebe:output source="= outcome" target="automaticOutcome" />
            <zeebe:output source="= decisionRef" target="automaticDecisionRef" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Automatische_Abklaerung_zusammenfuehren_zu_Automatische_Abklaerung_CALL_FLOW</bpmn:incoming>
        <bpmn:outgoing>Automatische_Abklaerung_CALL_zu_Automatik_Ergebnis_uebernehmen_SERVICE_FLOW</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="Automatische_Abklaerung_zusammenfuehren_zu_Automatische_Abklaerung_CALL_FLOW" sourceRef="Automatische_Abklaerung_zusammenfuehren_XOR" targetRef="Automatische_Abklaerung_CALL">
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:serviceTask id="Automatik_Ergebnis_uebernehmen_SERVICE" name="Automatik-Ergebnis uebernehmen">
        <bpmn:documentation>automaticOutcome/automaticDecisionRef gegen aktuellen Fallstand und Call prüfen. WAIT_FOR_REPLY: replyEntryContextRef bereitstellen; REVIEW: staffEntryContextRef; CLOSED nur nach gespeichertem Abschluss. Neuen zwingenden Prüfbedarf vor Fortsetzung berücksichtigen. Übergabe am Call-Ende und Unterbrechung atomar/logisch exklusiv koordinieren; keine parallelen Staff-Calls. Unbekannte Rückgabe ist Vertragsfehler, kein fachlicher Default.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.automatic.accept-result" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Automatische_Abklaerung_CALL_zu_Automatik_Ergebnis_uebernehmen_SERVICE_FLOW</bpmn:incoming>
        <bpmn:outgoing>Automatik_Ergebnis_uebernehmen_zu_Fortsetzung_Aktiven_Fall_bearbeiten_FLOW</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Fortsetzung_Aktiven_Fall_bearbeiten_XOR" name="Fortsetzung">
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Automatik_Ergebnis_uebernehmen_zu_Fortsetzung_Aktiven_Fall_bearbeiten_FLOW</bpmn:incoming>
        <bpmn:outgoing>Fortsetzung_Aktiven_Fall_Auf_Mieterantwort_warten_zu_Auf_ausgewertete_Mieterantwort_warten_FLOW</bpmn:outgoing>
        <bpmn:outgoing>Fortsetzung_Aktiven_Fall_REVIEW_zu_REVIEW_THROW_FLOW</bpmn:outgoing>
        <bpmn:outgoing>Fortsetzung_Aktiven_Fall_CLOSED_zu_Aktive_Bearbeitung_beendet_Aktiven_FLOW</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Automatische_Abklaerung_CALL_zu_Automatik_Ergebnis_uebernehmen_SERVICE_FLOW" name="" sourceRef="Automatische_Abklaerung_CALL" targetRef="Automatik_Ergebnis_uebernehmen_SERVICE">
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Automatik_Ergebnis_uebernehmen_zu_Fortsetzung_Aktiven_Fall_bearbeiten_FLOW" name="" sourceRef="Automatik_Ergebnis_uebernehmen_SERVICE" targetRef="Fortsetzung_Aktiven_Fall_bearbeiten_XOR">
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Fortsetzung_Aktiven_Fall_Auf_Mieterantwort_warten_zu_Auf_ausgewertete_Mieterantwort_warten_FLOW" name="Auf Mieterantwort warten" sourceRef="Fortsetzung_Aktiven_Fall_bearbeiten_XOR" targetRef="Auf_ausgewertete_Mieterantwort_warten_zusammenfuehren_XOR">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= automaticOutcome = "WAIT_FOR_REPLY"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Fortsetzung_Aktiven_Fall_REVIEW_zu_REVIEW_THROW_FLOW" name="REVIEW" sourceRef="Fortsetzung_Aktiven_Fall_bearbeiten_XOR" targetRef="REVIEW_THROW">
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= automaticOutcome = "REVIEW"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Fortsetzung_Aktiven_Fall_CLOSED_zu_Aktive_Bearbeitung_beendet_Aktiven_FLOW" name="CLOSED" sourceRef="Fortsetzung_Aktiven_Fall_bearbeiten_XOR" targetRef="Aktive_Bearbeitung_beendet_Aktiven_Fall_bearbeiten_2_END">
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= automaticOutcome = "CLOSED"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:boundaryEvent id="Bestaetigte_Abloesung_BOUNDARY" name="Bestaetigte Abloesung" attachedToRef="Automatische_Abklaerung_CALL">
        <bpmn:documentation>Gemeinsamer Unterbrechungspfad für geprüfte Mitarbeiterrückfrage, Terminsetzung, Übernahme oder neuen zwingenden Prüfbedarf. Nur bestätigte persistierte Entscheide zum aktuellen automaticCallRef. Condition sieht Elternvariablen; keine implizite Synchronisierung mit Kind oder Datenbank. Auch Retry/Incident unterbrechen; technische Realisierung und Runtime-Nachweis offen.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= &#34;AUTOMATIC&#34;" target="replyContinuationSource" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:outgoing>Bestaetigte_Abloesung_BOUNDARY_zu_Fortsetzung_pruefen_Aktiven_Fall_FLOW</bpmn:outgoing>
        <bpmn:conditionalEventDefinition id="Bestaetigte_Abloesung_BOUNDARY_CONDITIONAL_DEF">
          <bpmn:condition xsi:type="bpmn:tFormalExpression">= automaticInterruptionReady = true and automaticInterruptionCallRef = automaticCallRef</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="Fachlicher_Analysefehler_BOUNDARY" name="Fachlicher Analysefehler" attachedToRef="Automatische_Abklaerung_CALL">
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:outgoing>Fachlicher_Analysefehler_BOUNDARY_zu_Analysefehler_und_Pruefkontext_sichern_FLOW</bpmn:outgoing>
        <bpmn:errorEventDefinition id="Fachlicher_Analysefehler_BOUNDARY_ERROR_DEF" errorRef="KI_Analyse_fehlgeschlagen_ERROR" />
      </bpmn:boundaryEvent>
      <bpmn:serviceTask id="Analysefehler_und_Pruefkontext_sichern_SERVICE" name="Analysefehler und&#10;Pruefkontext sichern">
        <bpmn:documentation>Tatsächlich gemeldeten fachlichen Analysefehler speichern und staffEntryContextRef zur Mitarbeiterprüfung bereitstellen. Aktuellen Durchlauf/Fallstand prüfen; vorhandene Prüfung wiederverwenden, keinen neueren Entscheid zurücknehmen. Kein Zugriff auf normale Outputs des abgebrochenen Kindes. Technische Retries sind keine fachlichen Fehler.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.review.analysis-failure" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Fachlicher_Analysefehler_BOUNDARY_zu_Analysefehler_und_Pruefkontext_sichern_FLOW</bpmn:incoming>
        <bpmn:outgoing>Analysefehler_und_Pruefkontext_zu_Pruefung_Bearbeitung_Wiedervorlage_Aktiven_FLOW</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Fachlicher_Analysefehler_BOUNDARY_zu_Analysefehler_und_Pruefkontext_sichern_FLOW" name="" sourceRef="Fachlicher_Analysefehler_BOUNDARY" targetRef="Analysefehler_und_Pruefkontext_sichern_SERVICE">
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Analysefehler_und_Pruefkontext_zu_Pruefung_Bearbeitung_Wiedervorlage_Aktiven_FLOW" name="" sourceRef="Analysefehler_und_Pruefkontext_sichern_SERVICE" targetRef="Pruefung_Bearbeitung_Wiedervorlage_Aktiven_Fall_bearbeiten_THROW">
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:boundaryEvent id="Uebergabe_abgeloest_BOUNDARY" name="Uebergabe abgeloest" attachedToRef="Automatik_Ergebnis_uebernehmen_SERVICE">
        <bpmn:documentation>Dieselben bestätigten und an den aktuellen Automatikaufruf gebundenen Gründe unterbrechen die Ergebnisübernahme. Veröffentlichte Mitarbeiterrückfrage, bestätigte Übernahme oder direkte Wiedervorlage verwenden die bisherige Automatikfortsetzung. Antwortbedarf aufheben verwendet die bisherige Fortsetzung für die Aufhebung. Sind mehrere Bedingungen gleichzeitig erfüllt, gilt die Auslösereihenfolge der bisherigen Randereignisse in Camunda 8.9.19.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="= if (manualQuestionCallRef != null and manualQuestionCallRef = automaticCallRef) or ((staffTakeoverCallRef != null and staffTakeoverCallRef = automaticCallRef) or (staffFollowAutomaticCallRef != null and staffFollowAutomaticCallRef = automaticCallRef)) then &#34;AUTOMATIC&#34;&#10;else if (clearedAutomaticCallRef != null and clearedAutomaticCallRef = automaticCallRef) then &#34;CLEAR&#34;&#10;else null" target="replyContinuationSource" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:outgoing>Uebergabe_abgeloest_BOUNDARY_zu_Fortsetzung_pruefen_Aktiven_Fall_FLOW</bpmn:outgoing>
        <bpmn:conditionalEventDefinition id="Uebergabe_abgeloest_BOUNDARY_CONDITIONAL_DEF">
          <bpmn:condition xsi:type="bpmn:tFormalExpression">= (manualQuestionCallRef != null and manualQuestionCallRef = automaticCallRef)
or ((staffTakeoverCallRef != null and staffTakeoverCallRef = automaticCallRef) or (staffFollowAutomaticCallRef != null and staffFollowAutomaticCallRef = automaticCallRef))
or (clearedAutomaticCallRef != null and clearedAutomaticCallRef = automaticCallRef)</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Bestaetigte_Abloesung_BOUNDARY_zu_Fortsetzung_pruefen_Aktiven_Fall_FLOW" sourceRef="Bestaetigte_Abloesung_BOUNDARY" targetRef="Fortsetzung_pruefen_Aktiven_Fall_bearbeiten_2_THROW">
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:exclusiveGateway id="Aktiven_Fall_bearbeiten_verzweigen_XOR" gatewayDirection="Converging">
        <bpmn:categoryValueRef>Mitarbeiterpruefung_und_Bearbeitung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>FORTSETZEN_CATCH_zu_Aktiven_Fall_bearbeiten_verzweigen_FLOW</bpmn:incoming>
        <bpmn:outgoing>Aktiven_Fall_bearbeiten_zu_Mitarbeiterfortsetzung_uebernehmen_SERVICE_FLOW</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Mitarbeiterfortsetzung_uebernehmen_SERVICE" name="Mitarbeiterfortsetzung uebernehmen">
        <bpmn:documentation>FALL-06 Fortsetzungsvertrag B07 / FALL-AK-44: Persistierten Fortsetzungsauftrag mit Fall, führendem Durchlauf, Erkenntnis-/Fallversion, Operations-ID und Quell-/Zielbezug prüfen. Exklusiven Bearbeitungsanspruch konsistent sichern; konkurrierende Auftragseingänge dürfen keinen zweiten Staff-Aufruf beanspruchen. Drei Ergebnisse: START für diesen berechtigten Ausführungspfad, EXISTING für einen anderen nachweislich laufenden zuständigen Staff-Call, SUPERSEDED für erledigten/überholten Auftrag mit gesichertem anderem zuständigem Pfad. Wiederholung derselben eigenen Übernahme bleibt START und verwendet denselben Anspruch, nicht EXISTING. Neuer zwingender Prüfgrund wird bei Versionskonflikt am aktuellen Stand erneut eingeordnet und darf nicht verloren gehen. Veraltete Mitarbeiterentscheidung dagegen ohne Übernahme neuer Erkenntnisse ablehnen. Unklare Zuordnung, nur reservierter aber noch nicht bestätigter anderer Call oder fehlender lebender Nachfolgepfad: technische Klärung/Retry/Incident, kein fachlicher Endausgang. Anspruch, Engine-Aktivierung und Wiederaufnahme zuverlässig koordinieren; gespeicherte Reservierung ist kein Beweis einer laufenden Aufgabe. staffEntryContextRef mit Übernahmebezug bereitstellen; bestehende Eintrittsarten REVIEW, direkte Bearbeitung und Wiedervorlage erhalten.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.staff.claim" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>Mitarbeiterpruefung_und_Bearbeitung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Aktiven_Fall_bearbeiten_zu_Mitarbeiterfortsetzung_uebernehmen_SERVICE_FLOW</bpmn:incoming>
        <bpmn:outgoing>Mitarbeiterfortsetzung_uebernehmen_SERVICE_zu_Wer_fuehrt_weiter_XOR_FLOW</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Aktiven_Fall_bearbeiten_zu_Mitarbeiterfortsetzung_uebernehmen_SERVICE_FLOW" sourceRef="Aktiven_Fall_bearbeiten_verzweigen_XOR" targetRef="Mitarbeiterfortsetzung_uebernehmen_SERVICE">
        <bpmn:categoryValueRef>Mitarbeiterpruefung_und_Bearbeitung_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:exclusiveGateway id="Wer_fuehrt_weiter_XOR" name="Wer fuehrt weiter?">
        <bpmn:documentation>Ausgang staffContinuationOutcome aus bestätigter Übernahme prüfen: START, EXISTING oder SUPERSEDED. Unbekannte/fehlende Werte sind technische Fehler, kein Default-Endpfad. Gateway-Bedingungen noch nicht ausführbar gebunden.</bpmn:documentation>
        <bpmn:categoryValueRef>Mitarbeiterpruefung_und_Bearbeitung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Mitarbeiterfortsetzung_uebernehmen_SERVICE_zu_Wer_fuehrt_weiter_XOR_FLOW</bpmn:incoming>
        <bpmn:outgoing>Wer_fuehrt_weiter_START_neuer_Aufruf_zu_Mitarbeiterpruefung_und_Bearbeitung_CALL_FLOW</bpmn:outgoing>
        <bpmn:outgoing>Wer_fuehrt_weiter_EXISTING_bereits_aktiv_zu_Bestehende_Bearbeitung_ergaenzen_SERVICE_FLOW</bpmn:outgoing>
        <bpmn:outgoing>Wer_fuehrt_weiter_SUPERSEDED_ueberholt_zu_Ueberholte_Fortsetzung_abgleichen_SERVICE_FLOW</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Bestehende_Bearbeitung_ergaenzen_SERVICE" name="Bestehende Bearbeitung ergaenzen">
        <bpmn:documentation>Vorhandenen aktuellen Staff-Call und gegebenenfalls dieselbe Prüfaufgabe anhand Engine-/Dienstzuordnung verifizieren. Neuer Prüfgrund wird nachvollziehbar und idempotent der aktuellen Bearbeitung zugestellt. Bei bestehender Prüfung dieselbe Aufgabe ergänzen; bei anderer Mitarbeiterphase vorhandenen Prüfbedarfspfad nutzen, keinen zweiten Staff-Call starten. Veraltete Mitarbeiterentscheidung nicht neu ausführen. Erst bestätigte Übernahme beziehungsweise dauerhafte nachholbare Zuständigkeit mit weiterhin lebendem Ausführungspfad erlaubt Ende dieser redundanten Fortsetzung. Bei Zielwechsel erneut einordnen; keine Meldung verlieren und keinen alten Call reaktivieren.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.staff.merge-continuation" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>Mitarbeiterpruefung_und_Bearbeitung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Wer_fuehrt_weiter_EXISTING_bereits_aktiv_zu_Bestehende_Bearbeitung_ergaenzen_SERVICE_FLOW</bpmn:incoming>
        <bpmn:outgoing>Bestehende_Bearbeitung_ergaenzen_zu_Nur_redundante_Fortsetzung_beendet_FLOW</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Ueberholte_Fortsetzung_abgleichen_SERVICE" name="Ueberholte Fortsetzung abgleichen">
        <bpmn:documentation>Auftrag ist bereits erledigt oder anderer aktueller Pfad zuständig. Noch relevanten neuen Prüfgrund dauerhaft an aktuelle Bearbeitung übergeben, bei bereits abgeschlossenem Fall nur interner Hinweis ohne Wiedereröffnung. Alten Mitarbeiterentscheid nicht erneut anwenden. Ende nur wenn ein anderer zuständiger Ausführungspfad in ActiveCase nachweislich weiterläuft; niemals den letzten aktiven Hauptpfad wegen eines vermeintlichen Duplikats beenden. Bereits wirksamer Abschluss verwendet den bestehenden geschützten Abschluss-/Prozessbeendigungsvertrag, nicht dieses normale Endereignis. Fehlender/unklarer Eigentümer bleibt technische Klärung/Retry/Incident und verliert den Auftrag nicht.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow.staff.reconcile-continuation" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>Mitarbeiterpruefung_und_Bearbeitung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Wer_fuehrt_weiter_SUPERSEDED_ueberholt_zu_Ueberholte_Fortsetzung_abgleichen_SERVICE_FLOW</bpmn:incoming>
        <bpmn:outgoing>Ueberholte_Fortsetzung_abgleichen_zu_Nur_redundante_Fortsetzung_beendet_FLOW</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Nur_redundante_Fortsetzung_beendet_Aktiven_Fall_bearbeiten_END" name="Nur redundante&#10;Fortsetzung beendet">
        <bpmn:documentation>Normales Endereignis, kein terminate. Kein Fallabschluss, keine Beendigung der zuständigen Bearbeitung. Erreichbar nur nach Bestätigung, dass ein anderer aktueller Ausführungspfad in ActiveCase weiterläuft. Das blosse Vorhandensein einer Datenbankreferenz genügt nicht. Technischer Schutz ist noch nicht implementiert.</bpmn:documentation>
        <bpmn:categoryValueRef>Mitarbeiterpruefung_und_Bearbeitung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Bestehende_Bearbeitung_ergaenzen_zu_Nur_redundante_Fortsetzung_beendet_FLOW</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="Nur_redundante_Fortsetzung_beendet_Aktiven_Fall_bearbeiten_2_END" name="Nur redundante&#10;Fortsetzung beendet">
        <bpmn:documentation>Normales Endereignis, kein terminate. Kein Fallabschluss, keine Beendigung der zuständigen Bearbeitung. Erreichbar nur nach Bestätigung, dass ein anderer aktueller Ausführungspfad in ActiveCase weiterläuft. Das blosse Vorhandensein einer Datenbankreferenz genügt nicht. Technischer Schutz ist noch nicht implementiert.</bpmn:documentation>
        <bpmn:categoryValueRef>Mitarbeiterpruefung_und_Bearbeitung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Ueberholte_Fortsetzung_abgleichen_zu_Nur_redundante_Fortsetzung_beendet_FLOW</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Mitarbeiterfortsetzung_uebernehmen_SERVICE_zu_Wer_fuehrt_weiter_XOR_FLOW" name="" sourceRef="Mitarbeiterfortsetzung_uebernehmen_SERVICE" targetRef="Wer_fuehrt_weiter_XOR">
        <bpmn:categoryValueRef>Mitarbeiterpruefung_und_Bearbeitung_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Wer_fuehrt_weiter_START_neuer_Aufruf_zu_Mitarbeiterpruefung_und_Bearbeitung_CALL_FLOW" name="START: neuer Aufruf" sourceRef="Wer_fuehrt_weiter_XOR" targetRef="Mitarbeiterpruefung_und_Bearbeitung_CALL">
        <bpmn:categoryValueRef>Mitarbeiterpruefung_und_Bearbeitung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffContinuationOutcome = "START"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Wer_fuehrt_weiter_EXISTING_bereits_aktiv_zu_Bestehende_Bearbeitung_ergaenzen_SERVICE_FLOW" name="EXISTING: bereits aktiv" sourceRef="Wer_fuehrt_weiter_XOR" targetRef="Bestehende_Bearbeitung_ergaenzen_SERVICE">
        <bpmn:categoryValueRef>Mitarbeiterpruefung_und_Bearbeitung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffContinuationOutcome = "EXISTING"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Wer_fuehrt_weiter_SUPERSEDED_ueberholt_zu_Ueberholte_Fortsetzung_abgleichen_SERVICE_FLOW" name="SUPERSEDED: ueberholt" sourceRef="Wer_fuehrt_weiter_XOR" targetRef="Ueberholte_Fortsetzung_abgleichen_SERVICE">
        <bpmn:categoryValueRef>Mitarbeiterpruefung_und_Bearbeitung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffContinuationOutcome = "SUPERSEDED"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Bestehende_Bearbeitung_ergaenzen_zu_Nur_redundante_Fortsetzung_beendet_FLOW" name="" sourceRef="Bestehende_Bearbeitung_ergaenzen_SERVICE" targetRef="Nur_redundante_Fortsetzung_beendet_Aktiven_Fall_bearbeiten_END">
        <bpmn:categoryValueRef>Mitarbeiterpruefung_und_Bearbeitung_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Ueberholte_Fortsetzung_abgleichen_zu_Nur_redundante_Fortsetzung_beendet_FLOW" name="" sourceRef="Ueberholte_Fortsetzung_abgleichen_SERVICE" targetRef="Nur_redundante_Fortsetzung_beendet_Aktiven_Fall_bearbeiten_2_END">
        <bpmn:categoryValueRef>Mitarbeiterpruefung_und_Bearbeitung_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:intermediateCatchEvent id="FORTSETZEN_CATCH">
        <bpmn:outgoing>FORTSETZEN_CATCH_zu_Aktiven_Fall_bearbeiten_verzweigen_FLOW</bpmn:outgoing>
        <bpmn:linkEventDefinition id="FORTSETZEN_CATCH_LINK_DEF" name="FORTSETZEN" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="FORTSETZEN_CATCH_zu_Aktiven_Fall_bearbeiten_verzweigen_FLOW" sourceRef="FORTSETZEN_CATCH" targetRef="Aktiven_Fall_bearbeiten_verzweigen_XOR" />
      <bpmn:intermediateThrowEvent id="Mitarbeiterbearbeitung_THROW" name="Mitarbeiterbearbeitung">
        <bpmn:documentation>Prüfung / Bearbeitung / Wiedervorlage</bpmn:documentation>
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Naechste_Fallphase_XOR_zu_Mitarbeiterbearbeitung_THROW_FLOW</bpmn:incoming>
        <bpmn:linkEventDefinition id="Mitarbeiterbearbeitung_THROW_LINK_DEF" name="FORTSETZEN" />
      </bpmn:intermediateThrowEvent>
      <bpmn:intermediateThrowEvent id="Aktuellen_Fallstand_erneut_pruefen_THROW" name="Aktuellen Fallstand erneut pruefen">
        <bpmn:documentation>Prüfung / Bearbeitung / Wiedervorlage</bpmn:documentation>
        <bpmn:incoming>Mitarbeiterentscheidung_veraltet_BOUNDARY_Aktuellen_Fallstand_erneut_pruefen_zu_Aktuellen_Fallstand_erneut_pruefen_FLOW</bpmn:incoming>
        <bpmn:linkEventDefinition id="Aktuellen_Fallstand_erneut_pruefen_THROW_LINK_DEF" name="FORTSETZEN" />
      </bpmn:intermediateThrowEvent>
      <bpmn:intermediateThrowEvent id="Pruefung_Bearbeitung_Wiedervorlage_Aktiven_Fall_bearbeiten_THROW" name="Pruefung / Bearbeitung / Wiedervorlage">
        <bpmn:documentation>Prüfung / Bearbeitung / Wiedervorlage</bpmn:documentation>
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Analysefehler_und_Pruefkontext_zu_Pruefung_Bearbeitung_Wiedervorlage_Aktiven_FLOW</bpmn:incoming>
        <bpmn:linkEventDefinition id="Pruefung_Bearbeitung_Wiedervorlage_Aktiven_Fall_bearbeiten_THROW_LINK_DEF" name="FORTSETZEN" />
      </bpmn:intermediateThrowEvent>
      <bpmn:intermediateThrowEvent id="REVIEW_THROW" name="REVIEW">
        <bpmn:documentation>Prüfung / Bearbeitung / Wiedervorlage</bpmn:documentation>
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Fortsetzung_Aktiven_Fall_REVIEW_zu_REVIEW_THROW_FLOW</bpmn:incoming>
        <bpmn:linkEventDefinition id="REVIEW_THROW_LINK_DEF" name="FORTSETZEN" />
      </bpmn:intermediateThrowEvent>
      <bpmn:intermediateThrowEvent id="Pruefung_Bearbeitung_Wiedervorlage_Aktiven_Fall_bearbeiten_2_THROW" name="Pruefung / Bearbeitung / Wiedervorlage">
        <bpmn:documentation>Prüfung / Bearbeitung / Wiedervorlage</bpmn:documentation>
        <bpmn:categoryValueRef>Fallstart_und_Wiedereroeffnung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Wiedereroeffnung_pruefen_und_zu_Pruefung_Bearbeitung_Wiedervorlage_Aktiven_FLOW</bpmn:incoming>
        <bpmn:linkEventDefinition id="Pruefung_Bearbeitung_Wiedervorlage_Aktiven_Fall_bearbeiten_2_THROW_LINK_DEF" name="FORTSETZEN" />
      </bpmn:intermediateThrowEvent>
      <bpmn:endEvent id="Aktive_Bearbeitung_beendet_Aktiven_Fall_bearbeiten_2_END" name="Aktive Bearbeitung beendet">
        <bpmn:documentation>Erst nach erfolgreichem Close-Commit. Terminiert nur ActiveCase samt laufenden Ereignis-Teilprozessen und Empfang; der äussere Prozess endet danach ohne Abschlussmail. Kein fachlicher Abschluss allein durch ein technisches Endereignis.</bpmn:documentation>
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Fortsetzung_Aktiven_Fall_CLOSED_zu_Aktive_Bearbeitung_beendet_Aktiven_FLOW</bpmn:incoming>
        <bpmn:terminateEventDefinition id="Aktive_Bearbeitung_beendet_Aktiven_Fall_bearbeiten_2_END_TERMINATE_DEF" />
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="Fortsetzung_Aktiven_Fall_bearbeiten_2_XOR" name="Fortsetzung">
        <bpmn:incoming>Mitarbeiterpruefung_und_Bearbeitung_zu_Fortsetzung_Aktiven_Fall_bearbeiten_FLOW</bpmn:incoming>
        <bpmn:outgoing>Fortsetzung_Aktiven_Fall_Abschluss_bestaetigt_zu_Mitarbeiterabschluss_pruefen_und_speichern_FLOW</bpmn:outgoing>
        <bpmn:outgoing>Fortsetzung_Aktiven_Fall_Rueckfrage_veroeffentlicht_zu_Auf_ausgewertete_Mieterantwort_warten_FLOW</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Fortsetzung_Aktiven_Fall_Abschluss_bestaetigt_zu_Mitarbeiterabschluss_pruefen_und_speichern_FLOW" name="Abschluss bestaetigt" sourceRef="Fortsetzung_Aktiven_Fall_bearbeiten_2_XOR" targetRef="Mitarbeiterabschluss_pruefen_und_speichern_zusammenfuehren_XOR">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffOutcome = "CLOSE"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:intermediateThrowEvent id="Fortsetzung_pruefen_Aktiven_Fall_bearbeiten_2_THROW" name="Fortsetzung pruefen">
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Bestaetigte_Abloesung_BOUNDARY_zu_Fortsetzung_pruefen_Aktiven_Fall_FLOW</bpmn:incoming>
        <bpmn:linkEventDefinition id="Fortsetzung_pruefen_Aktiven_Fall_bearbeiten_2_THROW_LINK_DEF" name="REPLY_CONTINUATION" />
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="Uebergabe_abgeloest_BOUNDARY_zu_Fortsetzung_pruefen_Aktiven_Fall_FLOW" sourceRef="Uebergabe_abgeloest_BOUNDARY" targetRef="Fortsetzung_pruefen_Aktiven_Fall_bearbeiten_THROW">
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:group id="Fallstart_und_Wiedereroeffnung_GROUP" categoryValueRef="Fallstart_und_Wiedereroeffnung_CATEGORY_VALUE" />
      <bpmn:group id="LLM_Abklaerung_und_Systementscheid_GROUP" categoryValueRef="LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE" />
      <bpmn:group id="Mieterwartephase_und_Fortsetzung_GROUP" categoryValueRef="Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE" />
      <bpmn:group id="Mitarbeiterpruefung_und_Bearbeitung_GROUP" categoryValueRef="Mitarbeiterpruefung_und_Bearbeitung_CATEGORY_VALUE" />
      <bpmn:group id="Fallabschluss_GROUP" categoryValueRef="Fallabschluss_CATEGORY_VALUE" />
      <bpmn:textAnnotation id="Der_Hauptpfad_zeigt_die_aktuelle_NOTE">
        <bpmn:text>Der Hauptpfad zeigt die aktuelle Fallphase. Der Aktionsrundlauf
empfängt weitere Aktionen, während diese Phase weiterläuft.
Beim Abschluss endet der aktive Fallbereich mit seinen Nebenaktionen.</bpmn:text>
      </bpmn:textAnnotation>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Durchlauf_beendet_zusammenfuehren_XOR" gatewayDirection="Converging">
      <bpmn:categoryValueRef>Aktive_Fallfuehrung_CATEGORY_VALUE</bpmn:categoryValueRef>
      <bpmn:incoming>Aktiven_Fall_bearbeiten_zu_Durchlauf_beendet_zusammenfuehren_XOR_FLOW</bpmn:incoming>
      <bpmn:incoming>Mitarbeiterabschluss_aus_Abklaerung_zu_Durchlauf_beendet_zusammenfuehren_XOR_FLOW</bpmn:incoming>
      <bpmn:outgoing>Durchlauf_beendet_zusammenfuehren_zu_Durchlauf_beendet_END_FLOW</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Durchlauf_beendet_END" name="Durchlauf beendet">
      <bpmn:documentation>
Technisches Ende: nach regulärem Fallabschluss oder abgelehntem Wiedereröffnungsstart. Dieses Ereignis selbst ändert keinen Status und verschickt keine Nachricht.</bpmn:documentation>
      <bpmn:incoming>Durchlauf_beendet_zusammenfuehren_zu_Durchlauf_beendet_END_FLOW</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Durchlauf_beendet_zusammenfuehren_zu_Durchlauf_beendet_END_FLOW" sourceRef="Durchlauf_beendet_zusammenfuehren_XOR" targetRef="Durchlauf_beendet_END" />
    <bpmn:sequenceFlow id="Aktiven_Fall_bearbeiten_zu_Durchlauf_beendet_zusammenfuehren_XOR_FLOW" sourceRef="Aktiven_Fall_bearbeiten_SUBPROCESS" targetRef="Durchlauf_beendet_zusammenfuehren_XOR">
      <bpmn:categoryValueRef>Aktive_Fallfuehrung_CATEGORY_VALUE</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:startEvent id="Startauftrag_uebernommen_START" name="Startauftrag uebernommen">
      <bpmn:categoryValueRef>Prozessstart_CATEGORY_VALUE</bpmn:categoryValueRef>
      <bpmn:outgoing>Startauftrag_uebernommen_START_zu_Prozessschluessel_bereitstellen_SERVICE_FLOW</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Prozessschluessel_bereitstellen_SERVICE" name="Prozessschluessel&#10;bereitstellen">
      <bpmn:documentation>Technische Vorstufe des Entwurfs: processInstanceKey aus den Jobmetadaten als String im Prozess bereitstellen, bevor der Empfangsbereich aktiviert wird. Noch keine führende Fallzuordnung, kein Erledigen des Startauftrags und keine fachliche Aktivierung. Derselbe Schlüssel wird anschliessend von Register in der bestehenden Zuordnungstransaktion gespeichert. Implementierung und Präzisierung gegenüber dem ersten Zuordnungsjob in ADR-002/SS-003 sind noch offen.
Startart und Auftragsreferenz aus einem serverseitig autorisierten Startauftrag prüfen. INITIAL oder REOPEN sind keine frei wählbaren Clientwerte. Ungültige Aufträge stoppen vor fachlicher Wirkung. Prozessschlüsselbereitstellung allein ersetzt niemals die führende Zuordnung.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="propertyflow-prepare-process-key" />
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>Prozessstart_CATEGORY_VALUE</bpmn:categoryValueRef>
      <bpmn:incoming>Startauftrag_uebernommen_START_zu_Prozessschluessel_bereitstellen_SERVICE_FLOW</bpmn:incoming>
      <bpmn:outgoing>Prozessschluessel_bereitstellen_SERVICE_zu_Aktiven_Fall_bearbeiten_SUBPROCESS_FLOW</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Startauftrag_uebernommen_START_zu_Prozessschluessel_bereitstellen_SERVICE_FLOW" sourceRef="Startauftrag_uebernommen_START" targetRef="Prozessschluessel_bereitstellen_SERVICE">
      <bpmn:categoryValueRef>Prozessstart_CATEGORY_VALUE</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Prozessschluessel_bereitstellen_SERVICE_zu_Aktiven_Fall_bearbeiten_SUBPROCESS_FLOW" sourceRef="Prozessschluessel_bereitstellen_SERVICE" targetRef="Aktiven_Fall_bearbeiten_SUBPROCESS" />
    <bpmn:boundaryEvent id="Mitarbeiterabschluss_aus_Abklaerung_gespeichert_BOUNDARY" name="Mitarbeiterabschluss&#10;aus Abklaerung gespeichert" attachedToRef="Aktiven_Fall_bearbeiten_SUBPROCESS">
      <bpmn:documentation>Nur Erfolg nach geprüftem und gespeichertem Mitarbeiterabschluss aus In Abklärung. Unterbricht gesamten ActiveCase samt untergeordneten Aktivitäten und Nebenaktionen; danach Durchlaufende. Datenbanksperre gegen verspätete Worker gilt bereits seit Abschlusscommit, nicht erst seit BPMN-Unterbrechung. Bereits gestartete eigenständige Mailprozesse bleiben erhalten.</bpmn:documentation>
      <bpmn:categoryValueRef>Aktive_Fallfuehrung_CATEGORY_VALUE</bpmn:categoryValueRef>
      <bpmn:outgoing>Mitarbeiterabschluss_aus_Abklaerung_zu_Durchlauf_beendet_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="Mitarbeiterabschluss_aus_Abklaerung_gespeichert_BOUNDARY_ESCALATION_DEF" escalationRef="Mitarbeiterabschluss_aus_Abklaerung_gespeichert_ESCALATION" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Mitarbeiterabschluss_aus_Abklaerung_zu_Durchlauf_beendet_zusammenfuehren_XOR_FLOW" sourceRef="Mitarbeiterabschluss_aus_Abklaerung_gespeichert_BOUNDARY" targetRef="Durchlauf_beendet_zusammenfuehren_XOR">
      <bpmn:categoryValueRef>Aktive_Fallfuehrung_CATEGORY_VALUE</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:textAnnotation id="Ein_Startauftrag_eroeffnet_einen_Durchlauf_NOTE">
      <bpmn:text>Ein Startauftrag eröffnet einen Durchlauf für einen Fall.
Im Teilprozess «Aktiven Fall bearbeiten» laufen Abklärung,
Wartephasen und Aktionsrundlauf. Nach dem gespeicherten
Fallabschluss endet der aktive Bereich.</bpmn:text>
    </bpmn:textAnnotation>
