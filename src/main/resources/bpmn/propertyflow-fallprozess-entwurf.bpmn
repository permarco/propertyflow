<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Fall_bearbeiten_DEFINITIONS" targetNamespace="https://propertyflow.local/bpmn/draft" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:escalation id="Mitarbeiterabschluss_aus_Abklaerung_gespeichert_ESCALATION" name="Mitarbeiterabschluss aus Abklärung gespeichert" escalationCode="STAFF_CLARIFICATION_CLOSURE_COMMITTED" />
  <bpmn:error id="Wiedereroeffnung_abgelehnt_ERROR" name="Wiedereröffnung abgelehnt" errorCode="REOPEN_REJECTED" />
  <bpmn:error id="LLM_Nachricht_inhaltlich_unzulaessig_ERROR" name="LLM-Nachricht inhaltlich unzulässig" errorCode="CLOSURE_MESSAGE_INVALID" />
  <bpmn:error id="Automatischer_Abschluss_veraltet_ERROR" name="Automatischer Abschluss veraltet" errorCode="AUTO_CLOSURE_STALE" />
  <bpmn:error id="KI_Analyse_fehlgeschlagen_ERROR" name="KI-Analyse fehlgeschlagen" errorCode="TRIAGE_ANALYSIS_FAILED">
    <bpmn:documentation>Fachliche Fehlerreaktion des Entwurfs. Der spätere Worker meldet eine festgestellte fehlgeschlagene Analyse oder ungültige Modellausgabe ausdrücklich als diesen BPMN-Fehler. Ein technischer Jobfehler allein aktiviert den Fehlerpfad nicht. Die Mitarbeiterprüfung wartet nicht auf das Ausschöpfen automatischer Wiederholungen.</bpmn:documentation>
  </bpmn:error>
  <bpmn:error id="Mitarbeiterentscheidung_veraltet_ERROR" name="Mitarbeiterentscheidung veraltet" errorCode="STAFF_CLOSURE_STALE">
    <bpmn:documentation>Fachlicher Konflikt des bestätigten Mitarbeiterabschlusses gemäss FALL-07 / FALL-AK-22. Der Dienst hat vor erfolgreicher Abschlussspeicherung festgestellt, dass die bestätigte Entscheidungsgrundlage nicht mehr aktuell ist. Der spätere Worker meldet den Fehler ausdrücklich; ein technischer Speicherfehler oder bloss laufende KI genügt nicht. Ein bereits erfolgreich gespeicherter identischer Abschluss wird idempotent bestätigt und meldet diesen Fehler nicht. Kein pauschaler Fehlerpfad für doppelte oder überholte automatische Empfehlungen.</bpmn:documentation>
  </bpmn:error>
  <bpmn:error id="Veroeffentlichungsgrundlage_ueberholt_ERROR" name="Veröffentlichungsgrundlage überholt" errorCode="PUBLICATION_BASIS_STALE">
    <bpmn:documentation>Zeile 2, fachlicher Platzhalter: Dienst erkennt bei synchronisierter Prüfung vor Veröffentlichung eine neue relevante gespeicherte Mieternachricht, die die Grundlage überholt. Keine Nachricht gespeichert, kein neuer Antwortbedarf und kein zugehöriger Mailauftrag. Technische Speicherfehler und Wiederholung einer bereits erfolgreichen Veröffentlichung sind keine solchen Konflikte. Nicht direkt durch Nachrichteneingang ausgelöst; keine ausführbare Implementierung.</bpmn:documentation>
  </bpmn:error>
  <bpmn:error id="Analysegrundlage_ueberholt_ERROR" name="Analysegrundlage überholt" errorCode="ANALYSIS_BASIS_STALE">
    <bpmn:documentation>Fachlicher Platzhalter für Zeilen 1 und 3: Die Auswertung enthält neue relevante gespeicherte Mieternachrichten noch nicht. In Validate führt der Konflikt zur aktuellen Analysegrundlage; in RValidate zur aktuellen Antwortauswertung. Kein technischer Jobfehler und kein Analysefehler. Meldung durch den späteren Prüfdienst, nicht automatisch durch blossen Nachrichteneingang. Keine zweite unabhängige Verarbeitung; aktuelle Mitarbeiterentscheidung und Abschluss schützen. Keine Ausführungsimplementierung.</bpmn:documentation>
  </bpmn:error>
  <bpmn:message id="PropertyFlow_Fallaktion_MESSAGE" name="PropertyFlow-Fallaktion">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= processInstanceKey" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Unbekannte_Fallaktion_ERROR" name="Unbekannte Fallaktion" errorCode="UNKNOWN_CASE_ACTION" />
  <bpmn:category id="Prozessstart_CATEGORY">
    <bpmn:categoryValue id="Prozessstart_CATEGORY_VALUE" value="Prozessstart" />
  </bpmn:category>
  <bpmn:category id="Aktive_Fallfuehrung_CATEGORY">
    <bpmn:categoryValue id="Aktive_Fallfuehrung_CATEGORY_VALUE" value="Aktive Fallfuehrung" />
  </bpmn:category>
  <bpmn:category id="Fallstart_und_Wiedereroeffnung_CATEGORY">
    <bpmn:categoryValue id="Fallstart_und_Wiedereroeffnung_CATEGORY_VALUE" value="Fallstart und Wiedereroeffnung" />
  </bpmn:category>
  <bpmn:category id="LLM_Abklaerung_und_Systementscheid_CATEGORY">
    <bpmn:categoryValue id="LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE" value="LLM-Abklaerung und Systementscheid" />
  </bpmn:category>
  <bpmn:category id="Mieterwartephase_und_Fortsetzung_CATEGORY">
    <bpmn:categoryValue id="Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE" value="Mieterwartephase und Fortsetzung" />
  </bpmn:category>
  <bpmn:category id="Mitarbeiterpruefung_und_Bearbeitung_CATEGORY">
    <bpmn:categoryValue id="Mitarbeiterpruefung_und_Bearbeitung_CATEGORY_VALUE" value="Mitarbeiterpruefung und Bearbeitung" />
  </bpmn:category>
  <bpmn:category id="Fallabschluss_CATEGORY">
    <bpmn:categoryValue id="Fallabschluss_CATEGORY_VALUE" value="Fallabschluss" />
  </bpmn:category>
  <bpmn:category id="Vier_Wege_fuer_eingehende_Fallaktionen_CATEGORY">
    <bpmn:categoryValue id="Vier_Wege_fuer_eingehende_Fallaktionen_CATEGORY_VALUE" value="Vier Wege fuer eingehende Fallaktionen" />
  </bpmn:category>
  <bpmn:category id="Automatik_vorbereiten_CATEGORY">
    <bpmn:categoryValue id="Automatik_vorbereiten_CATEGORY_VALUE" value="Automatik vorbereiten" />
  </bpmn:category>
  <bpmn:category id="Grund_der_Abloesung_pruefen_und_uebergeben_CATEGORY">
    <bpmn:categoryValue id="Grund_der_Abloesung_pruefen_und_uebergeben_CATEGORY_VALUE" value="Grund der Abloesung pruefen und uebergeben" />
  </bpmn:category>
  <bpmn:category id="Fuenf_Mitarbeiteraktionen_CATEGORY">
    <bpmn:categoryValue id="Fuenf_Mitarbeiteraktionen_CATEGORY_VALUE" value="Fuenf Mitarbeiteraktionen" />
  </bpmn:category>
  <bpmn:category id="Abschluss_aus_zwei_Fallphasen_CATEGORY">
    <bpmn:categoryValue id="Abschluss_aus_zwei_Fallphasen_CATEGORY_VALUE" value="Abschluss aus zwei Fallphasen" />
  </bpmn:category>
  <bpmn:process id="Fall_bearbeiten_PROCESS" name="Fall bearbeiten" isExecutable="true">
    <bpmn:documentation>Fachentwurf 0.13, nicht ausführbar. Individuelle LLM-Nachricht im AutoAnswer-Worker erzeugen, prüfen, speichern und Versand beauftragen; danach Close. Kein Vorlagenkatalog, keine zusätzliche Abschlussmail. Mitarbeiterabschluss ohne Nachricht. Menschliche Priorität, Aktualität, Rückfragen, Wiedervorlage und bisherige Konfliktrückwege bleiben. Technische Fehler: Job-Retries/Incidents. Start-/Kindinstanz-Verträge weiterhin vor Ausführung konkretisieren; keine Backend-Implementierung.
Fachentwurf 0.15: Wiedereröffnung startet eine neue Instanz für denselben Fall; direkter Mitarbeiterpfad gemäss FALL-07. Keine Backend-Implementierung.</bpmn:documentation>
    <bpmn:subProcess id="Aktiven_Fall_bearbeiten_SUBPROCESS" name="Aktiven Fall bearbeiten">
      <bpmn:documentation>Empfangsbereich der führenden Fallprozessinstanz. Der Prozessschlüssel ist beim Eintritt bereits als Korrelationswert verfügbar. Der einzige Empfänger für Mieternachrichten bleibt über Analyse, Rückfrage, Mitarbeiterprüfung und Wiedervorlage hinweg aktiv. Register bestätigt die führende Zuordnung erst innerhalb dieses Bereichs. Das terminierende Ende wird ausschliesslich nach erfolgreichem fachlichem Abschluss erreicht und beendet nur diesen Bereich samt seinen laufenden Nachrichtenauswertungen. Späte externe Ergebnisse bleiben zusätzlich durch fachliche Versions- und Statusprüfungen gesperrt.
Die Calls Reply und Staff sowie verschachtelte Calls gehören zum aktiven Ausführungsbaum. Fachlichen Abschluss zuerst speichern, dann aktiven Bereich samt untergeordneten Ausführungen beenden. Späte Worker bleiben durch serverseitige Prüfung gesperrt. Call-Abbruch darf keine normale Abschlussentscheidung liefern.
Wiedereröffnung: Der Empfang wird ebenfalls vor der bestätigten neuen Zuordnung vorbereitet. ReopenRejectedEnd beendet ausschliesslich einen abgelehnten neuen Start ohne fachlichen Abschluss oder Statusänderung. Der bisherige Abschluss bleibt dann bestehen.</bpmn:documentation>
      <bpmn:categoryValueRef>Aktive_Fallfuehrung_CATEGORY_VALUE</bpmn:categoryValueRef>
      <bpmn:incoming>Prozessschluessel_bereitstellen_SERVICE_zu_Aktiven_Fall_bearbeiten_SUBPROCESS_FLOW</bpmn:incoming>
      <bpmn:outgoing>Aktiven_Fall_bearbeiten_zu_Durchlauf_beendet_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
      <bpmn:laneSet id="Aktiven_Fall_bearbeiten_LANESET">
        <bpmn:lane id="Aktionsempfang_LANE" name="Aktionsempfang">
          <bpmn:flowNodeRef>Aktionsrundlauf_SUBPROCESS</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Fallfuehrung_LANE" name="Fallfuehrung">
          <bpmn:flowNodeRef>Auf_ausgewertete_Mieterantwort_warten_zusammenfuehren_XOR</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Auf_ausgewertete_Mieterantwort_warten_CALL</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Fortsetzung_bestimmen_zusammenfuehren_XOR</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Mitarbeiterabschluss_pruefen_und_speichern_zusammenfuehren_XOR</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Mitarbeiterabschluss_pruefen_und_speichern_SERVICE</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Mitarbeiterpruefung_und_Bearbeitung_CALL</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Mitarbeiterabschluss_pruefen_und_speichern_verzweigen_XOR</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Bestehende_Bearbeitung_ergaenzen_SERVICE</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Ueberholte_Fortsetzung_abgleichen_SERVICE</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Erste_Abklaerung_vorbereiten_SERVICE</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Automatische_Abklaerung_zusammenfuehren_XOR</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Automatische_Abklaerung_CALL</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Automatik_Ergebnis_uebernehmen_SERVICE</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Analysefehler_und_Pruefkontext_sichern_SERVICE</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Aktiven_Fall_bearbeiten_verzweigen_XOR</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Mitarbeiterfortsetzung_uebernehmen_SERVICE</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>FORTSETZEN_CATCH</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Wiedereroeffnung_pruefen_und_zuordnen_SERVICE</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Fuehrenden_Prozess_zuordnen_SERVICE</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Fortsetzung_bestimmen_SUBPROCESS</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Fortsetzung_pruefen_CATCH</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Naechste_Fallphase_XOR</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Automatik_fortsetzen_THROW</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Fall_abschliessen_THROW</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Fall_abschliessen_CATCH</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Aktive_Bearbeitung_beendet_Aktiven_Fall_bearbeiten_END</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Fortsetzung_Aktiven_Fall_bearbeiten_XOR</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Nur_redundante_Fortsetzung_beendet_Aktiven_Fall_bearbeiten_END</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Nur_redundante_Fortsetzung_beendet_Aktiven_Fall_bearbeiten_2_END</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Mitarbeiterbearbeitung_THROW</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Aktuellen_Fallstand_erneut_pruefen_THROW</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>REVIEW_THROW</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Aktive_Bearbeitung_beendet_Aktiven_Fall_bearbeiten_2_END</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Fortsetzung_Aktiven_Fall_bearbeiten_2_XOR</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Fortsetzung_pruefen_Aktiven_Fall_bearbeiten_THROW</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Automatik_fortsetzen_CATCH</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Wer_fuehrt_weiter_XOR</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Pruefung_Bearbeitung_Wiedervorlage_Aktiven_Fall_bearbeiten_THROW</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Fortsetzung_pruefen_Aktiven_Fall_bearbeiten_2_THROW</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Wartephase_abgeloest_BOUNDARY</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Mitarbeiterentscheidung_veraltet_BOUNDARY</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Fachlicher_Analysefehler_BOUNDARY</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Bestaetigte_Abloesung_BOUNDARY</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Uebergabe_abgeloest_BOUNDARY</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Empfangsbereich_aktiv_START</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Erstanlage_oder_Wiedereroeffnung_XOR</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Auftrag_nicht_mehr_gueltig_BOUNDARY</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Pruefung_Bearbeitung_Wiedervorlage_Aktiven_Fall_bearbeiten_2_THROW</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Start_abgelehnt_Keine_Fallaenderung_END</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:subProcess id="Aktionsrundlauf_SUBPROCESS" name="Aktionsrundlauf" triggeredByEvent="true">
        <bpmn:documentation>Solange der Fall aktiv ist, empfängt dieselbe Nachrichtensubskription jede weitere Fallaktion. Je Eingang entsteht ein eigener Durchlauf mit lokalen Variablen. Auch während einer LLM-Auswertung kann ein bestätigter Mitarbeiterauftrag eintreffen. Die vier sichtbaren Wege führen zu neun Aktionen. Jeder Zweig prüft den Auftrag in seinem bisherigen fachlichen Kontext. Die gestrichelte Verbindung im Diagramm zeigt den dauerhaft offenen Empfang.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="= null" target="actionType" />
            <zeebe:input source="= null" target="tenantMessageId" />
            <zeebe:input source="= null" target="clearAnswerCommandRef" />
            <zeebe:input source="= null" target="replyClosureCommandRef" />
            <zeebe:input source="= null" target="reviewSignalRef" />
            <zeebe:input source="= null" target="staffMessageCommandRef" />
            <zeebe:input source="= null" target="clarificationClosureCommandRef" />
            <zeebe:input source="= null" target="directFollowCommandRef" />
            <zeebe:input source="= null" target="staffTakeoverCommandRef" />
            <zeebe:input source="= null" target="caseDataCommandRef" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:startEvent id="Auf_Fallaktion_warten_START" name="Auf Fallaktion warten" isInterrupting="false">
          <bpmn:outgoing>Auf_Fallaktion_warten_zu_Welche_Fallaktion_XOR_FLOW</bpmn:outgoing>
          <bpmn:messageEventDefinition id="Auf_Fallaktion_warten_START_MESSAGE_DEF" messageRef="PropertyFlow_Fallaktion_MESSAGE" />
        </bpmn:startEvent>
        <bpmn:exclusiveGateway id="Welche_Fallaktion_XOR" name="Welche Fallaktion?" gatewayDirection="Diverging" default="Welche_Fallaktion_XOR_zu_Mitarbeiteraktion_ausfuehren_SUBPROCESS_FLOW">
          <bpmn:incoming>Auf_Fallaktion_warten_zu_Welche_Fallaktion_XOR_FLOW</bpmn:incoming>
          <bpmn:outgoing>Welche_Fallaktion_XOR_zu_Mieternachricht_mit_LLM_verarbeiten_FLOW</bpmn:outgoing>
          <bpmn:outgoing>Welche_Fallaktion_XOR_zu_Mitarbeiteraktion_ausfuehren_SUBPROCESS_FLOW</bpmn:outgoing>
          <bpmn:outgoing>Welche_Fallaktion_XOR_zu_Neuen_Pruefbedarf_bearbeiten_SUBPROCESS_FLOW</bpmn:outgoing>
          <bpmn:outgoing>Welche_Fallaktion_XOR_zu_Fall_abschliessen_SUBPROCESS_FLOW</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:subProcess id="Mieternachricht_mit_LLM_verarbeiten_SUBPROCESS" name="Mieternachricht mit LLM verarbeiten">
          <bpmn:documentation>Der gemeinsame Aktionsrundlauf startet diesen Schritt mit einer lokal gebundenen Nachrichten-ID. Die zentrale Verarbeitung prüft den gespeicherten Eingang und stellt die aktuelle LLM-Auswertung bereit. Der führende Pfad erhält Steuerinformationen über seine geprüften Schnittstellen.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:ioMapping>
              <zeebe:input source="= tenantMessageId" target="tenantMessageId" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:categoryValueRef>Vier_Wege_fuer_eingehende_Fallaktionen_CATEGORY_VALUE</bpmn:categoryValueRef>
          <bpmn:incoming>Welche_Fallaktion_XOR_zu_Mieternachricht_mit_LLM_verarbeiten_FLOW</bpmn:incoming>
          <bpmn:outgoing>Mieternachricht_mit_LLM_zu_Aktion_verarbeitet_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
          <bpmn:startEvent id="Mieternachricht_gespeichert_START" name="Mieternachricht gespeichert">
            <bpmn:outgoing>Mieternachricht_gespeichert_START_zu_Mieternachricht_verarbeiten_CALL_FLOW</bpmn:outgoing>
          </bpmn:startEvent>
          <bpmn:callActivity id="Mieternachricht_verarbeiten_CALL" name="Mieternachricht&#10;verarbeiten">
            <bpmn:documentation>Ruft mieternachricht-verarbeiten.bpmn je empfangener Nachricht auf. tenantMessageId muss lokal aus der korrelierten gespeicherten Nachricht übernommen werden, niemals in einer überschreibbaren Root-Variable. Keine Outputs; keine Antwort-, Status- oder Abschlussfreigabe durch Call-Ende. Empfangsbestätigung wartet nicht auf Verarbeitung. Interne Bereitstellung gemäss teilprozess-vertraege.md.</bpmn:documentation>
            <bpmn:extensionElements>
              <zeebe:calledElement processId="Mieternachricht_verarbeiten_PROCESS" propagateAllChildVariables="false" propagateAllParentVariables="false" bindingType="deployment" />
              <zeebe:ioMapping>
                <zeebe:input source="= caseId" target="caseId" />
                <zeebe:input source="= processInstanceKey" target="leadingProcessInstanceKey" />
                <zeebe:input source="= tenantMessageId" target="tenantMessageId" />
              </zeebe:ioMapping>
            </bpmn:extensionElements>
            <bpmn:incoming>Mieternachricht_gespeichert_START_zu_Mieternachricht_verarbeiten_CALL_FLOW</bpmn:incoming>
            <bpmn:outgoing>Mieternachricht_verarbeiten_CALL_zu_Dieser_Eingang_verarbeitet_END_FLOW</bpmn:outgoing>
          </bpmn:callActivity>
          <bpmn:endEvent id="Dieser_Eingang_verarbeitet_END" name="Dieser Eingang verarbeitet">
            <bpmn:incoming>Mieternachricht_verarbeiten_CALL_zu_Dieser_Eingang_verarbeitet_END_FLOW</bpmn:incoming>
          </bpmn:endEvent>
          <bpmn:sequenceFlow id="Mieternachricht_gespeichert_START_zu_Mieternachricht_verarbeiten_CALL_FLOW" sourceRef="Mieternachricht_gespeichert_START" targetRef="Mieternachricht_verarbeiten_CALL" />
          <bpmn:sequenceFlow id="Mieternachricht_verarbeiten_CALL_zu_Dieser_Eingang_verarbeitet_END_FLOW" sourceRef="Mieternachricht_verarbeiten_CALL" targetRef="Dieser_Eingang_verarbeitet_END" />
          <bpmn:textAnnotation id="Die_gespeicherte_Nachricht_geht_in_NOTE">
            <bpmn:text>Die gespeicherte Nachricht geht in die zentrale LLM-Auswertung.
Der Eingangsdurchlauf endet, sobald die Verarbeitung beendet ist.</bpmn:text>
          </bpmn:textAnnotation>
        </bpmn:subProcess>
        <bpmn:subProcess id="Neuen_Pruefbedarf_bearbeiten_SUBPROCESS" name="Neuen Pruefbedarf bearbeiten">
          <bpmn:documentation>
  Nicht unterbrechender interner Eingang für serverseitig festgestellten fachlichen Prüfbedarf. Keine neue öffentliche Schnittstelle und kein LLM-Auftrag. Nach beendetem ActiveCase existiert dieser Empfang nicht; nach Abschluss eintreffende Hinweise werden ausserhalb des beendeten Prozesses intern gespeichert, ohne Neustart.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:ioMapping>
              <zeebe:input source="= reviewSignalRef" target="reviewSignalRef" />
              <zeebe:input source="= null" target="reviewRoute" />
              <zeebe:input source="= null" target="reviewContinuationRef" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:categoryValueRef>Vier_Wege_fuer_eingehende_Fallaktionen_CATEGORY_VALUE</bpmn:categoryValueRef>
          <bpmn:incoming>Welche_Fallaktion_XOR_zu_Neuen_Pruefbedarf_bearbeiten_SUBPROCESS_FLOW</bpmn:incoming>
          <bpmn:outgoing>Neuen_Pruefbedarf_bearbeiten_zu_Aktion_verarbeitet_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
          <bpmn:startEvent id="Pruefbedarf_gemeldet_START" name="Pruefbedarf gemeldet">
            <bpmn:outgoing>Pruefbedarf_gemeldet_START_zu_Pruefgrund_und_Fallstand_pruefen_FLOW</bpmn:outgoing>
          </bpmn:startEvent>
          <bpmn:serviceTask id="Pruefgrund_und_Fallstand_pruefen_SERVICE" name="Pruefgrund und Fallstand pruefen">
            <bpmn:documentation>
  FALL-06: Vertrauenswürdige Quelle, Fall, führenden Durchlauf, fachlichen Grund und Erkenntnisversion prüfen. Blosser Retry/Incident ist kein fachlicher Grund. Gleicher bereits berücksichtigter Grund ohne neue Erkenntnis erzeugt keine Prüfung. Wiederholungen idempotent verarbeiten. Neue Gründe dauerhaft erfassen, Entscheidung gegen aktuellen Status und Aufruf prüfen. Bereits abgeschlossener Fall: nur interner Hinweis, keine Statusänderung oder Wiedereröffnung. Lokale Nebenaktionsvariablen; aktuelle Mitarbeiterentscheidung nicht zurücknehmen.
  0.30: Mit dauerhafter Bestätigung neuen zwingenden Prüfbedarfs alte automatische Wirkungsfreigaben sperren, bereits vor BPMN-Unterbrechung. Worker prüfen dies unmittelbar vor jeder Veröffentlichung, Statusänderung oder Abschluss. Gegen bereits wirksamen Abschluss und neuere Mitarbeiterentscheidung koordinieren; bereits veröffentlichte Nachrichten und Mailpflichten erhalten.</bpmn:documentation>
            <bpmn:extensionElements>
              <zeebe:taskDefinition type="propertyflow.review.check" />
            </bpmn:extensionElements>
            <bpmn:incoming>Pruefbedarf_gemeldet_START_zu_Pruefgrund_und_Fallstand_pruefen_FLOW</bpmn:incoming>
            <bpmn:outgoing>Pruefgrund_und_Fallstand_zu_Aktuelle_Situation_XOR_FLOW</bpmn:outgoing>
          </bpmn:serviceTask>
          <bpmn:exclusiveGateway id="Aktuelle_Situation_XOR" name="Aktuelle&#10;Situation">
            <bpmn:incoming>Pruefgrund_und_Fallstand_zu_Aktuelle_Situation_XOR_FLOW</bpmn:incoming>
            <bpmn:outgoing>Aktuelle_Situation_XOR_Pruefung_bereits_offen_zu_Offene_Pruefung_ergaenzen_SERVICE_FLOW</bpmn:outgoing>
            <bpmn:outgoing>Aktuelle_Situation_XOR_Neuer_Grund_im_Mieterwartepfad_zu_Pruefbedarf_im_Mieterwarten_melden_FLOW</bpmn:outgoing>
            <bpmn:outgoing>Aktuelle_Situation_XOR_Wiederholung_beruecksichtigt_abgeschlossen_zu_Keine_neue_Pruefung_aus_FLOW</bpmn:outgoing>
            <bpmn:outgoing>Aktuelle_Situation_XOR_Andere_aktive_Phase_zu_Pruefbedarf_an_aktuelle_Fallphase_FLOW</bpmn:outgoing>
          </bpmn:exclusiveGateway>
          <bpmn:serviceTask id="Offene_Pruefung_ergaenzen_SERVICE" name="Offene Pruefung ergaenzen">
            <bpmn:documentation>
  Aktuelle offene Mitarbeiterprüfung und ihren Kind-/Task-Bezug serverseitig prüfen. Dieselbe Aufgabe ergänzen, nicht abschliessen oder duplizieren. Keine erneute Prüfung aus identischen oder bereits berücksichtigten Erkenntnissen. Bei konkurrierendem Aufgabenwechsel aktuellen Stand neu prüfen, keine alte Aufgabe reaktivieren.</bpmn:documentation>
            <bpmn:extensionElements>
              <zeebe:taskDefinition type="propertyflow.review.merge" />
            </bpmn:extensionElements>
            <bpmn:incoming>Aktuelle_Situation_XOR_Pruefung_bereits_offen_zu_Offene_Pruefung_ergaenzen_SERVICE_FLOW</bpmn:incoming>
            <bpmn:outgoing>Offene_Pruefung_ergaenzen_zu_Nur_Nebenaktion_beendet_zusammenfuehren_FLOW</bpmn:outgoing>
          </bpmn:serviceTask>
          <bpmn:serviceTask id="Pruefbedarf_im_Mieterwarten_melden_SERVICE" name="Pruefbedarf im Mieterwarten melden">
            <bpmn:documentation>
  Nur für aktuellen Reply-Call bei Wartet auf Mieterantwort mit neuem fachlichem Prüfbedarf. Dauerhaften Prüfentscheid und aktuellen Call-Bezug zuverlässig bereitstellen. Markerbereitstellung und Unterbrechung gegen Call-Wechsel, Mitarbeiterabschluss, Aufhebung und neue Erkenntnisse koordinieren. Keine KI-Auswertung abwarten. Keine normalen Outputs vom abgebrochenen Call erwarten. Technische Realisierung bleibt offen.</bpmn:documentation>
            <bpmn:extensionElements>
              <zeebe:taskDefinition type="propertyflow.reply.wake-review" />
            </bpmn:extensionElements>
            <bpmn:incoming>Aktuelle_Situation_XOR_Neuer_Grund_im_Mieterwartepfad_zu_Pruefbedarf_im_Mieterwarten_melden_FLOW</bpmn:incoming>
            <bpmn:outgoing>Pruefbedarf_im_Mieterwarten_zu_Nur_Nebenaktion_beendet_zusammenfuehren_FLOW</bpmn:outgoing>
          </bpmn:serviceTask>
          <bpmn:endEvent id="Keine_neue_Pruefung_aus_dieser_Meldung_END" name="Keine neue Pruefung&#10;aus dieser Meldung">
            <bpmn:incoming>Aktuelle_Situation_XOR_Wiederholung_beruecksichtigt_abgeschlossen_zu_Keine_neue_Pruefung_aus_FLOW</bpmn:incoming>
          </bpmn:endEvent>
          <bpmn:exclusiveGateway id="Nur_Nebenaktion_beendet_zusammenfuehren_XOR" gatewayDirection="Converging">
            <bpmn:incoming>Offene_Pruefung_ergaenzen_zu_Nur_Nebenaktion_beendet_zusammenfuehren_FLOW</bpmn:incoming>
            <bpmn:incoming>Pruefbedarf_im_Mieterwarten_zu_Nur_Nebenaktion_beendet_zusammenfuehren_FLOW</bpmn:incoming>
            <bpmn:incoming>Pruefbedarf_an_aktuelle_zu_Nur_Nebenaktion_beendet_zusammenfuehren_FLOW</bpmn:incoming>
            <bpmn:outgoing>Nur_Nebenaktion_beendet_zu_Nur_Nebenaktion_beendet_Neuen_FLOW</bpmn:outgoing>
          </bpmn:exclusiveGateway>
          <bpmn:endEvent id="Nur_Nebenaktion_beendet_Neuen_Pruefbedarf_bearbeiten_END" name="Nur Nebenaktion beendet">
            <bpmn:incoming>Nur_Nebenaktion_beendet_zu_Nur_Nebenaktion_beendet_Neuen_FLOW</bpmn:incoming>
          </bpmn:endEvent>
          <bpmn:sequenceFlow id="Nur_Nebenaktion_beendet_zu_Nur_Nebenaktion_beendet_Neuen_FLOW" sourceRef="Nur_Nebenaktion_beendet_zusammenfuehren_XOR" targetRef="Nur_Nebenaktion_beendet_Neuen_Pruefbedarf_bearbeiten_END" />
          <bpmn:sequenceFlow id="Pruefbedarf_gemeldet_START_zu_Pruefgrund_und_Fallstand_pruefen_FLOW" name="" sourceRef="Pruefbedarf_gemeldet_START" targetRef="Pruefgrund_und_Fallstand_pruefen_SERVICE" />
          <bpmn:sequenceFlow id="Pruefgrund_und_Fallstand_zu_Aktuelle_Situation_XOR_FLOW" name="" sourceRef="Pruefgrund_und_Fallstand_pruefen_SERVICE" targetRef="Aktuelle_Situation_XOR" />
          <bpmn:sequenceFlow id="Aktuelle_Situation_XOR_Pruefung_bereits_offen_zu_Offene_Pruefung_ergaenzen_SERVICE_FLOW" name="Pruefung bereits offen" sourceRef="Aktuelle_Situation_XOR" targetRef="Offene_Pruefung_ergaenzen_SERVICE">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewRoute = "EXISTING"</bpmn:conditionExpression>
          </bpmn:sequenceFlow>
          <bpmn:sequenceFlow id="Aktuelle_Situation_XOR_Neuer_Grund_im_Mieterwartepfad_zu_Pruefbedarf_im_Mieterwarten_melden_FLOW" name="Neuer Grund im Mieterwartepfad" sourceRef="Aktuelle_Situation_XOR" targetRef="Pruefbedarf_im_Mieterwarten_melden_SERVICE">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewRoute = "REPLY"</bpmn:conditionExpression>
          </bpmn:sequenceFlow>
          <bpmn:sequenceFlow id="Aktuelle_Situation_XOR_Wiederholung_beruecksichtigt_abgeschlossen_zu_Keine_neue_Pruefung_aus_FLOW" name="Wiederholung / beruecksichtigt / abgeschlossen" sourceRef="Aktuelle_Situation_XOR" targetRef="Keine_neue_Pruefung_aus_dieser_Meldung_END">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewRoute = "NONE"</bpmn:conditionExpression>
          </bpmn:sequenceFlow>
          <bpmn:sequenceFlow id="Offene_Pruefung_ergaenzen_zu_Nur_Nebenaktion_beendet_zusammenfuehren_FLOW" name="" sourceRef="Offene_Pruefung_ergaenzen_SERVICE" targetRef="Nur_Nebenaktion_beendet_zusammenfuehren_XOR" />
          <bpmn:sequenceFlow id="Pruefbedarf_im_Mieterwarten_zu_Nur_Nebenaktion_beendet_zusammenfuehren_FLOW" name="" sourceRef="Pruefbedarf_im_Mieterwarten_melden_SERVICE" targetRef="Nur_Nebenaktion_beendet_zusammenfuehren_XOR" />
          <bpmn:serviceTask id="Pruefbedarf_an_aktuelle_Fallphase_melden_SERVICE" name="Pruefbedarf an aktuelle&#10;Fallphase melden">
            <bpmn:documentation>0.31: Bei Automatic bestätigten neuen zwingenden Prüfentscheid für aktuellen automaticCallRef im Elternscope bereitstellen und automaticInterruptionReady setzen. Gemeinsames Randereignis unterbricht auch blockierte Jobs/Incident. Ab Bestätigung alte Wirkungen sperren. Bei In Bearbeitung, Wiedervorlage oder externer Wartephase weiterhin vorhandenen SWorkReviewNeeded/SFollowUpInterrupted/SExternalReview bedienen. Aktuellen Scope serverseitig ermitteln, keine parallele Mitarbeiterinstanz, keine verlorene Meldung bei Phasenwechsel; zuverlässig nachholen.</bpmn:documentation>
            <bpmn:extensionElements>
              <zeebe:taskDefinition type="propertyflow.review.interrupt-automatic" />
            </bpmn:extensionElements>
            <bpmn:incoming>Aktuelle_Situation_XOR_Andere_aktive_Phase_zu_Pruefbedarf_an_aktuelle_Fallphase_FLOW</bpmn:incoming>
            <bpmn:outgoing>Pruefbedarf_an_aktuelle_zu_Nur_Nebenaktion_beendet_zusammenfuehren_FLOW</bpmn:outgoing>
          </bpmn:serviceTask>
          <bpmn:sequenceFlow id="Aktuelle_Situation_XOR_Andere_aktive_Phase_zu_Pruefbedarf_an_aktuelle_Fallphase_FLOW" name="Andere aktive Phase" sourceRef="Aktuelle_Situation_XOR" targetRef="Pruefbedarf_an_aktuelle_Fallphase_melden_SERVICE">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= reviewRoute = "OTHER"</bpmn:conditionExpression>
          </bpmn:sequenceFlow>
          <bpmn:sequenceFlow id="Pruefbedarf_an_aktuelle_zu_Nur_Nebenaktion_beendet_zusammenfuehren_FLOW" name="" sourceRef="Pruefbedarf_an_aktuelle_Fallphase_melden_SERVICE" targetRef="Nur_Nebenaktion_beendet_zusammenfuehren_XOR" />
          <bpmn:textAnnotation id="Der_aktuelle_Fallstand_entscheidet_ob_NOTE">
            <bpmn:text>Der aktuelle Fallstand entscheidet, ob der Grund eine offene
Prüfung ergänzt oder an die laufende Fallphase geht.</bpmn:text>
          </bpmn:textAnnotation>
        </bpmn:subProcess>
        <bpmn:subProcess id="Mitarbeiteraktion_ausfuehren_SUBPROCESS" name="Mitarbeiteraktion ausfuehren">
          <bpmn:documentation>Bestätigte Mitarbeiteraufträge nach Aktionsart an ihre bestehende Verarbeitung leiten. Unbekannte Aktionen als Vertragsfehler melden.</bpmn:documentation>
          <bpmn:categoryValueRef>Vier_Wege_fuer_eingehende_Fallaktionen_CATEGORY_VALUE</bpmn:categoryValueRef>
          <bpmn:incoming>Welche_Fallaktion_XOR_zu_Mitarbeiteraktion_ausfuehren_SUBPROCESS_FLOW</bpmn:incoming>
          <bpmn:outgoing>Mitarbeiteraktion_ausfuehren_SUBPROCESS_zu_Aktion_verarbeitet_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
          <bpmn:startEvent id="Mitarbeiteraktion_ausfuehren_starten_START">
            <bpmn:outgoing>Mitarbeiteraktion_ausfuehren_starten_zu_Welche_Mitarbeiteraktion_XOR_FLOW</bpmn:outgoing>
          </bpmn:startEvent>
          <bpmn:sequenceFlow id="Mitarbeiteraktion_ausfuehren_starten_zu_Welche_Mitarbeiteraktion_XOR_FLOW" sourceRef="Mitarbeiteraktion_ausfuehren_starten_START" targetRef="Welche_Mitarbeiteraktion_XOR" />
          <bpmn:exclusiveGateway id="Welche_Mitarbeiteraktion_XOR" name="Welche Mitarbeiteraktion?" gatewayDirection="Diverging" default="Welche_Mitarbeiteraktion_XOR_zu_Unbekannte_Aktion_Mitarbeiteraktion_ausfuehren_FLOW">
            <bpmn:incoming>Mitarbeiteraktion_ausfuehren_starten_zu_Welche_Mitarbeiteraktion_XOR_FLOW</bpmn:incoming>
            <bpmn:outgoing>Welche_Mitarbeiteraktion_XOR_zu_Mitarbeiternachricht_in_Abklaerung_senden_FLOW</bpmn:outgoing>
            <bpmn:outgoing>Welche_Mitarbeiteraktion_XOR_zu_Antwortbedarf_aufheben_SUBPROCESS_FLOW</bpmn:outgoing>
            <bpmn:outgoing>Welche_Mitarbeiteraktion_XOR_zu_Bearbeitung_in_Abklaerung_uebernehmen_FLOW</bpmn:outgoing>
            <bpmn:outgoing>Welche_Mitarbeiteraktion_XOR_zu_Direkte_Wiedervorlage_setzen_SUBPROCESS_FLOW</bpmn:outgoing>
            <bpmn:outgoing>Welche_Mitarbeiteraktion_XOR_zu_Falldaten_ergaenzen_SUBPROCESS_FLOW</bpmn:outgoing>
            <bpmn:outgoing>Welche_Mitarbeiteraktion_XOR_zu_Unbekannte_Aktion_Mitarbeiteraktion_ausfuehren_FLOW</bpmn:outgoing>
          </bpmn:exclusiveGateway>
          <bpmn:subProcess id="Mitarbeiternachricht_in_Abklaerung_senden_SUBPROCESS" name="Mitarbeiternachricht in Abklaerung senden">
            <bpmn:documentation>0.33 / KOM-AK-31: Bestehender nicht unterbrechender Sendeweg für Informationen und Rückfragen während In Abklärung. Lokale Auftragsdaten, kein neuer Mieternachrichtenempfänger. Eine Information beendet nur die Nebenaktion. Nur eine erfolgreich veröffentlichte Rückfrage mit Antwortbedarf veranlasst Übergang 29 und gemeinsame Automatik-Ablösung. Ablehnung verändert den laufenden Pfad nicht.</bpmn:documentation>
            <bpmn:extensionElements>
              <zeebe:ioMapping>
                <zeebe:input source="= staffMessageCommandRef" target="staffMessageCommandRef" />
                <zeebe:input source="=null" target="staffMessageOutcome" />
              </zeebe:ioMapping>
            </bpmn:extensionElements>
            <bpmn:categoryValueRef>Fuenf_Mitarbeiteraktionen_CATEGORY_VALUE</bpmn:categoryValueRef>
            <bpmn:incoming>Welche_Mitarbeiteraktion_XOR_zu_Mitarbeiternachricht_in_Abklaerung_senden_FLOW</bpmn:incoming>
            <bpmn:outgoing>Mitarbeiternachricht_in_Abklaerung_zu_Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
            <bpmn:startEvent id="Sendeauftrag_eingegangen_START" name="Sendeauftrag eingegangen">
              <bpmn:outgoing>Sendeauftrag_eingegangen_START_zu_Mitarbeiternachricht_speichern_SERVICE_FLOW</bpmn:outgoing>
            </bpmn:startEvent>
            <bpmn:serviceTask id="Mitarbeiternachricht_speichern_SERVICE" name="Mitarbeiternachricht speichern">
              <bpmn:documentation>Berechtigten Mitarbeiter, Auftrags-ID, bestätigte Fallversion, aktuellen führenden Durchlauf und Status In Abklärung prüfen. Text und Antwortbedarf nur aus bestätigtem Auftrag übernehmen. Nachricht und Mailpflicht konsistent speichern; keine Katalogpflicht für Mitarbeitertext. Ohne neuen Antwortbedarf: Status, bestehende Fragen und automatische Bearbeitung erhalten, kein Ablösemarker. Relevante neue Information vor Wirkung alter KI-Ergebnisse berücksichtigen; bestehender Aktualitätsschutz, keine pauschale Unterbrechung. Mit Antwortbedarf: bestehende FALL-06-Regel, zwingender Prüfbedarf sperrt Übergang 29; Nachricht, neuen Bedarf, Wartet auf Mieterantwort und Mailpflicht konsistent sichern, automatische Wirkungsfreigaben entziehen. Gespeichertes Auftragsergebnis unterscheidet INFORMATION, QUESTION und REJECTED; erfolgreiche Wiederholung liest dasselbe Ergebnis ohne erneute Veröffentlichung oder Mailpflicht. Veralteten unveröffentlichten Auftrag ohne Wirkung ablehnen, Eingabe erhalten. Technische Fehler Retry/Incident. Dauerhafter Versandauftrag an eigenständigen Camunda-Mailprozess, kein direkter SMTP-Versand und kein Warten auf SMTP. Neuer zwingender Prüfbedarf bleibt separater Eingang; Information allein erledigt keine Prüfgründe.</bpmn:documentation>
              <bpmn:extensionElements>
                <zeebe:taskDefinition type="propertyflow.staff-message.publish" retries="5" />
              </bpmn:extensionElements>
              <bpmn:incoming>Sendeauftrag_eingegangen_START_zu_Mitarbeiternachricht_speichern_SERVICE_FLOW</bpmn:incoming>
              <bpmn:outgoing>Mitarbeiternachricht_speichern_SERVICE_zu_Gespeichertes_Ergebnis_XOR_FLOW</bpmn:outgoing>
            </bpmn:serviceTask>
            <bpmn:exclusiveGateway id="Gespeichertes_Ergebnis_XOR" name="Gespeichertes Ergebnis" default="Gespeichertes_Ergebnis_XOR_REJECTED_abgelehnt_zu_Abgelehnt_aktuellen_Stand_anzeigen_FLOW">
              <bpmn:incoming>Mitarbeiternachricht_speichern_SERVICE_zu_Gespeichertes_Ergebnis_XOR_FLOW</bpmn:incoming>
              <bpmn:outgoing>Gespeichertes_Ergebnis_XOR_QUESTION_Rueckfrage_gespeichert_zu_Rueckfrage_zur_Abloesung_bereitstellen_FLOW</bpmn:outgoing>
              <bpmn:outgoing>Gespeichertes_Ergebnis_XOR_REJECTED_abgelehnt_zu_Abgelehnt_aktuellen_Stand_anzeigen_FLOW</bpmn:outgoing>
              <bpmn:outgoing>Gespeichertes_Ergebnis_XOR_INFORMATION_ohne_Antwortbedarf_zu_Information_gespeichert_Automatik_bleibt_FLOW</bpmn:outgoing>
            </bpmn:exclusiveGateway>
            <bpmn:serviceTask id="Rueckfrage_zur_Abloesung_bereitstellen_SERVICE" name="Rueckfrage zur&#10;Abloesung bereitstellen">
              <bpmn:documentation>0.31: Bestätigten persistierten Entscheid für aktuellen Automatic-Call mit automaticCallRef in dessen Elternscope bereitstellen und automaticInterruptionReady setzen. Keine weitere Flagfamilie je Service Task. Aktuellen Fallstand/Durchlauf prüfen; nachholbar und idempotent. Unveröffentlichte/abgelehnte Aufträge unterbrechen nicht. Marker bis Verbrauch gültig, nicht auf spätere Calls übertragen. Neue zwingende Prüfgründe während Übergabe zuverlässig erhalten; keine Outputs des abgebrochenen Kindes.
    0.33: Ausschliesslich Ergebnis QUESTION darf diesen Schritt erreichen. INFORMATION setzt automaticInterruptionReady nicht und entzieht keine pauschale Automatikfreigabe.</bpmn:documentation>
              <bpmn:extensionElements>
                <zeebe:taskDefinition type="propertyflow.clarification-question.signal" />
              </bpmn:extensionElements>
              <bpmn:incoming>Gespeichertes_Ergebnis_XOR_QUESTION_Rueckfrage_gespeichert_zu_Rueckfrage_zur_Abloesung_bereitstellen_FLOW</bpmn:incoming>
              <bpmn:outgoing>Rueckfrage_zur_Abloesung_zu_Uebernahme_bereitgestellt_Mitarbeiternachricht_in_FLOW</bpmn:outgoing>
            </bpmn:serviceTask>
            <bpmn:endEvent id="Uebernahme_bereitgestellt_Mitarbeiternachricht_in_Abklaerung_senden_END" name="Uebernahme bereitgestellt">
              <bpmn:incoming>Rueckfrage_zur_Abloesung_zu_Uebernahme_bereitgestellt_Mitarbeiternachricht_in_FLOW</bpmn:incoming>
            </bpmn:endEvent>
            <bpmn:endEvent id="Abgelehnt_aktuellen_Stand_anzeigen_Laufender_Pfad_bleibt_Mitarbeiternachricht_in_Abklaerung_senden_END" name="Abgelehnt: aktuellen Stand anzeigen&#10;Laufender Pfad bleibt">
              <bpmn:incoming>Gespeichertes_Ergebnis_XOR_REJECTED_abgelehnt_zu_Abgelehnt_aktuellen_Stand_anzeigen_FLOW</bpmn:incoming>
            </bpmn:endEvent>
            <bpmn:sequenceFlow id="Sendeauftrag_eingegangen_START_zu_Mitarbeiternachricht_speichern_SERVICE_FLOW" sourceRef="Sendeauftrag_eingegangen_START" targetRef="Mitarbeiternachricht_speichern_SERVICE" />
            <bpmn:sequenceFlow id="Mitarbeiternachricht_speichern_SERVICE_zu_Gespeichertes_Ergebnis_XOR_FLOW" sourceRef="Mitarbeiternachricht_speichern_SERVICE" targetRef="Gespeichertes_Ergebnis_XOR" />
            <bpmn:sequenceFlow id="Gespeichertes_Ergebnis_XOR_QUESTION_Rueckfrage_gespeichert_zu_Rueckfrage_zur_Abloesung_bereitstellen_FLOW" name="QUESTION: Rueckfrage gespeichert" sourceRef="Gespeichertes_Ergebnis_XOR" targetRef="Rueckfrage_zur_Abloesung_bereitstellen_SERVICE">
              <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=staffMessageOutcome = "QUESTION"</bpmn:conditionExpression>
            </bpmn:sequenceFlow>
            <bpmn:sequenceFlow id="Rueckfrage_zur_Abloesung_zu_Uebernahme_bereitgestellt_Mitarbeiternachricht_in_FLOW" sourceRef="Rueckfrage_zur_Abloesung_bereitstellen_SERVICE" targetRef="Uebernahme_bereitgestellt_Mitarbeiternachricht_in_Abklaerung_senden_END" />
            <bpmn:sequenceFlow id="Gespeichertes_Ergebnis_XOR_REJECTED_abgelehnt_zu_Abgelehnt_aktuellen_Stand_anzeigen_FLOW" name="REJECTED: abgelehnt" sourceRef="Gespeichertes_Ergebnis_XOR" targetRef="Abgelehnt_aktuellen_Stand_anzeigen_Laufender_Pfad_bleibt_Mitarbeiternachricht_in_Abklaerung_senden_END" />
            <bpmn:endEvent id="Information_gespeichert_Automatik_bleibt_aktiv_END" name="Information gespeichert&#10;Automatik bleibt aktiv">
              <bpmn:incoming>Gespeichertes_Ergebnis_XOR_INFORMATION_ohne_Antwortbedarf_zu_Information_gespeichert_Automatik_bleibt_FLOW</bpmn:incoming>
            </bpmn:endEvent>
            <bpmn:sequenceFlow id="Gespeichertes_Ergebnis_XOR_INFORMATION_ohne_Antwortbedarf_zu_Information_gespeichert_Automatik_bleibt_FLOW" name="INFORMATION: ohne Antwortbedarf" sourceRef="Gespeichertes_Ergebnis_XOR" targetRef="Information_gespeichert_Automatik_bleibt_aktiv_END">
              <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=staffMessageOutcome = "INFORMATION"</bpmn:conditionExpression>
            </bpmn:sequenceFlow>
            <bpmn:textAnnotation id="Die_Nachricht_wird_nach_Auftragspruefung_NOTE">
              <bpmn:text>Die Nachricht wird nach Auftragsprüfung gespeichert.
Bei bestätigtem Antwortbedarf wechselt der Fall in die Mieterwartephase.</bpmn:text>
            </bpmn:textAnnotation>
          </bpmn:subProcess>
          <bpmn:sequenceFlow id="Welche_Mitarbeiteraktion_XOR_zu_Mitarbeiternachricht_in_Abklaerung_senden_FLOW" sourceRef="Welche_Mitarbeiteraktion_XOR" targetRef="Mitarbeiternachricht_in_Abklaerung_senden_SUBPROCESS">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= actionType = "STAFF_QUESTION"</bpmn:conditionExpression>
          </bpmn:sequenceFlow>
          <bpmn:sequenceFlow id="Mitarbeiternachricht_in_Abklaerung_zu_Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR_FLOW" sourceRef="Mitarbeiternachricht_in_Abklaerung_senden_SUBPROCESS" targetRef="Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR" />
          <bpmn:subProcess id="Antwortbedarf_aufheben_SUBPROCESS" name="Antwortbedarf aufheben">
            <bpmn:documentation>
    Nicht unterbrechender Mitarbeitereingang in jeder aktiven Phase. Keine Mieternachricht und keine KI-Auswertung erforderlich. Lokale Auftragsdaten; keine pauschale Überschreibung von Hauptpfadvariablen. Nach Fallabschluss keine neuen Wirkungen.</bpmn:documentation>
            <bpmn:extensionElements>
              <zeebe:ioMapping>
                <zeebe:input source="= clearAnswerCommandRef" target="clearAnswerCommandRef" />
              </zeebe:ioMapping>
            </bpmn:extensionElements>
            <bpmn:categoryValueRef>Fuenf_Mitarbeiteraktionen_CATEGORY_VALUE</bpmn:categoryValueRef>
            <bpmn:incoming>Welche_Mitarbeiteraktion_XOR_zu_Antwortbedarf_aufheben_SUBPROCESS_FLOW</bpmn:incoming>
            <bpmn:outgoing>Antwortbedarf_aufheben_SUBPROCESS_zu_Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
            <bpmn:startEvent id="Gepruefter_Mitarbeiterauftrag_START" name="Gepruefter Mitarbeiterauftrag">
              <bpmn:outgoing>Gepruefter_Mitarbeiterauftrag_START_zu_Antwortbedarf_aufheben_SERVICE_FLOW</bpmn:outgoing>
            </bpmn:startEvent>
            <bpmn:serviceTask id="Antwortbedarf_aufheben_SERVICE" name="Antwortbedarf aufheben">
              <bpmn:documentation>
    KOM-03: Berechtigung, aktuellen Fall, Nachricht, Antwortbedarf, führende Instanz und Auftragsversion prüfen. Nur gezielten Bedarf idempotent aufheben, Nachricht erhalten und nicht als beantwortet markieren. Weitere offene Fragen: keine Statusänderung. Laufende Mitarbeiterprüfung, Wiedervorlage und externe Wartephase erhalten. Nur beim aktuellen Reply-Aufruf und letztem aufgehobenen Bedarf den geprüften Fortsetzungsmarker mit Call-Bezug dauerhaft bereitstellen. Bereits bestehende Prüfgründe haben Vorrang. Neue Fragen und konkurrierende Entscheidungen dürfen nicht überschrieben werden. Abgelehnte oder veraltete Aktionen bleiben ohne Wirkung; technische Fehler Retry/Incident. Speicherung und Markerzustellung müssen wiederholbar ohne Lücke sein. Keine direkte User-Task-Erledigung.</bpmn:documentation>
              <bpmn:extensionElements>
                <zeebe:taskDefinition type="propertyflow.answer.clear" />
              </bpmn:extensionElements>
              <bpmn:incoming>Gepruefter_Mitarbeiterauftrag_START_zu_Antwortbedarf_aufheben_SERVICE_FLOW</bpmn:incoming>
              <bpmn:outgoing>Antwortbedarf_aufheben_SERVICE_zu_Nur_Nebenaktion_beendet_Antwortbedarf_FLOW</bpmn:outgoing>
            </bpmn:serviceTask>
            <bpmn:endEvent id="Nur_Nebenaktion_beendet_Antwortbedarf_aufheben_END" name="Nur Nebenaktion beendet">
              <bpmn:incoming>Antwortbedarf_aufheben_SERVICE_zu_Nur_Nebenaktion_beendet_Antwortbedarf_FLOW</bpmn:incoming>
            </bpmn:endEvent>
            <bpmn:sequenceFlow id="Gepruefter_Mitarbeiterauftrag_START_zu_Antwortbedarf_aufheben_SERVICE_FLOW" name="" sourceRef="Gepruefter_Mitarbeiterauftrag_START" targetRef="Antwortbedarf_aufheben_SERVICE" />
            <bpmn:sequenceFlow id="Antwortbedarf_aufheben_SERVICE_zu_Nur_Nebenaktion_beendet_Antwortbedarf_FLOW" name="" sourceRef="Antwortbedarf_aufheben_SERVICE" targetRef="Nur_Nebenaktion_beendet_Antwortbedarf_aufheben_END" />
            <bpmn:textAnnotation id="Der_bestaetigte_Auftrag_hebt_den_NOTE">
              <bpmn:text>Der bestätigte Auftrag hebt den Antwortbedarf auf.
Der laufende Warteaufruf erhält die passende Fortsetzung.</bpmn:text>
            </bpmn:textAnnotation>
          </bpmn:subProcess>
          <bpmn:sequenceFlow id="Welche_Mitarbeiteraktion_XOR_zu_Antwortbedarf_aufheben_SUBPROCESS_FLOW" sourceRef="Welche_Mitarbeiteraktion_XOR" targetRef="Antwortbedarf_aufheben_SUBPROCESS">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= actionType = "CLEAR_ANSWER"</bpmn:conditionExpression>
          </bpmn:sequenceFlow>
          <bpmn:sequenceFlow id="Antwortbedarf_aufheben_SUBPROCESS_zu_Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR_FLOW" sourceRef="Antwortbedarf_aufheben_SUBPROCESS" targetRef="Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR" />
          <bpmn:subProcess id="Bearbeitung_in_Abklaerung_uebernehmen_SUBPROCESS" name="Bearbeitung in Abklaerung uebernehmen">
            <bpmn:documentation>FALL-06 Übergang 33 / FALL-AK-40. Nicht unterbrechender interner Auftrag zur direkten Übernahme aus In Abklärung. Ungültige Aufträge lassen den aktuellen Pfad bestehen. Lokale Auftragsreferenz, keine zusätzliche Mieter-Subscription.</bpmn:documentation>
            <bpmn:extensionElements>
              <zeebe:ioMapping>
                <zeebe:input source="= staffTakeoverCommandRef" target="staffTakeoverCommandRef" />
                <zeebe:input source="= null" target="staffTakeoverOutcome" />
              </zeebe:ioMapping>
            </bpmn:extensionElements>
            <bpmn:categoryValueRef>Fuenf_Mitarbeiteraktionen_CATEGORY_VALUE</bpmn:categoryValueRef>
            <bpmn:incoming>Welche_Mitarbeiteraktion_XOR_zu_Bearbeitung_in_Abklaerung_uebernehmen_FLOW</bpmn:incoming>
            <bpmn:outgoing>Bearbeitung_in_Abklaerung_zu_Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
            <bpmn:startEvent id="Uebernahme_angefordert_START" name="Uebernahme angefordert">
              <bpmn:outgoing>Uebernahme_angefordert_START_zu_Mitarbeiteruebernahme_speichern_SERVICE_FLOW</bpmn:outgoing>
            </bpmn:startEvent>
            <bpmn:serviceTask id="Mitarbeiteruebernahme_speichern_SERVICE" name="Mitarbeiteruebernahme speichern">
              <bpmn:documentation>Berechtigung, führenden Durchlauf, Status In Abklärung und bestätigte Fallversion prüfen. Ohne zwingenden Prüfbedarf In Bearbeitung, andernfalls Mitarbeiterprüfung erforderlich speichern. Übernahme, Zielstatus und erforderliche Mailpflicht konsistent sichern; bestehender unabhängiger Camunda-Mailprozess beauftragt den Mail-Worker. Prüfgründe nicht als erledigt behandeln. Offene Fragen und manuelle Dringlichkeit erhalten. Ab Commit alte automatische Wirkungsfreigaben entziehen. Veraltete Aufträge ohne Wirkung ablehnen. Erfolgreiche Wiederholung ohne zweite Aufgabe, Nachweis oder Mailpflicht; technische Fehler Retry/Incident.</bpmn:documentation>
              <bpmn:extensionElements>
                <zeebe:taskDefinition type="propertyflow.takeover.apply" />
              </bpmn:extensionElements>
              <bpmn:incoming>Uebernahme_angefordert_START_zu_Mitarbeiteruebernahme_speichern_SERVICE_FLOW</bpmn:incoming>
              <bpmn:outgoing>Mitarbeiteruebernahme_speichern_SERVICE_zu_Uebernahme_gespeichert_XOR_FLOW</bpmn:outgoing>
            </bpmn:serviceTask>
            <bpmn:exclusiveGateway id="Uebernahme_gespeichert_XOR" name="Uebernahme&#10;gespeichert?">
              <bpmn:incoming>Mitarbeiteruebernahme_speichern_SERVICE_zu_Uebernahme_gespeichert_XOR_FLOW</bpmn:incoming>
              <bpmn:outgoing>Uebernahme_gespeichert_XOR_Ja_bereits_uebernommen_zu_Uebernahme_zur_Abloesung_bereitstellen_FLOW</bpmn:outgoing>
              <bpmn:outgoing>Uebernahme_gespeichert_XOR_Nein_zu_Abgelehnt_aktuellen_Stand_anzeigen_FLOW</bpmn:outgoing>
            </bpmn:exclusiveGateway>
            <bpmn:serviceTask id="Uebernahme_zur_Abloesung_bereitstellen_SERVICE" name="Uebernahme zur&#10;Abloesung bereitstellen">
              <bpmn:documentation>0.31: Bestätigten persistierten Entscheid für aktuellen Automatic-Call mit automaticCallRef in dessen Elternscope bereitstellen und automaticInterruptionReady setzen. Keine weitere Flagfamilie je Service Task. Aktuellen Fallstand/Durchlauf prüfen; nachholbar und idempotent. Unveröffentlichte/abgelehnte Aufträge unterbrechen nicht. Marker bis Verbrauch gültig, nicht auf spätere Calls übertragen. Neue zwingende Prüfgründe während Übergabe zuverlässig erhalten; keine Outputs des abgebrochenen Kindes.</bpmn:documentation>
              <bpmn:extensionElements>
                <zeebe:taskDefinition type="propertyflow.takeover.signal" />
              </bpmn:extensionElements>
              <bpmn:incoming>Uebernahme_gespeichert_XOR_Ja_bereits_uebernommen_zu_Uebernahme_zur_Abloesung_bereitstellen_FLOW</bpmn:incoming>
              <bpmn:outgoing>Uebernahme_zur_Abloesung_zu_Uebernahme_bereitgestellt_Bearbeitung_in_FLOW</bpmn:outgoing>
            </bpmn:serviceTask>
            <bpmn:endEvent id="Uebernahme_bereitgestellt_Bearbeitung_in_Abklaerung_uebernehmen_END" name="Uebernahme bereitgestellt">
              <bpmn:incoming>Uebernahme_zur_Abloesung_zu_Uebernahme_bereitgestellt_Bearbeitung_in_FLOW</bpmn:incoming>
            </bpmn:endEvent>
            <bpmn:endEvent id="Abgelehnt_aktuellen_Stand_anzeigen_Laufender_Pfad_bleibt_Bearbeitung_in_Abklaerung_uebernehmen_END" name="Abgelehnt: aktuellen Stand anzeigen&#10;Laufender Pfad bleibt">
              <bpmn:incoming>Uebernahme_gespeichert_XOR_Nein_zu_Abgelehnt_aktuellen_Stand_anzeigen_FLOW</bpmn:incoming>
            </bpmn:endEvent>
            <bpmn:sequenceFlow id="Uebernahme_angefordert_START_zu_Mitarbeiteruebernahme_speichern_SERVICE_FLOW" sourceRef="Uebernahme_angefordert_START" targetRef="Mitarbeiteruebernahme_speichern_SERVICE" />
            <bpmn:sequenceFlow id="Mitarbeiteruebernahme_speichern_SERVICE_zu_Uebernahme_gespeichert_XOR_FLOW" sourceRef="Mitarbeiteruebernahme_speichern_SERVICE" targetRef="Uebernahme_gespeichert_XOR" />
            <bpmn:sequenceFlow id="Uebernahme_gespeichert_XOR_Ja_bereits_uebernommen_zu_Uebernahme_zur_Abloesung_bereitstellen_FLOW" name="Ja / bereits uebernommen" sourceRef="Uebernahme_gespeichert_XOR" targetRef="Uebernahme_zur_Abloesung_bereitstellen_SERVICE">
              <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffTakeoverOutcome = "APPLIED"</bpmn:conditionExpression>
            </bpmn:sequenceFlow>
            <bpmn:sequenceFlow id="Uebernahme_zur_Abloesung_zu_Uebernahme_bereitgestellt_Bearbeitung_in_FLOW" sourceRef="Uebernahme_zur_Abloesung_bereitstellen_SERVICE" targetRef="Uebernahme_bereitgestellt_Bearbeitung_in_Abklaerung_uebernehmen_END" />
            <bpmn:sequenceFlow id="Uebernahme_gespeichert_XOR_Nein_zu_Abgelehnt_aktuellen_Stand_anzeigen_FLOW" name="Nein" sourceRef="Uebernahme_gespeichert_XOR" targetRef="Abgelehnt_aktuellen_Stand_anzeigen_Laufender_Pfad_bleibt_Bearbeitung_in_Abklaerung_uebernehmen_END">
              <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffTakeoverOutcome = "REJECTED"</bpmn:conditionExpression>
            </bpmn:sequenceFlow>
            <bpmn:textAnnotation id="PropertyFlow_prueft_den_Uebernahmeauftrag_und_NOTE">
              <bpmn:text>PropertyFlow prüft den Übernahmeauftrag und vorhandenen Prüfbedarf.
Der bestätigte Auftrag löst die laufende Automatik ab.</bpmn:text>
            </bpmn:textAnnotation>
          </bpmn:subProcess>
          <bpmn:sequenceFlow id="Welche_Mitarbeiteraktion_XOR_zu_Bearbeitung_in_Abklaerung_uebernehmen_FLOW" sourceRef="Welche_Mitarbeiteraktion_XOR" targetRef="Bearbeitung_in_Abklaerung_uebernehmen_SUBPROCESS">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= actionType = "STAFF_TAKEOVER"</bpmn:conditionExpression>
          </bpmn:sequenceFlow>
          <bpmn:sequenceFlow id="Bearbeitung_in_Abklaerung_zu_Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR_FLOW" sourceRef="Bearbeitung_in_Abklaerung_uebernehmen_SUBPROCESS" targetRef="Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR" />
          <bpmn:subProcess id="Direkte_Wiedervorlage_setzen_SUBPROCESS" name="Direkte Wiedervorlage setzen">
            <bpmn:documentation>FALL-11 Übergang 31 / FALL-AK-37. Nicht unterbrechender interner Mitarbeiterauftrag. Ungültige oder veraltete Aufträge verändern den laufenden Pfad nicht. Lokale Auftragsvariablen, kein zusätzlicher Mieternachrichtenempfänger.
    0.27: Zusätzlich FALL-11 Übergang 32 / FALL-AK-38. Derselbe geprüfte Auftragseingang gilt aus Wartet auf Mieterantwort; keine zweite Terminsetzungslogik.</bpmn:documentation>
            <bpmn:extensionElements>
              <zeebe:ioMapping>
                <zeebe:input source="= directFollowCommandRef" target="directFollowCommandRef" />
                <zeebe:input source="=null" target="directFollowOutcome" />
              </zeebe:ioMapping>
            </bpmn:extensionElements>
            <bpmn:categoryValueRef>Fuenf_Mitarbeiteraktionen_CATEGORY_VALUE</bpmn:categoryValueRef>
            <bpmn:incoming>Welche_Mitarbeiteraktion_XOR_zu_Direkte_Wiedervorlage_setzen_SUBPROCESS_FLOW</bpmn:incoming>
            <bpmn:outgoing>Direkte_Wiedervorlage_setzen_zu_Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
            <bpmn:startEvent id="Wiedervorlage_angefordert_START" name="Wiedervorlage angefordert">
              <bpmn:outgoing>Wiedervorlage_angefordert_START_zu_Direkte_Wiedervorlage_speichern_SERVICE_FLOW</bpmn:outgoing>
            </bpmn:startEvent>
            <bpmn:serviceTask id="Direkte_Wiedervorlage_speichern_SERVICE" name="Direkte Wiedervorlage speichern">
              <bpmn:documentation>Berechtigung, aktuellen führenden Durchlauf, Status In Abklärung oder Wartet auf Mieterantwort, bestätigten Fallstand und zukünftigen Termin prüfen. FALL-11: Kalendertage, 08:00 Europe/Zurich, optionale interne Begründung. Termin, Version, Status, bewusste Berücksichtigung bekannter Prüfgründe und erforderliche Mailpflicht konsistent sichern. Offene Mieterfragen erhalten. Keine pauschale Kosten- oder Abschlussfreigabe. Alte automatische Schreibfreigaben entziehen. Konkurrierende Änderungen machen den Auftrag ungültig, keine stillschweigende Übernahme neuer Erkenntnisse. Erfolgreiche Wiederholung liefert denselben Termin und dieselbe Version ohne neue Mailpflicht. Technischer Fehler bleibt Retry/Incident. BEN-03: zuverlässige Übergabe an Mailprozess, kein Warten auf SMTP.</bpmn:documentation>
              <bpmn:extensionElements>
                <zeebe:taskDefinition type="propertyflow.direct-follow-up.apply" />
              </bpmn:extensionElements>
              <bpmn:incoming>Wiedervorlage_angefordert_START_zu_Direkte_Wiedervorlage_speichern_SERVICE_FLOW</bpmn:incoming>
              <bpmn:outgoing>Direkte_Wiedervorlage_speichern_zu_Terminsetzung_gespeichert_XOR_FLOW</bpmn:outgoing>
            </bpmn:serviceTask>
            <bpmn:exclusiveGateway id="Terminsetzung_gespeichert_XOR" name="Terminsetzung&#10;gespeichert?">
              <bpmn:incoming>Direkte_Wiedervorlage_speichern_zu_Terminsetzung_gespeichert_XOR_FLOW</bpmn:incoming>
              <bpmn:outgoing>Terminsetzung_gespeichert_XOR_Ja_bereits_uebernommen_zu_Wiedervorlage_zur_Uebernahme_bereitstellen_FLOW</bpmn:outgoing>
              <bpmn:outgoing>Terminsetzung_gespeichert_XOR_Nein_zu_Abgelehnt_aktuellen_Stand_anzeigen_FLOW</bpmn:outgoing>
            </bpmn:exclusiveGateway>
            <bpmn:serviceTask id="Wiedervorlage_zur_Uebernahme_bereitstellen_SERVICE" name="Wiedervorlage zur&#10;Uebernahme bereitstellen">
              <bpmn:documentation>0.31: Gespeicherten Terminauftrag zum aktuellen Aufruf bereitstellen. Bei Automatic: automaticCallRef + automaticInterruptionReady im Elternscope. Bei Reply: bestehenden staffFollowTakeoverReady zum Reply-Aufruf verwenden. Keine zweite Terminversion/Mailpflicht. Kontakte und neue Prüfgründe nach Speicherung auch während Übergabe nachliefern, aufgehobenen Termin nicht wiederherstellen.</bpmn:documentation>
              <bpmn:extensionElements>
                <zeebe:taskDefinition type="propertyflow.direct-follow-up.signal" />
              </bpmn:extensionElements>
              <bpmn:incoming>Terminsetzung_gespeichert_XOR_Ja_bereits_uebernommen_zu_Wiedervorlage_zur_Uebernahme_bereitstellen_FLOW</bpmn:incoming>
              <bpmn:outgoing>Wiedervorlage_zur_Uebernahme_zu_Uebernahme_bereitgestellt_Direkte_Wiedervorlage_FLOW</bpmn:outgoing>
            </bpmn:serviceTask>
            <bpmn:endEvent id="Uebernahme_bereitgestellt_Direkte_Wiedervorlage_setzen_END" name="Uebernahme bereitgestellt">
              <bpmn:incoming>Wiedervorlage_zur_Uebernahme_zu_Uebernahme_bereitgestellt_Direkte_Wiedervorlage_FLOW</bpmn:incoming>
            </bpmn:endEvent>
            <bpmn:endEvent id="Abgelehnt_aktuellen_Stand_anzeigen_Laufender_Pfad_bleibt_Direkte_Wiedervorlage_setzen_END" name="Abgelehnt: aktuellen Stand anzeigen&#10;Laufender Pfad bleibt">
              <bpmn:incoming>Terminsetzung_gespeichert_XOR_Nein_zu_Abgelehnt_aktuellen_Stand_anzeigen_FLOW</bpmn:incoming>
            </bpmn:endEvent>
            <bpmn:sequenceFlow id="Wiedervorlage_angefordert_START_zu_Direkte_Wiedervorlage_speichern_SERVICE_FLOW" sourceRef="Wiedervorlage_angefordert_START" targetRef="Direkte_Wiedervorlage_speichern_SERVICE" />
            <bpmn:sequenceFlow id="Direkte_Wiedervorlage_speichern_zu_Terminsetzung_gespeichert_XOR_FLOW" sourceRef="Direkte_Wiedervorlage_speichern_SERVICE" targetRef="Terminsetzung_gespeichert_XOR" />
            <bpmn:sequenceFlow id="Terminsetzung_gespeichert_XOR_Ja_bereits_uebernommen_zu_Wiedervorlage_zur_Uebernahme_bereitstellen_FLOW" name="Ja / bereits uebernommen" sourceRef="Terminsetzung_gespeichert_XOR" targetRef="Wiedervorlage_zur_Uebernahme_bereitstellen_SERVICE">
              <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= directFollowOutcome = "APPLIED"</bpmn:conditionExpression>
            </bpmn:sequenceFlow>
            <bpmn:sequenceFlow id="Wiedervorlage_zur_Uebernahme_zu_Uebernahme_bereitgestellt_Direkte_Wiedervorlage_FLOW" sourceRef="Wiedervorlage_zur_Uebernahme_bereitstellen_SERVICE" targetRef="Uebernahme_bereitgestellt_Direkte_Wiedervorlage_setzen_END" />
            <bpmn:sequenceFlow id="Terminsetzung_gespeichert_XOR_Nein_zu_Abgelehnt_aktuellen_Stand_anzeigen_FLOW" name="Nein" sourceRef="Terminsetzung_gespeichert_XOR" targetRef="Abgelehnt_aktuellen_Stand_anzeigen_Laufender_Pfad_bleibt_Direkte_Wiedervorlage_setzen_END">
              <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= directFollowOutcome = "REJECTED"</bpmn:conditionExpression>
            </bpmn:sequenceFlow>
            <bpmn:textAnnotation id="PropertyFlow_speichert_den_bestaetigten_Termin_NOTE">
              <bpmn:text>PropertyFlow speichert den bestätigten Termin und stellt ihn
der laufenden Bearbeitung zur Übernahme bereit.</bpmn:text>
            </bpmn:textAnnotation>
          </bpmn:subProcess>
          <bpmn:sequenceFlow id="Welche_Mitarbeiteraktion_XOR_zu_Direkte_Wiedervorlage_setzen_SUBPROCESS_FLOW" sourceRef="Welche_Mitarbeiteraktion_XOR" targetRef="Direkte_Wiedervorlage_setzen_SUBPROCESS">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= actionType = "DIRECT_FOLLOW_UP"</bpmn:conditionExpression>
          </bpmn:sequenceFlow>
          <bpmn:sequenceFlow id="Direkte_Wiedervorlage_setzen_zu_Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR_FLOW" sourceRef="Direkte_Wiedervorlage_setzen_SUBPROCESS" targetRef="Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR" />
          <bpmn:subProcess id="Falldaten_ergaenzen_SUBPROCESS" name="Falldaten ergaenzen">
            <bpmn:documentation>0.34 / FALL-06 / FALL-AK-43: Ein gemeinsamer nicht unterbrechender Eingang für ADD_MEMO, SET_OBJECT_ASSIGNMENT und SET_MANUAL_URGENCY. Nur autorisierte Mitarbeiteraufträge für einen zugeordneten aktiven Fall. Kein neuer öffentlicher Endpunkt durch dieses Modell und kein Mieternachrichtenempfänger. Keine User-Task-Completion, kein neuer Call und kein Statuswechsel durch die Aktion. Lokale Auftragsreferenz je Ausführung, keine Überschreibung von Hauptpfadvariablen. Bei konkurrierendem Abschluss unveröffentlichte alte Aufträge ohne Wirkung auflösen; bereits gespeicherte Änderungen und Mailpflichten erhalten. Technische Korrelation und Transaktionskoordination noch umzusetzen.</bpmn:documentation>
            <bpmn:extensionElements>
              <zeebe:ioMapping>
                <zeebe:input source="= caseDataCommandRef" target="caseDataCommandRef" />
              </zeebe:ioMapping>
            </bpmn:extensionElements>
            <bpmn:categoryValueRef>Fuenf_Mitarbeiteraktionen_CATEGORY_VALUE</bpmn:categoryValueRef>
            <bpmn:incoming>Welche_Mitarbeiteraktion_XOR_zu_Falldaten_ergaenzen_SUBPROCESS_FLOW</bpmn:incoming>
            <bpmn:outgoing>Falldaten_ergaenzen_SUBPROCESS_zu_Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
            <bpmn:startEvent id="Aenderungsauftrag_eingegangen_START" name="Aenderungsauftrag eingegangen">
              <bpmn:outgoing>Aenderungsauftrag_eingegangen_START_zu_Falldaten_und_Aenderungsnachweis_speichern_FLOW</bpmn:outgoing>
            </bpmn:startEvent>
            <bpmn:serviceTask id="Falldaten_und_Aenderungsnachweis_speichern_SERVICE" name="Falldaten und Aenderungsnachweis speichern">
              <bpmn:documentation>FALL-06 Aktionsvertrag Falldaten ergänzen: authentifizierte Mitarbeiteridentität und Berechtigung, aktuelle führende Instanz, aktiven Status und bestätigte Fallversion serverseitig prüfen. Erreichbares Camunda ist Voraussetzung der Auftragsannahme; erneute Prüfung unmittelbar vor Speicherung. Keine frei übergebene Prozess-ID als Autorisierung, keine Mitarbeiter-User-Task voraussetzen. Fest definierte Aktionsart und deren Payload prüfen, an zuständige Fachlogik delegieren. ADD_MEMO nur intern, keine Mieter-Mail und kein Kommunikations-LLM-Kontext. SET_OBJECT_ASSIGNMENT nur zulässige Zuordnung, relevante alte Auswertungsgrundlage sperren, keine automatische Erledigung einer Mitarbeiterprüfung. SET_MANUAL_URGENCY validiert Stufe und schützt menschlichen Vorrang; wirksame Änderungen nach DRING historisieren/benachrichtigen, bestehende Regeln für unveränderte Werte erhalten. Änderung, erforderlichen Nachweis, Operationsausgang und gegebenenfalls Mailpflicht konsistent sichern. Status/Task/Timer unverändert. Neuer zwingender Prüfbedarf folgt separatem bestehenden Eingang und wird zuverlässig übergeben. Wiederholung desselben erfolgreichen Auftrags ohne zweite Wirkung; gleiche Operations-ID mit geändertem Inhalt ablehnen. Ungültiger/veralteter unverarbeiteter Auftrag ohne Änderung ablehnen, Eingabe erhalten. Technische Fehler Retry/Incident, nicht als fachliche Ablehnung tarnen. Bei Timeout keinen Erfolg behaupten und dieselbe Operations-ID wiederverwenden. Engine-Unterbrechung allein verhindert keine späte DB-Wirkung; Abschluss und Fallversion vor Commit koordinieren. Nur lokale Ergebnisdaten, keine Änderung von outcome/decisionRef des Hauptpfads.</bpmn:documentation>
              <bpmn:extensionElements>
                <zeebe:taskDefinition type="propertyflow.case-data.apply" />
              </bpmn:extensionElements>
              <bpmn:incoming>Aenderungsauftrag_eingegangen_START_zu_Falldaten_und_Aenderungsnachweis_speichern_FLOW</bpmn:incoming>
              <bpmn:outgoing>Falldaten_und_Aenderungsnachweis_zu_Nur_Aenderungsauftrag_beendet_END_FLOW</bpmn:outgoing>
            </bpmn:serviceTask>
            <bpmn:endEvent id="Nur_Aenderungsauftrag_beendet_END" name="Nur Aenderungsauftrag beendet">
              <bpmn:incoming>Falldaten_und_Aenderungsnachweis_zu_Nur_Aenderungsauftrag_beendet_END_FLOW</bpmn:incoming>
            </bpmn:endEvent>
            <bpmn:sequenceFlow id="Aenderungsauftrag_eingegangen_START_zu_Falldaten_und_Aenderungsnachweis_speichern_FLOW" sourceRef="Aenderungsauftrag_eingegangen_START" targetRef="Falldaten_und_Aenderungsnachweis_speichern_SERVICE" />
            <bpmn:sequenceFlow id="Falldaten_und_Aenderungsnachweis_zu_Nur_Aenderungsauftrag_beendet_END_FLOW" sourceRef="Falldaten_und_Aenderungsnachweis_speichern_SERVICE" targetRef="Nur_Aenderungsauftrag_beendet_END" />
            <bpmn:textAnnotation id="Der_Auftrag_prueft_Berechtigung_und_NOTE">
              <bpmn:text>Der Auftrag prüft Berechtigung und Fallstand und speichert
die Falldaten mit einem Änderungsnachweis.</bpmn:text>
            </bpmn:textAnnotation>
          </bpmn:subProcess>
          <bpmn:sequenceFlow id="Welche_Mitarbeiteraktion_XOR_zu_Falldaten_ergaenzen_SUBPROCESS_FLOW" sourceRef="Welche_Mitarbeiteraktion_XOR" targetRef="Falldaten_ergaenzen_SUBPROCESS">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= actionType = "CASE_DATA"</bpmn:conditionExpression>
          </bpmn:sequenceFlow>
          <bpmn:sequenceFlow id="Falldaten_ergaenzen_SUBPROCESS_zu_Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR_FLOW" sourceRef="Falldaten_ergaenzen_SUBPROCESS" targetRef="Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR" />
          <bpmn:exclusiveGateway id="Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR" gatewayDirection="Converging">
            <bpmn:incoming>Mitarbeiternachricht_in_Abklaerung_zu_Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR_FLOW</bpmn:incoming>
            <bpmn:incoming>Antwortbedarf_aufheben_SUBPROCESS_zu_Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR_FLOW</bpmn:incoming>
            <bpmn:incoming>Bearbeitung_in_Abklaerung_zu_Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR_FLOW</bpmn:incoming>
            <bpmn:incoming>Direkte_Wiedervorlage_setzen_zu_Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR_FLOW</bpmn:incoming>
            <bpmn:incoming>Falldaten_ergaenzen_SUBPROCESS_zu_Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR_FLOW</bpmn:incoming>
            <bpmn:outgoing>Mitarbeiteraktion_ausfuehren_zusammenfuehren_zu_Mitarbeiteraktion_ausfuehren_beenden_END_FLOW</bpmn:outgoing>
          </bpmn:exclusiveGateway>
          <bpmn:endEvent id="Mitarbeiteraktion_ausfuehren_beenden_END">
            <bpmn:incoming>Mitarbeiteraktion_ausfuehren_zusammenfuehren_zu_Mitarbeiteraktion_ausfuehren_beenden_END_FLOW</bpmn:incoming>
          </bpmn:endEvent>
          <bpmn:sequenceFlow id="Mitarbeiteraktion_ausfuehren_zusammenfuehren_zu_Mitarbeiteraktion_ausfuehren_beenden_END_FLOW" sourceRef="Mitarbeiteraktion_ausfuehren_zusammenfuehren_XOR" targetRef="Mitarbeiteraktion_ausfuehren_beenden_END" />
          <bpmn:endEvent id="Unbekannte_Aktion_Mitarbeiteraktion_ausfuehren_END" name="Unbekannte Aktion">
            <bpmn:incoming>Welche_Mitarbeiteraktion_XOR_zu_Unbekannte_Aktion_Mitarbeiteraktion_ausfuehren_FLOW</bpmn:incoming>
            <bpmn:errorEventDefinition id="Unbekannte_Aktion_Mitarbeiteraktion_ausfuehren_END_ERROR_DEF" errorRef="Unbekannte_Fallaktion_ERROR" />
          </bpmn:endEvent>
          <bpmn:sequenceFlow id="Welche_Mitarbeiteraktion_XOR_zu_Unbekannte_Aktion_Mitarbeiteraktion_ausfuehren_FLOW" sourceRef="Welche_Mitarbeiteraktion_XOR" targetRef="Unbekannte_Aktion_Mitarbeiteraktion_ausfuehren_END" />
          <bpmn:group id="Fuenf_Mitarbeiteraktionen_GROUP" categoryValueRef="Fuenf_Mitarbeiteraktionen_CATEGORY_VALUE" />
          <bpmn:textAnnotation id="Die_Aktion_bestimmt_welcher_Auftrag_NOTE">
            <bpmn:text>Die Aktion bestimmt, welcher Auftrag
für den aktuellen Fall geprüft wird.</bpmn:text>
          </bpmn:textAnnotation>
        </bpmn:subProcess>
        <bpmn:sequenceFlow id="Welche_Fallaktion_XOR_zu_Mitarbeiteraktion_ausfuehren_SUBPROCESS_FLOW" sourceRef="Welche_Fallaktion_XOR" targetRef="Mitarbeiteraktion_ausfuehren_SUBPROCESS" />
        <bpmn:sequenceFlow id="Mitarbeiteraktion_ausfuehren_SUBPROCESS_zu_Aktion_verarbeitet_zusammenfuehren_XOR_FLOW" sourceRef="Mitarbeiteraktion_ausfuehren_SUBPROCESS" targetRef="Aktion_verarbeitet_zusammenfuehren_XOR" />
        <bpmn:subProcess id="Fall_abschliessen_SUBPROCESS" name="Fall abschliessen">
          <bpmn:documentation>Den bestätigten Abschlussauftrag je nach Fallphase an den bisherigen Abschlussweg aus der Abklärung oder der Mieterwartephase leiten.</bpmn:documentation>
          <bpmn:categoryValueRef>Vier_Wege_fuer_eingehende_Fallaktionen_CATEGORY_VALUE</bpmn:categoryValueRef>
          <bpmn:incoming>Welche_Fallaktion_XOR_zu_Fall_abschliessen_SUBPROCESS_FLOW</bpmn:incoming>
          <bpmn:outgoing>Fall_abschliessen_SUBPROCESS_zu_Aktion_verarbeitet_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
          <bpmn:startEvent id="Fall_abschliessen_starten_START">
            <bpmn:outgoing>Fall_abschliessen_starten_zu_In_welcher_Fallphase_XOR_FLOW</bpmn:outgoing>
          </bpmn:startEvent>
          <bpmn:sequenceFlow id="Fall_abschliessen_starten_zu_In_welcher_Fallphase_XOR_FLOW" sourceRef="Fall_abschliessen_starten_START" targetRef="In_welcher_Fallphase_XOR" />
          <bpmn:exclusiveGateway id="In_welcher_Fallphase_XOR" name="In welcher Fallphase?" gatewayDirection="Diverging" default="In_welcher_Fallphase_zu_Unbekannte_Aktion_Fall_abschliessen_FLOW">
            <bpmn:incoming>Fall_abschliessen_starten_zu_In_welcher_Fallphase_XOR_FLOW</bpmn:incoming>
            <bpmn:outgoing>In_welcher_Fallphase_zu_Fall_in_Abklaerung_abschliessen_FLOW</bpmn:outgoing>
            <bpmn:outgoing>In_welcher_Fallphase_zu_Fall_in_Mieterwartephase_abschliessen_FLOW</bpmn:outgoing>
            <bpmn:outgoing>In_welcher_Fallphase_zu_Unbekannte_Aktion_Fall_abschliessen_FLOW</bpmn:outgoing>
          </bpmn:exclusiveGateway>
          <bpmn:subProcess id="Fall_in_Abklaerung_abschliessen_SUBPROCESS" name="Fall in Abklaerung abschliessen">
            <bpmn:documentation>FALL-06 Übergang 30 / FALL-AK-36. Nicht unterbrechender interner Mitarbeitereingang. Erst erfolgreicher Abschlusscommit beendet den aktiven Fallbereich; unberechtigte oder veraltete Aufträge verändern den aktuellen Pfad nicht. Keine offene Mitarbeiter-User-Task erfinden. Auftrag und Ergebnis lokal halten, an Fall und führenden Durchlauf binden.</bpmn:documentation>
            <bpmn:extensionElements>
              <zeebe:ioMapping>
                <zeebe:input source="= clarificationClosureCommandRef" target="clarificationClosureCommandRef" />
                <zeebe:input source="= null" target="clarificationClosureOutcome" />
              </zeebe:ioMapping>
            </bpmn:extensionElements>
            <bpmn:categoryValueRef>Abschluss_aus_zwei_Fallphasen_CATEGORY_VALUE</bpmn:categoryValueRef>
            <bpmn:incoming>In_welcher_Fallphase_zu_Fall_in_Abklaerung_abschliessen_FLOW</bpmn:incoming>
            <bpmn:outgoing>Fall_in_Abklaerung_zu_Fall_abschliessen_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
            <bpmn:startEvent id="Mitarbeiter_bestaetigt_Abschluss_Fall_in_Abklaerung_abschliessen_START" name="Mitarbeiter bestaetigt Abschluss">
              <bpmn:outgoing>Mitarbeiter_bestaetigt_Abschluss_zu_Abschluss_in_Abklaerung_speichern_FLOW</bpmn:outgoing>
            </bpmn:startEvent>
            <bpmn:serviceTask id="Abschluss_in_Abklaerung_speichern_SERVICE" name="Abschluss in Abklaerung speichern">
              <bpmn:documentation>FALL-06 Übergang 30: denselben fachlichen Mitarbeiter-Abschlussvertrag wie Close verwenden, keine abweichende Abschlusslogik. Berechtigung, führenden Durchlauf, Status In Abklärung und vom Mitarbeiter bestätigten aktuellen Fallstand einschliesslich neuer Nachrichten und Prüfhinweise prüfen. Prüfung und Speicherung atomar gegen konkurrierende Änderungen absichern. Kein Warten auf LLM, keine Nachricht, kein Kommentar, kein Versandauftrag. Erfolgreicher Commit speichert Abgeschlossen, beendet Antwortbedarf, auditiert die bewusste Entscheidung und entzieht allen alten Jobs die Schreibfreigabe. Bereits gespeicherte Nachrichten samt Mailpflichten erhalten. Bei fachlichem Konflikt Ergebnis ABGELEHNT: keine Speicherung, aktuellen Stand anzeigen, erneute Mitarbeiterentscheidung nötig; keine automatische Aktualisierung der alten Zustimmung. Technischer Fehler bleibt Retry/Incident. Identischer bereits erfolgreicher Auftrag ist Erfolg, muss aber zum ursprünglichen Durchlauf gehören und darf keine Wiedereröffnung beenden. Abschlusscommit und zuverlässige Prozessfortsetzung koordinieren; Runtime noch nicht implementiert.</bpmn:documentation>
              <bpmn:extensionElements>
                <zeebe:taskDefinition type="propertyflow.clarification.close" />
              </bpmn:extensionElements>
              <bpmn:incoming>Mitarbeiter_bestaetigt_Abschluss_zu_Abschluss_in_Abklaerung_speichern_FLOW</bpmn:incoming>
              <bpmn:outgoing>Abschluss_in_Abklaerung_zu_Abschluss_gespeichert_XOR_FLOW</bpmn:outgoing>
            </bpmn:serviceTask>
            <bpmn:exclusiveGateway id="Abschluss_gespeichert_XOR" name="Abschluss&#10;gespeichert?">
              <bpmn:incoming>Abschluss_in_Abklaerung_zu_Abschluss_gespeichert_XOR_FLOW</bpmn:incoming>
              <bpmn:outgoing>Abschluss_gespeichert_XOR_Ja_identischer_Erfolg_zu_Gespeichert_aktive_Bearbeitung_beenden_FLOW</bpmn:outgoing>
              <bpmn:outgoing>Abschluss_gespeichert_XOR_Nein_Konflikt_nicht_zulaessig_zu_Nicht_abgeschlossen_Aktuellen_Stand_FLOW</bpmn:outgoing>
            </bpmn:exclusiveGateway>
            <bpmn:endEvent id="Gespeichert_aktive_Bearbeitung_beenden_END" name="Gespeichert: aktive&#10;Bearbeitung beenden">
              <bpmn:documentation>Erfolgssignal, kein fachlicher Fehler. Das unterbrechende Eskalations-Randereignis am umschliessenden ActiveCase beendet dessen Aktivitäten und alle Nebenpfade. Erst nach gesichertem Abschluss auslösen. Zuverlässige Wiederaufnahme nach Commit und vor diesem Ereignis ist vor ausführbarer Fassung nachzuweisen.</bpmn:documentation>
              <bpmn:incoming>Abschluss_gespeichert_XOR_Ja_identischer_Erfolg_zu_Gespeichert_aktive_Bearbeitung_beenden_FLOW</bpmn:incoming>
              <bpmn:escalationEventDefinition id="Gespeichert_aktive_Bearbeitung_beenden_END_ESCALATION_DEF" escalationRef="Mitarbeiterabschluss_aus_Abklaerung_gespeichert_ESCALATION" />
            </bpmn:endEvent>
            <bpmn:endEvent id="Nicht_abgeschlossen_Aktuellen_Stand_erneut_entscheiden_END" name="Nicht abgeschlossen&#10;Aktuellen Stand erneut entscheiden">
              <bpmn:incoming>Abschluss_gespeichert_XOR_Nein_Konflikt_nicht_zulaessig_zu_Nicht_abgeschlossen_Aktuellen_Stand_FLOW</bpmn:incoming>
            </bpmn:endEvent>
            <bpmn:sequenceFlow id="Mitarbeiter_bestaetigt_Abschluss_zu_Abschluss_in_Abklaerung_speichern_FLOW" sourceRef="Mitarbeiter_bestaetigt_Abschluss_Fall_in_Abklaerung_abschliessen_START" targetRef="Abschluss_in_Abklaerung_speichern_SERVICE" />
            <bpmn:sequenceFlow id="Abschluss_in_Abklaerung_zu_Abschluss_gespeichert_XOR_FLOW" sourceRef="Abschluss_in_Abklaerung_speichern_SERVICE" targetRef="Abschluss_gespeichert_XOR" />
            <bpmn:sequenceFlow id="Abschluss_gespeichert_XOR_Ja_identischer_Erfolg_zu_Gespeichert_aktive_Bearbeitung_beenden_FLOW" name="Ja / identischer Erfolg" sourceRef="Abschluss_gespeichert_XOR" targetRef="Gespeichert_aktive_Bearbeitung_beenden_END">
              <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clarificationClosureOutcome = "APPLIED"</bpmn:conditionExpression>
            </bpmn:sequenceFlow>
            <bpmn:sequenceFlow id="Abschluss_gespeichert_XOR_Nein_Konflikt_nicht_zulaessig_zu_Nicht_abgeschlossen_Aktuellen_Stand_FLOW" name="Nein: Konflikt / nicht zulaessig" sourceRef="Abschluss_gespeichert_XOR" targetRef="Nicht_abgeschlossen_Aktuellen_Stand_erneut_entscheiden_END">
              <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clarificationClosureOutcome = "REJECTED"</bpmn:conditionExpression>
            </bpmn:sequenceFlow>
            <bpmn:textAnnotation id="Der_aktive_Bereich_endet_erst_NOTE">
              <bpmn:text>Der aktive Bereich endet erst, nachdem der Mitarbeiterabschluss
geprüft und gespeichert wurde.</bpmn:text>
            </bpmn:textAnnotation>
          </bpmn:subProcess>
          <bpmn:sequenceFlow id="In_welcher_Fallphase_zu_Fall_in_Abklaerung_abschliessen_FLOW" sourceRef="In_welcher_Fallphase_XOR" targetRef="Fall_in_Abklaerung_abschliessen_SUBPROCESS">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= actionType = "CLOSE_CLARIFICATION"</bpmn:conditionExpression>
          </bpmn:sequenceFlow>
          <bpmn:sequenceFlow id="Fall_in_Abklaerung_zu_Fall_abschliessen_zusammenfuehren_XOR_FLOW" sourceRef="Fall_in_Abklaerung_abschliessen_SUBPROCESS" targetRef="Fall_abschliessen_zusammenfuehren_XOR" />
          <bpmn:subProcess id="Fall_in_Mieterwartephase_abschliessen_SUBPROCESS" name="Fall in Mieterwartephase abschliessen">
            <bpmn:documentation>
    Nicht unterbrechender Auftragseingang. Keine vorgängige Aufhebung des Antwortbedarfs nötig. Dieser Eingang gilt ausschliesslich für den aktuellen Reply-Call bei Wartet auf Mieterantwort; bestehende Abschlussaktionen anderer Phasen bleiben unverändert. Auftragsdaten lokal halten.</bpmn:documentation>
            <bpmn:extensionElements>
              <zeebe:ioMapping>
                <zeebe:input source="= replyClosureCommandRef" target="replyClosureCommandRef" />
                <zeebe:input source="= null" target="replyClosureOutcome" />
              </zeebe:ioMapping>
            </bpmn:extensionElements>
            <bpmn:categoryValueRef>Abschluss_aus_zwei_Fallphasen_CATEGORY_VALUE</bpmn:categoryValueRef>
            <bpmn:incoming>In_welcher_Fallphase_zu_Fall_in_Mieterwartephase_abschliessen_FLOW</bpmn:incoming>
            <bpmn:outgoing>Fall_in_Mieterwartephase_zu_Fall_abschliessen_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
            <bpmn:startEvent id="Mitarbeiter_bestaetigt_Abschluss_Fall_in_Mieterwartephase_abschliessen_START" name="Mitarbeiter bestaetigt Abschluss">
              <bpmn:outgoing>Mitarbeiter_bestaetigt_Abschluss_zu_Abschlussauftrag_pruefen_SERVICE_FLOW</bpmn:outgoing>
            </bpmn:startEvent>
            <bpmn:serviceTask id="Abschlussauftrag_pruefen_SERVICE" name="Abschlussauftrag pruefen">
              <bpmn:documentation>
    Berechtigte Mitarbeiteridentität, bestätigten fachlichen Fallstand, Status Wartet auf Mieterantwort, führende Instanz und aktuellen Reply-Call serverseitig prüfen. Keine offene Mitarbeiter-User-Task erfinden: Autorisierung bindet hier an den aktuellen Warteaufruf. Unberechtigter, veralteter oder inzwischen anders zugeordneter Auftrag wird ohne Unterbrechung abgelehnt. Gültige Entscheidung mit Quelle Mitarbeiter, Auftragsschlüssel und Call-Bezug dauerhaft nachweisen. Keine neue KI-Auswertung, keine Nachricht und kein Kommentar erforderlich. Technischer Fehler bleibt Retry/Incident. Wiederholung eines bereits gespeicherten identischen Abschlusses als Erfolg ohne neue Wirkung behandeln, nicht als neuen Auftrag übernehmen.</bpmn:documentation>
              <bpmn:extensionElements>
                <zeebe:taskDefinition type="propertyflow.reply-closure.check" />
              </bpmn:extensionElements>
              <bpmn:incoming>Mitarbeiter_bestaetigt_Abschluss_zu_Abschlussauftrag_pruefen_SERVICE_FLOW</bpmn:incoming>
              <bpmn:outgoing>Abschlussauftrag_pruefen_SERVICE_zu_Auftrag_uebernommen_XOR_FLOW</bpmn:outgoing>
            </bpmn:serviceTask>
            <bpmn:exclusiveGateway id="Auftrag_uebernommen_XOR" name="Auftrag&#10;uebernommen?">
              <bpmn:incoming>Abschlussauftrag_pruefen_SERVICE_zu_Auftrag_uebernommen_XOR_FLOW</bpmn:incoming>
              <bpmn:outgoing>Auftrag_uebernommen_XOR_Ja_zu_Abschluss_im_Mieterwarten_bereitstellen_FLOW</bpmn:outgoing>
              <bpmn:outgoing>Auftrag_uebernommen_XOR_Nein_Konflikt_nicht_zulaessig_zu_Abgelehnt_Aktueller_Pfad_bleibt_FLOW</bpmn:outgoing>
            </bpmn:exclusiveGateway>
            <bpmn:serviceTask id="Abschluss_im_Mieterwarten_bereitstellen_SERVICE" name="Abschluss im Mieterwarten&#10;bereitstellen">
              <bpmn:documentation>
    Persistierten Entscheidungsbezug samt Quelle Mitarbeiter und aktuellem Call-Bezug zuverlässig bereitstellen. Marker und Unterbrechung atomar gegen Call-Wechsel, manuelles Aufheben, neue Fragen, automatische Veröffentlichung und Fallabschluss abstimmen. Nach Übernahme geänderte fachliche Grundlage führt über Close zur Mitarbeiterprüfung, niemals stillschweigend die alte Bestätigung aktualisieren. Eine andere bereits aktive Bearbeitung nicht abbrechen. Technische Koordination bleibt offen.</bpmn:documentation>
              <bpmn:extensionElements>
                <zeebe:taskDefinition type="propertyflow.reply-closure.signal" />
              </bpmn:extensionElements>
              <bpmn:incoming>Auftrag_uebernommen_XOR_Ja_zu_Abschluss_im_Mieterwarten_bereitstellen_FLOW</bpmn:incoming>
              <bpmn:outgoing>Abschluss_im_Mieterwarten_zu_Nur_Auftrag_bereitgestellt_END_FLOW</bpmn:outgoing>
            </bpmn:serviceTask>
            <bpmn:endEvent id="Abgelehnt_Aktueller_Pfad_bleibt_END" name="Abgelehnt&#10;Aktueller Pfad bleibt">
              <bpmn:incoming>Auftrag_uebernommen_XOR_Nein_Konflikt_nicht_zulaessig_zu_Abgelehnt_Aktueller_Pfad_bleibt_FLOW</bpmn:incoming>
            </bpmn:endEvent>
            <bpmn:endEvent id="Nur_Auftrag_bereitgestellt_END" name="Nur Auftrag bereitgestellt">
              <bpmn:incoming>Abschluss_im_Mieterwarten_zu_Nur_Auftrag_bereitgestellt_END_FLOW</bpmn:incoming>
            </bpmn:endEvent>
            <bpmn:sequenceFlow id="Mitarbeiter_bestaetigt_Abschluss_zu_Abschlussauftrag_pruefen_SERVICE_FLOW" name="" sourceRef="Mitarbeiter_bestaetigt_Abschluss_Fall_in_Mieterwartephase_abschliessen_START" targetRef="Abschlussauftrag_pruefen_SERVICE" />
            <bpmn:sequenceFlow id="Abschlussauftrag_pruefen_SERVICE_zu_Auftrag_uebernommen_XOR_FLOW" name="" sourceRef="Abschlussauftrag_pruefen_SERVICE" targetRef="Auftrag_uebernommen_XOR" />
            <bpmn:sequenceFlow id="Auftrag_uebernommen_XOR_Ja_zu_Abschluss_im_Mieterwarten_bereitstellen_FLOW" name="Ja" sourceRef="Auftrag_uebernommen_XOR" targetRef="Abschluss_im_Mieterwarten_bereitstellen_SERVICE">
              <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyClosureOutcome = "ACCEPTED"</bpmn:conditionExpression>
            </bpmn:sequenceFlow>
            <bpmn:sequenceFlow id="Auftrag_uebernommen_XOR_Nein_Konflikt_nicht_zulaessig_zu_Abgelehnt_Aktueller_Pfad_bleibt_FLOW" name="Nein: Konflikt / nicht zulaessig" sourceRef="Auftrag_uebernommen_XOR" targetRef="Abgelehnt_Aktueller_Pfad_bleibt_END">
              <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyClosureOutcome = "REJECTED"</bpmn:conditionExpression>
            </bpmn:sequenceFlow>
            <bpmn:sequenceFlow id="Abschluss_im_Mieterwarten_zu_Nur_Auftrag_bereitgestellt_END_FLOW" name="" sourceRef="Abschluss_im_Mieterwarten_bereitstellen_SERVICE" targetRef="Nur_Auftrag_bereitgestellt_END" />
            <bpmn:textAnnotation id="PropertyFlow_prueft_den_Auftrag_am_NOTE">
              <bpmn:text>PropertyFlow prüft den Auftrag am aktuellen Fallstand.
Ein gültiger Abschluss wird dem wartenden Prozess übergeben.</bpmn:text>
            </bpmn:textAnnotation>
          </bpmn:subProcess>
          <bpmn:sequenceFlow id="In_welcher_Fallphase_zu_Fall_in_Mieterwartephase_abschliessen_FLOW" sourceRef="In_welcher_Fallphase_XOR" targetRef="Fall_in_Mieterwartephase_abschliessen_SUBPROCESS">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= actionType = "CLOSE_REPLY"</bpmn:conditionExpression>
          </bpmn:sequenceFlow>
          <bpmn:sequenceFlow id="Fall_in_Mieterwartephase_zu_Fall_abschliessen_zusammenfuehren_XOR_FLOW" sourceRef="Fall_in_Mieterwartephase_abschliessen_SUBPROCESS" targetRef="Fall_abschliessen_zusammenfuehren_XOR" />
          <bpmn:exclusiveGateway id="Fall_abschliessen_zusammenfuehren_XOR" gatewayDirection="Converging">
            <bpmn:incoming>Fall_in_Abklaerung_zu_Fall_abschliessen_zusammenfuehren_XOR_FLOW</bpmn:incoming>
            <bpmn:incoming>Fall_in_Mieterwartephase_zu_Fall_abschliessen_zusammenfuehren_XOR_FLOW</bpmn:incoming>
            <bpmn:outgoing>Fall_abschliessen_zusammenfuehren_zu_Fall_abschliessen_beenden_END_FLOW</bpmn:outgoing>
          </bpmn:exclusiveGateway>
          <bpmn:endEvent id="Fall_abschliessen_beenden_END">
            <bpmn:incoming>Fall_abschliessen_zusammenfuehren_zu_Fall_abschliessen_beenden_END_FLOW</bpmn:incoming>
          </bpmn:endEvent>
          <bpmn:sequenceFlow id="Fall_abschliessen_zusammenfuehren_zu_Fall_abschliessen_beenden_END_FLOW" sourceRef="Fall_abschliessen_zusammenfuehren_XOR" targetRef="Fall_abschliessen_beenden_END" />
          <bpmn:endEvent id="Unbekannte_Aktion_Fall_abschliessen_END" name="Unbekannte Aktion">
            <bpmn:incoming>In_welcher_Fallphase_zu_Unbekannte_Aktion_Fall_abschliessen_FLOW</bpmn:incoming>
            <bpmn:errorEventDefinition id="Unbekannte_Aktion_Fall_abschliessen_END_ERROR_DEF" errorRef="Unbekannte_Fallaktion_ERROR" />
          </bpmn:endEvent>
          <bpmn:sequenceFlow id="In_welcher_Fallphase_zu_Unbekannte_Aktion_Fall_abschliessen_FLOW" sourceRef="In_welcher_Fallphase_XOR" targetRef="Unbekannte_Aktion_Fall_abschliessen_END" />
          <bpmn:group id="Abschluss_aus_zwei_Fallphasen_GROUP" categoryValueRef="Abschluss_aus_zwei_Fallphasen_CATEGORY_VALUE" />
          <bpmn:textAnnotation id="Die_aktuelle_Fallphase_bestimmt_NOTE">
            <bpmn:text>Die aktuelle Fallphase bestimmt,
wo der Abschluss bestätigt wird.</bpmn:text>
          </bpmn:textAnnotation>
        </bpmn:subProcess>
        <bpmn:sequenceFlow id="Welche_Fallaktion_XOR_zu_Fall_abschliessen_SUBPROCESS_FLOW" sourceRef="Welche_Fallaktion_XOR" targetRef="Fall_abschliessen_SUBPROCESS">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= actionType = "CLOSE_CLARIFICATION" or actionType = "CLOSE_REPLY"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Fall_abschliessen_SUBPROCESS_zu_Aktion_verarbeitet_zusammenfuehren_XOR_FLOW" sourceRef="Fall_abschliessen_SUBPROCESS" targetRef="Aktion_verarbeitet_zusammenfuehren_XOR" />
        <bpmn:exclusiveGateway id="Aktion_verarbeitet_zusammenfuehren_XOR" gatewayDirection="Converging">
          <bpmn:incoming>Mieternachricht_mit_LLM_zu_Aktion_verarbeitet_zusammenfuehren_XOR_FLOW</bpmn:incoming>
          <bpmn:incoming>Mitarbeiteraktion_ausfuehren_SUBPROCESS_zu_Aktion_verarbeitet_zusammenfuehren_XOR_FLOW</bpmn:incoming>
          <bpmn:incoming>Neuen_Pruefbedarf_bearbeiten_zu_Aktion_verarbeitet_zusammenfuehren_XOR_FLOW</bpmn:incoming>
          <bpmn:incoming>Fall_abschliessen_SUBPROCESS_zu_Aktion_verarbeitet_zusammenfuehren_XOR_FLOW</bpmn:incoming>
          <bpmn:outgoing>Aktion_verarbeitet_zusammenfuehren_zu_Aktion_verarbeitet_END_FLOW</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="Aktion_verarbeitet_END" name="Aktion verarbeitet">
          <bpmn:incoming>Aktion_verarbeitet_zusammenfuehren_zu_Aktion_verarbeitet_END_FLOW</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Auf_Fallaktion_warten_zu_Welche_Fallaktion_XOR_FLOW" sourceRef="Auf_Fallaktion_warten_START" targetRef="Welche_Fallaktion_XOR" />
        <bpmn:sequenceFlow id="Welche_Fallaktion_XOR_zu_Mieternachricht_mit_LLM_verarbeiten_FLOW" sourceRef="Welche_Fallaktion_XOR" targetRef="Mieternachricht_mit_LLM_verarbeiten_SUBPROCESS">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= actionType = "TENANT_MESSAGE"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Mieternachricht_mit_LLM_zu_Aktion_verarbeitet_zusammenfuehren_XOR_FLOW" sourceRef="Mieternachricht_mit_LLM_verarbeiten_SUBPROCESS" targetRef="Aktion_verarbeitet_zusammenfuehren_XOR" />
        <bpmn:sequenceFlow id="Welche_Fallaktion_XOR_zu_Neuen_Pruefbedarf_bearbeiten_SUBPROCESS_FLOW" sourceRef="Welche_Fallaktion_XOR" targetRef="Neuen_Pruefbedarf_bearbeiten_SUBPROCESS">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= actionType = "REVIEW_REQUIRED"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Neuen_Pruefbedarf_bearbeiten_zu_Aktion_verarbeitet_zusammenfuehren_XOR_FLOW" sourceRef="Neuen_Pruefbedarf_bearbeiten_SUBPROCESS" targetRef="Aktion_verarbeitet_zusammenfuehren_XOR" />
        <bpmn:sequenceFlow id="Aktion_verarbeitet_zusammenfuehren_zu_Aktion_verarbeitet_END_FLOW" sourceRef="Aktion_verarbeitet_zusammenfuehren_XOR" targetRef="Aktion_verarbeitet_END" />
        <bpmn:textAnnotation id="Naechste_Fallaktion_NOTE">
          <bpmn:text>Nächste Fallaktion
Der Empfang bleibt während der Verarbeitung offen.</bpmn:text>
        </bpmn:textAnnotation>
        <bpmn:association id="Aktionsrundlauf_Hinweis_ASSOCIATION" associationDirection="One" sourceRef="Aktion_verarbeitet_END" targetRef="Auf_Fallaktion_warten_START" />
        <bpmn:group id="Vier_Wege_fuer_eingehende_Fallaktionen_GROUP" categoryValueRef="Vier_Wege_fuer_eingehende_Fallaktionen_CATEGORY_VALUE" />
      </bpmn:subProcess>
      <bpmn:startEvent id="Empfangsbereich_aktiv_START" name="Empfangsbereich aktiv">
        <bpmn:categoryValueRef>Fallstart_und_Wiedereroeffnung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:outgoing>Empfangsbereich_aktiv_START_zu_Erstanlage_oder_Wiedereroeffnung_XOR_FLOW</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Fuehrenden_Prozess_zuordnen_SERVICE" name="Fuehrenden Prozess zuordnen">
        <bpmn:documentation>ADR-002: processInstanceKey und Erledigung des Startauftrags gemeinsam speichern. Gleiche Instanz idempotent bestätigen, abweichende Instanz nicht weiterbearbeiten. Bis zum Commit bleibt Eingegangen. Die zentrale Nachrichten-Subscription ist beim Start dieses Jobs bereits aktiv. Die vorgelagerte Bereitstellung des Korrelationswerts allein aktiviert den Fall nicht.
Nur Erstanlage. Eine Wiedereröffnung darf ausschliesslich ReopenCase zuordnen; keine allgemeine Erlaubnis zum Überschreiben einer führenden Instanz.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="propertyflow-register-case" />
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>Fallstart_und_Wiedereroeffnung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Erstanlage_oder_Wiedereroeffnung_Erstanlage_zu_Fuehrenden_Prozess_zuordnen_SERVICE_FLOW</bpmn:incoming>
        <bpmn:outgoing>Fuehrenden_Prozess_zuordnen_zu_Erste_Abklaerung_vorbereiten_SERVICE_FLOW</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Auf_ausgewertete_Mieterantwort_warten_zusammenfuehren_XOR" gatewayDirection="Converging">
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Fortsetzung_Aktiven_Fall_Rueckfrage_veroeffentlicht_zu_Auf_ausgewertete_Mieterantwort_warten_FLOW</bpmn:incoming>
        <bpmn:incoming>Naechste_Fallphase_XOR_Erneut_warten_zu_Auf_ausgewertete_Mieterantwort_warten_FLOW</bpmn:incoming>
        <bpmn:incoming>Fortsetzung_Aktiven_Fall_Auf_Mieterantwort_warten_zu_Auf_ausgewertete_Mieterantwort_warten_FLOW</bpmn:incoming>
        <bpmn:outgoing>Auf_ausgewertete_Mieterantwort_zu_Auf_ausgewertete_Mieterantwort_warten_FLOW</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:callActivity id="Auf_ausgewertete_Mieterantwort_warten_CALL" name="Auf ausgewertete&#10;Mieterantwort warten">
        <bpmn:documentation>
Ruft mieterantwort-pruefen.bpmn auf. Vertrag: teilprozess-vertraege.md. Untergeordnete Instanz mit eigenem Scope; führende Fallzuordnung bleibt im Hauptprozess. Eingangsreferenz vor Aktivierung bereitstellen. Nur explizite Outputs übernehmen; aktueller Fallstand bleibt vor Wirkung zu prüfen.
Bei bestätigter Terminsetzung unterbricht ReplyExit den gesamten Call und übergibt an die Wiedervorlage. Laufende Auswertungen verlieren bereits ab Commit die Wirkungsfreigabe; offene Fragen bleiben erhalten. Marker gilt nur für den betroffenen Aufruf und muss auch den Übergang zu Folgeschritten zuverlässig abdecken.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:calledElement processId="Mieterantwort_pruefen_PROCESS" propagateAllChildVariables="false" propagateAllParentVariables="false" bindingType="deployment" />
          <zeebe:ioMapping>
            <zeebe:input source="= caseId" target="caseId" />
            <zeebe:input source="= processInstanceKey" target="leadingProcessInstanceKey" />
            <zeebe:input source="= replyEntryContextRef" target="entryContextRef" />
            <zeebe:input source="= staffEntryContextRef" target="staffEntryContextRef" />
            <zeebe:output source="= outcome" target="replyOutcome" />
            <zeebe:output source="= decisionRef" target="replyDecisionRef" />
            <zeebe:output source="= if outcome = &#34;REVIEW&#34; then decisionRef else staffEntryContextRef" target="staffEntryContextRef" />
            <zeebe:output source="= &#34;ANSWER&#34;" target="replyContinuationSource" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Auf_ausgewertete_Mieterantwort_zu_Auf_ausgewertete_Mieterantwort_warten_FLOW</bpmn:incoming>
        <bpmn:outgoing>Auf_ausgewertete_Mieterantwort_Antwort_ausgewertet_zu_Fortsetzung_bestimmen_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="Auf_ausgewertete_Mieterantwort_zu_Auf_ausgewertete_Mieterantwort_warten_FLOW" sourceRef="Auf_ausgewertete_Mieterantwort_warten_zusammenfuehren_XOR" targetRef="Auf_ausgewertete_Mieterantwort_warten_CALL">
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:intermediateThrowEvent id="Fortsetzung_pruefen_Aktiven_Fall_bearbeiten_THROW" name="Fortsetzung pruefen">
        <bpmn:categoryValueRef>LLM_Abklaerung_und_Systementscheid_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Uebergabe_abgeloest_BOUNDARY_zu_Fortsetzung_pruefen_Aktiven_Fall_FLOW</bpmn:incoming>
        <bpmn:linkEventDefinition id="Fortsetzung_pruefen_Aktiven_Fall_bearbeiten_THROW_LINK_DEF" name="REPLY_CONTINUATION" />
      </bpmn:intermediateThrowEvent>
      <bpmn:intermediateCatchEvent id="Fortsetzung_pruefen_CATCH" name="Fortsetzung pruefen">
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:outgoing>Fortsetzung_pruefen_CATCH_zu_Fortsetzung_bestimmen_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
        <bpmn:linkEventDefinition id="Fortsetzung_pruefen_CATCH_LINK_DEF" name="REPLY_CONTINUATION" />
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Fortsetzung_pruefen_CATCH_zu_Fortsetzung_bestimmen_zusammenfuehren_XOR_FLOW" sourceRef="Fortsetzung_pruefen_CATCH" targetRef="Fortsetzung_bestimmen_zusammenfuehren_XOR">
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:exclusiveGateway id="Fortsetzung_bestimmen_zusammenfuehren_XOR" gatewayDirection="Converging">
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Auf_ausgewertete_Mieterantwort_Antwort_ausgewertet_zu_Fortsetzung_bestimmen_zusammenfuehren_XOR_FLOW</bpmn:incoming>
        <bpmn:incoming>Wartephase_abgeloest_BOUNDARY_zu_Fortsetzung_bestimmen_zusammenfuehren_XOR_FLOW</bpmn:incoming>
        <bpmn:incoming>Fortsetzung_pruefen_CATCH_zu_Fortsetzung_bestimmen_zusammenfuehren_XOR_FLOW</bpmn:incoming>
        <bpmn:outgoing>Fortsetzung_bestimmen_zusammenfuehren_zu_Fortsetzung_bestimmen_SUBPROCESS_FLOW</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Fortsetzung_bestimmen_zusammenfuehren_zu_Fortsetzung_bestimmen_SUBPROCESS_FLOW" sourceRef="Fortsetzung_bestimmen_zusammenfuehren_XOR" targetRef="Fortsetzung_bestimmen_SUBPROCESS">
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
      </bpmn:sequenceFlow>
      <bpmn:subProcess id="Fortsetzung_bestimmen_SUBPROCESS" name="Fortsetzung bestimmen">
        <bpmn:documentation>Details nach ausgewerteter Mieterantwort oder bestätigter Ablösung. Die mit der Automatik geteilten Prüfaufgaben stehen hier jeweils einmal. Jeder Einstieg liefert seine Herkunft explizit; nur der nächste grobe Fallabschnitt wird für das Hauptbild zusammengefasst.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="= null" target="replyContinuationOutcome" />
            <zeebe:output source="= replyContinuationOutcome" target="replyContinuationOutcome" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:categoryValueRef>Mieterwartephase_und_Fortsetzung_CATEGORY_VALUE</bpmn:categoryValueRef>
        <bpmn:incoming>Fortsetzung_bestimmen_zusammenfuehren_zu_Fortsetzung_bestimmen_SUBPROCESS_FLOW</bpmn:incoming>
        <bpmn:outgoing>Fortsetzung_bestimmen_SUBPROCESS_zu_Naechste_Fallphase_XOR_FLOW</bpmn:outgoing>
        <bpmn:startEvent id="Fortsetzung_bestimmen_starten_START">
          <bpmn:outgoing>Fortsetzung_bestimmen_starten_zu_Was_ist_eingetroffen_XOR_FLOW</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="Fortsetzung_bestimmen_starten_zu_Was_ist_eingetroffen_XOR_FLOW" sourceRef="Fortsetzung_bestimmen_starten_START" targetRef="Was_ist_eingetroffen_XOR" />
        <bpmn:exclusiveGateway id="Was_ist_eingetroffen_XOR" name="Was ist eingetroffen?" gatewayDirection="Diverging">
          <bpmn:incoming>Fortsetzung_bestimmen_starten_zu_Was_ist_eingetroffen_XOR_FLOW</bpmn:incoming>
          <bpmn:outgoing>Was_ist_eingetroffen_Mieterantwort_ausgewertet_zu_Wie_geht_der_Fall_FLOW</bpmn:outgoing>
          <bpmn:outgoing>Was_ist_eingetroffen_Wartephase_abgeloest_zu_Warum_endet_das_Warten_FLOW</bpmn:outgoing>
          <bpmn:outgoing>Was_ist_eingetroffen_Antwortbedarf_bei_Uebergabe_aufgehoben_zu_Fortsetzung_ohne_Antwortbedarf_pruefen_FLOW</bpmn:outgoing>
          <bpmn:outgoing>Was_ist_eingetroffen_Automatik_abgeloest_zu_Bestaetigte_Abloesung_pruefen_zusammenfuehren_FLOW</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="Was_ist_eingetroffen_Mieterantwort_ausgewertet_zu_Wie_geht_der_Fall_FLOW" name="Mieterantwort ausgewertet" sourceRef="Was_ist_eingetroffen_XOR" targetRef="Wie_geht_der_Fall_weiter_XOR">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyContinuationSource = "ANSWER"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Was_ist_eingetroffen_Wartephase_abgeloest_zu_Warum_endet_das_Warten_FLOW" name="Wartephase abgeloest" sourceRef="Was_ist_eingetroffen_XOR" targetRef="Warum_endet_das_Warten_XOR">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyContinuationSource = "INTERRUPTED"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Was_ist_eingetroffen_Antwortbedarf_bei_Uebergabe_aufgehoben_zu_Fortsetzung_ohne_Antwortbedarf_pruefen_FLOW" name="Antwortbedarf bei Uebergabe aufgehoben" sourceRef="Was_ist_eingetroffen_XOR" targetRef="Fortsetzung_ohne_Antwortbedarf_pruefen_zusammenfuehren_XOR">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyContinuationSource = "CLEAR"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Was_ist_eingetroffen_Automatik_abgeloest_zu_Bestaetigte_Abloesung_pruefen_zusammenfuehren_FLOW" name="Automatik abgeloest" sourceRef="Was_ist_eingetroffen_XOR" targetRef="Bestaetigte_Abloesung_pruefen_zusammenfuehren_XOR">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyContinuationSource = "AUTOMATIC"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:exclusiveGateway id="Wie_geht_der_Fall_weiter_XOR" name="Wie geht der Fall weiter?">
          <bpmn:documentation>
  Nur das aktuell geprüfte Fortsetzungsergebnis verwenden; genau einen Ausgang wählen. Keine erneute eigene Klassifikation oder Bewertung. FEEL-Ergebniswerte noch festzulegen.
  Nach Call-Rückkehr ausschliesslich replyOutcome / replyDecisionRef auswerten. Unbekannte oder fehlende Rückgabe ist technischer Vertragsfehler, kein Default-Fachentscheid. Aktuellen Fallstand und Aufrufzuordnung prüfen. Werte und Zuweisungen stehen in teilprozess-vertraege.md; FEEL-Routing weiterhin nicht ausführbar.</bpmn:documentation>
          <bpmn:incoming>Was_ist_eingetroffen_Mieterantwort_ausgewertet_zu_Wie_geht_der_Fall_FLOW</bpmn:incoming>
          <bpmn:outgoing>Wie_geht_der_Antwortbedarf_offen_erneut_warten_zu_Erneut_warten_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
          <bpmn:outgoing>Wie_geht_der_Pruefung_erforderlich_zu_Mitarbeiterbearbeitung_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
          <bpmn:outgoing>Wie_geht_der_Weitere_Katalogfrage_zulaessig_zu_Erneute_Katalogrueckfrage_vorbereiten_SERVICE_FLOW</bpmn:outgoing>
          <bpmn:outgoing>Wie_geht_der_Systemabschluss_vorgeschlagen_zu_Automatischen_Abschluss_vorbereiten_SERVICE_FLOW</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:exclusiveGateway id="Warum_endet_das_Warten_XOR" name="Warum endet das Warten?" gatewayDirection="Diverging">
          <bpmn:incoming>Was_ist_eingetroffen_Wartephase_abgeloest_zu_Warum_endet_das_Warten_FLOW</bpmn:incoming>
          <bpmn:outgoing>Warum_endet_das_Antwortbedarf_aufgehoben_zu_Fortsetzung_ohne_Antwortbedarf_pruefen_FLOW</bpmn:outgoing>
          <bpmn:outgoing>Warum_endet_das_Mitarbeiterabschluss_bestaetigt_zu_Mitarbeiterabschluss_pruefen_END_FLOW</bpmn:outgoing>
          <bpmn:outgoing>Warum_endet_das_Wiedervorlage_bestaetigt_zu_Wiedervorlage_Eintritt_vorbereiten_SERVICE_FLOW</bpmn:outgoing>
          <bpmn:outgoing>Warum_endet_das_Neuer_Pruefbedarf_zu_Pruefkontext_fuer_Mitarbeiter_bereitstellen_FLOW</bpmn:outgoing>
          <bpmn:outgoing>Warum_endet_das_Uebernahme_oder_Rueckfrage_bestaetigt_zu_Bestaetigte_Abloesung_pruefen_zusammenfuehren_FLOW</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:exclusiveGateway id="Fortsetzung_ohne_Antwortbedarf_pruefen_zusammenfuehren_XOR" gatewayDirection="Converging">
          <bpmn:categoryValueRef>Grund_der_Abloesung_pruefen_und_uebergeben_CATEGORY_VALUE</bpmn:categoryValueRef>
          <bpmn:incoming>Warum_endet_das_Antwortbedarf_aufgehoben_zu_Fortsetzung_ohne_Antwortbedarf_pruefen_FLOW</bpmn:incoming>
          <bpmn:incoming>Was_ist_eingetroffen_Antwortbedarf_bei_Uebergabe_aufgehoben_zu_Fortsetzung_ohne_Antwortbedarf_pruefen_FLOW</bpmn:incoming>
          <bpmn:outgoing>Fortsetzung_ohne_Antwortbedarf_zu_Fortsetzung_ohne_Antwortbedarf_pruefen_FLOW</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="Fortsetzung_ohne_Antwortbedarf_pruefen_SERVICE" name="Fortsetzung ohne&#10;Antwortbedarf pruefen">
          <bpmn:documentation>BEN-03 / 0.23: Bei tatsächlicher benachrichtigungspflichtiger Änderung Ereignis und Mailpflicht dauerhaft zusammen sichern. Der dauerhafte Starter startet fallbenachrichtigung-versenden.bpmn mit mailOrderRef; dort beauftragen Camunda-Send-Tasks den Mail-Worker. Hier kein direkter SMTP-Aufruf und kein Warten auf SMTP. Unveränderte Werte und identische Wiederholungen erzeugen keine neue Mailpflicht.
  Dauerhaften Aufhebungsentscheid und aktuellen Fall-/Call-Stand laden, nicht auf Outputs des abgebrochenen Calls warten. Ohne offenen Antwortbedarf und ohne vorrangigen Prüfbedarf In Bearbeitung konsistent speichern und staffEntryContextRef für direkten SWork-Eintritt bereitstellen. Bei aktuellem Prüfbedarf Kontext für Mitarbeiterprüfung setzen. Bei inzwischen neuen offenen Fragen ohne Prüfbedarf aktuellen Reply-Kontext bereitstellen und weiter warten. Bestehende Mitarbeiter-/Wiedervorlageinstanz nicht duplizieren; überholte Aufträge dürfen keine neuere Bearbeitung verdrängen. Keine erneute KI-Analyse, keine Abschlussfreigabe. Technische Konfliktkoordination bleibt offen.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.answer.continue" />
          </bpmn:extensionElements>
          <bpmn:categoryValueRef>Grund_der_Abloesung_pruefen_und_uebergeben_CATEGORY_VALUE</bpmn:categoryValueRef>
          <bpmn:incoming>Fortsetzung_ohne_Antwortbedarf_zu_Fortsetzung_ohne_Antwortbedarf_pruefen_FLOW</bpmn:incoming>
          <bpmn:outgoing>Fortsetzung_ohne_Antwortbedarf_zu_Aktueller_Fortsetzungsweg_XOR_FLOW</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="Aktueller_Fortsetzungsweg_XOR" name="Aktueller&#10;Fortsetzungsweg">
          <bpmn:categoryValueRef>Grund_der_Abloesung_pruefen_und_uebergeben_CATEGORY_VALUE</bpmn:categoryValueRef>
          <bpmn:incoming>Fortsetzung_ohne_Antwortbedarf_zu_Aktueller_Fortsetzungsweg_XOR_FLOW</bpmn:incoming>
          <bpmn:outgoing>Aktueller_Fortsetzungsweg_XOR_In_Bearbeitung_vorrangige_Pruefung_zu_Mitarbeiterbearbeitung_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
          <bpmn:outgoing>Aktueller_Fortsetzungsweg_XOR_Neue_offene_Fragen_weiter_warten_zu_Erneut_warten_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="Pruefkontext_fuer_Mitarbeiter_bereitstellen_SERVICE" name="Pruefkontext fuer&#10;Mitarbeiter bereitstellen">
          <bpmn:documentation>
  Prüfentscheid, aktuelle führende Instanz und unterbrochenen Call verifizieren. staffEntryContextRef zur regulären Mitarbeiterprüfung bereitstellen. Eine bereits gleichzeitig entstandene Prüfung muss einmalig wiederverwendet werden; keine zweite Mitarbeiteraufgabe. Offenen Antwortbedarf nicht aufheben. Nach Abschluss oder neuerer Mitarbeiterentscheidung keine neue Wirkung. Koordination vor Ausführung implementieren.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.reply.prepare-review" />
          </bpmn:extensionElements>
          <bpmn:categoryValueRef>Grund_der_Abloesung_pruefen_und_uebergeben_CATEGORY_VALUE</bpmn:categoryValueRef>
          <bpmn:incoming>Warum_endet_das_Neuer_Pruefbedarf_zu_Pruefkontext_fuer_Mitarbeiter_bereitstellen_FLOW</bpmn:incoming>
          <bpmn:outgoing>Pruefkontext_fuer_Mitarbeiter_Aktuelle_Mitarbeiterpruefung_zu_Mitarbeiterbearbeitung_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:serviceTask id="Wiedervorlage_Eintritt_vorbereiten_SERVICE" name="Wiedervorlage-Eintritt vorbereiten">
          <bpmn:documentation>FALL-11 Übergang 31. Gespeicherten Terminsetzungsauftrag und aktuelle Terminversion laden, nicht neu berechnen oder erneut speichern. staffEntryContextRef für direkten Eintritt in FollowUp vorbereiten; Marker konsumieren. Neue Mieternachricht oder neuer zwingender Prüfgrund nach Terminsetzung: betroffenen Termin idempotent aufheben und Mitarbeiterprüfung vorbereiten, genau eine Prüfung auch bei gleichzeitigem Timer. Keine Wiederherstellung eines aufgehobenen Termins. Alte automatische Ergebnisse bleiben gesperrt. Übergabekontext und Ereignisse zuverlässig an SEntryCheck übergeben; keine live gemeinsam genutzten Kindvariablen.
  0.27: Auch Übergang 32. Keine Rückgaben des abgebrochenen Reply-Calls verwenden; offene Antwortbedarfe unverändert erhalten. Derselbe geprüfte FollowUp-Eintritt wie bei Übergang 31.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.direct-follow-up.continue" />
          </bpmn:extensionElements>
          <bpmn:categoryValueRef>Grund_der_Abloesung_pruefen_und_uebergeben_CATEGORY_VALUE</bpmn:categoryValueRef>
          <bpmn:incoming>Warum_endet_das_Wiedervorlage_bestaetigt_zu_Wiedervorlage_Eintritt_vorbereiten_SERVICE_FLOW</bpmn:incoming>
          <bpmn:outgoing>Wiedervorlage_Eintritt_vorbereiten_Gepruefter_Eintritt_Wiedervorlage_neuer_Pruefbedarf_zu_Mitarbeiterbearbeitung_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:serviceTask id="Erneute_Katalogrueckfrage_vorbereiten_SERVICE" name="Erneute Katalogrueckfrage&#10;vorbereiten">
          <bpmn:documentation>Aktuellen Fallstand, führenden Durchlauf und Herkunft QUESTION prüfen; automaticEntryContextRef bereitstellen. Für QUESTION/CLOSE aktuellen replyDecisionRef verwenden, keine alte Freigabe und kein Statusreset. automaticCallRef für genau diesen Aufruf und Unterbrechungsbezug bereitstellen; nachholbare Registrierung mit offenen Prüfentscheiden koordinieren. Alte konsumierte Marker nicht wiederverwenden, neuen Prüfbedarf nicht löschen.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.automatic.prepare-question-round" />
          </bpmn:extensionElements>
          <bpmn:categoryValueRef>Automatik_vorbereiten_CATEGORY_VALUE</bpmn:categoryValueRef>
          <bpmn:incoming>Wie_geht_der_Weitere_Katalogfrage_zulaessig_zu_Erneute_Katalogrueckfrage_vorbereiten_SERVICE_FLOW</bpmn:incoming>
          <bpmn:outgoing>Erneute_Katalogrueckfrage_vorbereiten_zu_Automatik_fortsetzen_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:serviceTask id="Automatischen_Abschluss_vorbereiten_SERVICE" name="Automatischen Abschluss vorbereiten">
          <bpmn:documentation>Aktuellen Fallstand, führenden Durchlauf und Herkunft CLOSE prüfen; automaticEntryContextRef bereitstellen. Für QUESTION/CLOSE aktuellen replyDecisionRef verwenden, keine alte Freigabe und kein Statusreset. automaticCallRef für genau diesen Aufruf und Unterbrechungsbezug bereitstellen; nachholbare Registrierung mit offenen Prüfentscheiden koordinieren. Alte konsumierte Marker nicht wiederverwenden, neuen Prüfbedarf nicht löschen.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.automatic.prepare-close-round" retries="3" />
          </bpmn:extensionElements>
          <bpmn:categoryValueRef>Automatik_vorbereiten_CATEGORY_VALUE</bpmn:categoryValueRef>
          <bpmn:incoming>Wie_geht_der_Systemabschluss_vorgeschlagen_zu_Automatischen_Abschluss_vorbereiten_SERVICE_FLOW</bpmn:incoming>
          <bpmn:outgoing>Automatischen_Abschluss_vorbereiten_zu_Automatik_fortsetzen_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="Automatik_fortsetzen_zusammenfuehren_XOR">
          <bpmn:categoryValueRef>Automatik_vorbereiten_CATEGORY_VALUE</bpmn:categoryValueRef>
          <bpmn:incoming>Automatischen_Abschluss_vorbereiten_zu_Automatik_fortsetzen_zusammenfuehren_XOR_FLOW</bpmn:incoming>
          <bpmn:incoming>Erneute_Katalogrueckfrage_vorbereiten_zu_Automatik_fortsetzen_zusammenfuehren_XOR_FLOW</bpmn:incoming>
          <bpmn:outgoing>Automatik_fortsetzen_zusammenfuehren_zu_Automatik_fortsetzen_END_FLOW</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:exclusiveGateway id="Bestaetigte_Abloesung_pruefen_zusammenfuehren_XOR" gatewayDirection="Converging">
          <bpmn:categoryValueRef>Grund_der_Abloesung_pruefen_und_uebergeben_CATEGORY_VALUE</bpmn:categoryValueRef>
          <bpmn:incoming>Warum_endet_das_Uebernahme_oder_Rueckfrage_bestaetigt_zu_Bestaetigte_Abloesung_pruefen_zusammenfuehren_FLOW</bpmn:incoming>
          <bpmn:incoming>Was_ist_eingetroffen_Automatik_abgeloest_zu_Bestaetigte_Abloesung_pruefen_zusammenfuehren_FLOW</bpmn:incoming>
          <bpmn:outgoing>Bestaetigte_Abloesung_pruefen_zu_Bestaetigte_Abloesung_pruefen_SERVICE_FLOW</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="Bestaetigte_Abloesung_pruefen_SERVICE" name="Bestaetigte Abloesung pruefen">
          <bpmn:documentation>Persistierten Unterbrechungsentscheid gegen automaticCallRef, führenden Durchlauf und aktuellen Fallstand prüfen; automaticInterruptionReady konsumieren. Zwingender neuer Prüfbedarf hat Vorrang -&gt; staffEntryContextRef zur Prüfung. Erfolgreiche Rückfrage ohne Vorrang -&gt; replyEntryContextRef. Übernahme ohne Prüfbedarf -&gt; staffEntryContextRef zu SWork. Gespeicherter Termin -&gt; direkter FollowUp-Kontext, bei Kontakt/neuem Prüfbedarf seit Terminsetzung Termin aufheben und Prüfung vorbereiten. Bestehende Prüfung genau einmal ergänzen. Keine Rückgaben des abgebrochenen Kindes; keine doppelte Veröffentlichung, Terminversion oder Mailpflicht. Neueren Fallstand/Abschluss nicht zurücksetzen. Geschützte Übergabe bis Zielaktivierung zuverlässig nachholen.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="propertyflow.review.prepare-staff" />
          </bpmn:extensionElements>
          <bpmn:categoryValueRef>Grund_der_Abloesung_pruefen_und_uebergeben_CATEGORY_VALUE</bpmn:categoryValueRef>
          <bpmn:incoming>Bestaetigte_Abloesung_pruefen_zu_Bestaetigte_Abloesung_pruefen_SERVICE_FLOW</bpmn:incoming>
          <bpmn:outgoing>Bestaetigte_Abloesung_pruefen_zu_Gepruefte_Fortsetzung_XOR_FLOW</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="Gepruefte_Fortsetzung_XOR" name="Gepruefte Fortsetzung">
          <bpmn:categoryValueRef>Grund_der_Abloesung_pruefen_und_uebergeben_CATEGORY_VALUE</bpmn:categoryValueRef>
          <bpmn:incoming>Bestaetigte_Abloesung_pruefen_zu_Gepruefte_Fortsetzung_XOR_FLOW</bpmn:incoming>
          <bpmn:outgoing>Gepruefte_Fortsetzung_XOR_Veroeffentlichte_Rueckfrage_zu_Erneut_warten_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
          <bpmn:outgoing>Gepruefte_Fortsetzung_XOR_Pruefung_Bearbeitung_Wiedervorlage_zu_Mitarbeiterbearbeitung_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:sequenceFlow id="Wie_geht_der_Antwortbedarf_offen_erneut_warten_zu_Erneut_warten_zusammenfuehren_XOR_FLOW" name="Antwortbedarf offen – erneut warten" sourceRef="Wie_geht_der_Fall_weiter_XOR" targetRef="Erneut_warten_zusammenfuehren_XOR">
          <bpmn:documentation>
  Geprüftes Ergebnis Weiter warten übernehmen. Verbrauch dieses Ergebnisstands nachvollziehbar sichern; derselbe Stand darf nicht erneut wecken, ein bereits verfügbarer neuerer Stand darf nicht verloren gehen.</bpmn:documentation>
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyOutcome = "WAIT"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Wie_geht_der_Pruefung_erforderlich_zu_Mitarbeiterbearbeitung_zusammenfuehren_XOR_FLOW" name="Pruefung erforderlich" sourceRef="Wie_geht_der_Fall_weiter_XOR" targetRef="Mitarbeiterbearbeitung_zusammenfuehren_XOR">
          <bpmn:documentation>
  Nur fachliches Prüfergebnis aus RReview: Pflichtprüfbedarf/Analysefehler oder vollständige Beantwortung ohne zulässigen Abschluss beziehungsweise andere bestehende fachliche Prüfgründe. Kein Fallback für veraltete oder doppelte Auswertungen.</bpmn:documentation>
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyOutcome = "REVIEW"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Wie_geht_der_Weitere_Katalogfrage_zulaessig_zu_Erneute_Katalogrueckfrage_vorbereiten_SERVICE_FLOW" name="Weitere Katalogfrage zulaessig" sourceRef="Wie_geht_der_Fall_weiter_XOR" targetRef="Erneute_Katalogrueckfrage_vorbereiten_SERVICE">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyOutcome = "QUESTION"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Wie_geht_der_Systemabschluss_vorgeschlagen_zu_Automatischen_Abschluss_vorbereiten_SERVICE_FLOW" name="Systemabschluss vorgeschlagen" sourceRef="Wie_geht_der_Fall_weiter_XOR" targetRef="Automatischen_Abschluss_vorbereiten_SERVICE">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyOutcome = "CLOSE"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Warum_endet_das_Antwortbedarf_aufgehoben_zu_Fortsetzung_ohne_Antwortbedarf_pruefen_FLOW" name="Antwortbedarf aufgehoben" sourceRef="Warum_endet_das_Warten_XOR" targetRef="Fortsetzung_ohne_Antwortbedarf_pruefen_zusammenfuehren_XOR">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyExitReason = "CLEAR_ANSWER"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Fortsetzung_ohne_Antwortbedarf_zu_Fortsetzung_ohne_Antwortbedarf_pruefen_FLOW" sourceRef="Fortsetzung_ohne_Antwortbedarf_pruefen_zusammenfuehren_XOR" targetRef="Fortsetzung_ohne_Antwortbedarf_pruefen_SERVICE">
          <bpmn:categoryValueRef>Grund_der_Abloesung_pruefen_und_uebergeben_CATEGORY_VALUE</bpmn:categoryValueRef>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Fortsetzung_ohne_Antwortbedarf_zu_Aktueller_Fortsetzungsweg_XOR_FLOW" name="" sourceRef="Fortsetzung_ohne_Antwortbedarf_pruefen_SERVICE" targetRef="Aktueller_Fortsetzungsweg_XOR">
          <bpmn:categoryValueRef>Grund_der_Abloesung_pruefen_und_uebergeben_CATEGORY_VALUE</bpmn:categoryValueRef>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Aktueller_Fortsetzungsweg_XOR_In_Bearbeitung_vorrangige_Pruefung_zu_Mitarbeiterbearbeitung_zusammenfuehren_XOR_FLOW" name="In Bearbeitung / vorrangige Pruefung" sourceRef="Aktueller_Fortsetzungsweg_XOR" targetRef="Mitarbeiterbearbeitung_zusammenfuehren_XOR">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clearAnswerOutcome = "STAFF"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Aktueller_Fortsetzungsweg_XOR_Neue_offene_Fragen_weiter_warten_zu_Erneut_warten_zusammenfuehren_XOR_FLOW" name="Neue offene Fragen; weiter warten" sourceRef="Aktueller_Fortsetzungsweg_XOR" targetRef="Erneut_warten_zusammenfuehren_XOR">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= clearAnswerOutcome = "WAIT"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Warum_endet_das_Mitarbeiterabschluss_bestaetigt_zu_Mitarbeiterabschluss_pruefen_END_FLOW" name="Mitarbeiterabschluss bestaetigt" sourceRef="Warum_endet_das_Warten_XOR" targetRef="Mitarbeiterabschluss_pruefen_END">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyExitReason = "CLOSE"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Warum_endet_das_Neuer_Pruefbedarf_zu_Pruefkontext_fuer_Mitarbeiter_bereitstellen_FLOW" name="Neuer Pruefbedarf" sourceRef="Warum_endet_das_Warten_XOR" targetRef="Pruefkontext_fuer_Mitarbeiter_bereitstellen_SERVICE">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyExitReason = "REVIEW"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Pruefkontext_fuer_Mitarbeiter_Aktuelle_Mitarbeiterpruefung_zu_Mitarbeiterbearbeitung_zusammenfuehren_XOR_FLOW" name="Aktuelle Mitarbeiterpruefung" sourceRef="Pruefkontext_fuer_Mitarbeiter_bereitstellen_SERVICE" targetRef="Mitarbeiterbearbeitung_zusammenfuehren_XOR" />
        <bpmn:sequenceFlow id="Wiedervorlage_Eintritt_vorbereiten_Gepruefter_Eintritt_Wiedervorlage_neuer_Pruefbedarf_zu_Mitarbeiterbearbeitung_zusammenfuehren_XOR_FLOW" name="Gepruefter Eintritt: Wiedervorlage / neuer Pruefbedarf" sourceRef="Wiedervorlage_Eintritt_vorbereiten_SERVICE" targetRef="Mitarbeiterbearbeitung_zusammenfuehren_XOR" />
        <bpmn:sequenceFlow id="Warum_endet_das_Wiedervorlage_bestaetigt_zu_Wiedervorlage_Eintritt_vorbereiten_SERVICE_FLOW" name="Wiedervorlage bestaetigt" sourceRef="Warum_endet_das_Warten_XOR" targetRef="Wiedervorlage_Eintritt_vorbereiten_SERVICE">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyExitReason = "FOLLOW_UP"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Automatischen_Abschluss_vorbereiten_zu_Automatik_fortsetzen_zusammenfuehren_XOR_FLOW" name="" sourceRef="Automatischen_Abschluss_vorbereiten_SERVICE" targetRef="Automatik_fortsetzen_zusammenfuehren_XOR">
          <bpmn:categoryValueRef>Automatik_vorbereiten_CATEGORY_VALUE</bpmn:categoryValueRef>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Erneute_Katalogrueckfrage_vorbereiten_zu_Automatik_fortsetzen_zusammenfuehren_XOR_FLOW" name="" sourceRef="Erneute_Katalogrueckfrage_vorbereiten_SERVICE" targetRef="Automatik_fortsetzen_zusammenfuehren_XOR">
          <bpmn:categoryValueRef>Automatik_vorbereiten_CATEGORY_VALUE</bpmn:categoryValueRef>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Automatik_fortsetzen_zusammenfuehren_zu_Automatik_fortsetzen_END_FLOW" sourceRef="Automatik_fortsetzen_zusammenfuehren_XOR" targetRef="Automatik_fortsetzen_END" />
        <bpmn:sequenceFlow id="Warum_endet_das_Uebernahme_oder_Rueckfrage_bestaetigt_zu_Bestaetigte_Abloesung_pruefen_zusammenfuehren_FLOW" name="Uebernahme oder Rueckfrage bestaetigt" sourceRef="Warum_endet_das_Warten_XOR" targetRef="Bestaetigte_Abloesung_pruefen_zusammenfuehren_XOR">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= replyExitReason = "TAKEOVER" or replyExitReason = "MANUAL_QUESTION"</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Bestaetigte_Abloesung_pruefen_zu_Bestaetigte_Abloesung_pruefen_SERVICE_FLOW" sourceRef="Bestaetigte_Abloesung_pruefen_zusammenfuehren_XOR" targetRef="Bestaetigte_Abloesung_pruefen_SERVICE">
          <bpmn:categoryValueRef>Grund_der_Abloesung_pruefen_und_uebergeben_CATEGORY_VALUE</bpmn:categoryValueRef>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Bestaetigte_Abloesung_pruefen_zu_Gepruefte_Fortsetzung_XOR_FLOW" name="" sourceRef="Bestaetigte_Abloesung_pruefen_SERVICE" targetRef="Gepruefte_Fortsetzung_XOR">
          <bpmn:categoryValueRef>Grund_der_Abloesung_pruefen_und_uebergeben_CATEGORY_VALUE</bpmn:categoryValueRef>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Gepruefte_Fortsetzung_XOR_Veroeffentlichte_Rueckfrage_zu_Erneut_warten_zusammenfuehren_XOR_FLOW" name="Veroeffentlichte Rueckfrage" sourceRef="Gepruefte_Fortsetzung_XOR" targetRef="Erneut_warten_zusammenfuehren_XOR">
