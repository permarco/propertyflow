        </bpmn:sequenceFlow>
        <bpmn:exclusiveGateway id="Erneut_warten_zusammenfuehren_XOR" gatewayDirection="Converging">
          <bpmn:incoming>Wie_geht_der_Antwortbedarf_offen_erneut_warten_zu_Erneut_warten_zusammenfuehren_XOR_FLOW</bpmn:incoming>
