      <bpmn:categoryValueRef>Aktuelles_Ergebnis_bereitstellen_CATEGORY_VALUE</bpmn:categoryValueRef>
      <bpmn:outgoing>Auswertung_veraltet_BOUNDARY_zu_Nachrichtenauswertung_aktualisieren_SERVICE_FLOW</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Auswertung_veraltet_BOUNDARY_ERROR_DEF" errorRef="Nachrichtenauswertung_veraltet_ERROR" />
    </bpmn:boundaryEvent>
    <bpmn:callActivity id="Gespraech_auswerten_Aktualisierung_CALL" name="Gespraech auswerten">
      <bpmn:documentation>KOM-03 Zeile 4 / KOM-AK-25: Die gemeinsame Auswertung übernimmt ein aktuelles Ergebnis oder erneuert es. Veraltete und bereits erledigte Aufträge haben keine neue Wirkung. Anschliessend wird geprüft, ob das Ergebnis noch anzuwenden ist.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Gespraech_auswerten_PROCESS" propagateAllChildVariables="false" propagateAllParentVariables="false" bindingType="deployment" />
        <zeebe:ioMapping>
          <zeebe:input source="= caseId" target="caseId" />
          <zeebe:input source="= leadingProcessInstanceKey" target="leadingProcessInstanceKey" />
          <zeebe:input source="= tenantMessageId" target="tenantMessageId" />
          <zeebe:output source="= evaluationRef" target="evaluationRef" />
          <zeebe:output source="= evaluationCurrent" target="evaluationCurrent" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>Aktuelles_Ergebnis_bereitstellen_CATEGORY_VALUE</bpmn:categoryValueRef>
      <bpmn:incoming>Auswertung_veraltet_BOUNDARY_zu_Nachrichtenauswertung_aktualisieren_SERVICE_FLOW</bpmn:incoming>
      <bpmn:outgoing>Nachrichtenauswertung_aktualisieren_SERVICE_zu_Noch_anzuwenden_XOR_FLOW</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Noch_anzuwenden_XOR" name="Noch anzuwenden?">
      <bpmn:categoryValueRef>Aktuelles_Ergebnis_bereitstellen_CATEGORY_VALUE</bpmn:categoryValueRef>
