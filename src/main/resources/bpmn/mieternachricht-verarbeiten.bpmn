    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Aktuelle_Bearbeitung_XOR_Mitarbeiterpruefung_zu_Laufende_Mitarbeiterpruefung_ergaenzen_SERVICE_FLOW" name="Mitarbeiterpruefung" sourceRef="Aktuelle_Bearbeitung_XOR" targetRef="Laufende_Mitarbeiterpruefung_ergaenzen_SERVICE">
      <bpmn:categoryValueRef>Fallkontext_vorbereiten_CATEGORY_VALUE</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= casePhase = "STAFF_REVIEW_REQUIRED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Aktuelle_Bearbeitung_XOR_Wiedervorlage_zu_Kontakt_zur_Wiedervorlage_bereitstellen_FLOW" name="Wiedervorlage" sourceRef="Aktuelle_Bearbeitung_XOR" targetRef="Kontakt_zur_Wiedervorlage_bereitstellen_SERVICE">
      <bpmn:categoryValueRef>Fallkontext_vorbereiten_CATEGORY_VALUE</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= casePhase = "WAITING_FOR_FOLLOW_UP"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Aktuelle_Bearbeitung_XOR_Sonstige_aktive_Phase_zu_Neuen_Eingang_vormerken_SERVICE_FLOW" name="Sonstige aktive Phase" sourceRef="Aktuelle_Bearbeitung_XOR" targetRef="Neuen_Eingang_vormerken_SERVICE">
