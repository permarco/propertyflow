    <bpmn:sequenceFlow id="Neu_zu_verarbeiten_Ja_zu_Aktuelle_Bearbeitung_XOR_FLOW" name="Ja" sourceRef="Neu_zu_verarbeiten_XOR" targetRef="Aktuelle_Bearbeitung_XOR">
