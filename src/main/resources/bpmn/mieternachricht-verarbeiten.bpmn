      <bpmn:categoryValueRef>Aktuelles_Ergebnis_bereitstellen_CATEGORY_VALUE</bpmn:categoryValueRef>
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= evaluationCurrent = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Noch_anzuwenden_XOR_Ueberholt_bereits_erledigt_zu_Keine_neue_Wirkung_Mieternachricht_FLOW" name="Ueberholt / bereits erledigt" sourceRef="Noch_anzuwenden_XOR" targetRef="Keine_neue_Wirkung_zusammenfuehren_XOR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= evaluationCurrent = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Aktuelle_Auswertung_bereitstellen_zusammenfuehren_XOR">
      <bpmn:categoryValueRef>Aktuelles_Ergebnis_bereitstellen_CATEGORY_VALUE</bpmn:categoryValueRef>
      <bpmn:incoming>Mieternachricht_verarbeiten_zusammenfuehren_zu_Aktuelle_Auswertung_bereitstellen_zusammenfuehren_FLOW</bpmn:incoming>
      <bpmn:incoming>Noch_anzuwenden_XOR_Aktuelle_Grundlage_zu_Aktuelle_Auswertung_bereitstellen_zusammenfuehren_FLOW</bpmn:incoming>
      <bpmn:outgoing>Aktuelle_Auswertung_bereitstellen_zu_Aktuelle_Auswertung_bereitstellen_SERVICE_FLOW</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Aktuelle_Auswertung_bereitstellen_zu_Aktuelle_Auswertung_bereitstellen_SERVICE_FLOW" sourceRef="Aktuelle_Auswertung_bereitstellen_zusammenfuehren_XOR" targetRef="Aktuelle_Auswertung_bereitstellen_SERVICE">
      <bpmn:categoryValueRef>Aktuelles_Ergebnis_bereitstellen_CATEGORY_VALUE</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Keine_neue_Wirkung_zusammenfuehren_XOR" gatewayDirection="Converging">
      <bpmn:incoming>Neu_zu_verarbeiten_Bereits_verarbeitet_nicht_mehr_zulaessig_zu_Keine_neue_Wirkung_Mieternachricht_FLOW</bpmn:incoming>
      <bpmn:incoming>Noch_anzuwenden_XOR_Ueberholt_bereits_erledigt_zu_Keine_neue_Wirkung_Mieternachricht_FLOW</bpmn:incoming>
      <bpmn:outgoing>Keine_neue_Wirkung_zusammenfuehren_zu_Keine_neue_Wirkung_FLOW</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Keine_neue_Wirkung_zusammenfuehren_zu_Keine_neue_Wirkung_FLOW" sourceRef="Keine_neue_Wirkung_zusammenfuehren_XOR" targetRef="Keine_neue_Wirkung_Mieternachricht_verarbeiten_END" />
    <bpmn:group id="Fallkontext_vorbereiten_GROUP" categoryValueRef="Fallkontext_vorbereiten_CATEGORY_VALUE" />
    <bpmn:group id="LLM_Auswertung_und_Fehlerpfad_GROUP" categoryValueRef="LLM_Auswertung_und_Fehlerpfad_CATEGORY_VALUE" />
    <bpmn:group id="Aktuelles_Ergebnis_bereitstellen_GROUP" categoryValueRef="Aktuelles_Ergebnis_bereitstellen_CATEGORY_VALUE" />
    <bpmn:textAnnotation id="Der_Prozess_gibt_nur_eine_NOTE">
      <bpmn:text>Der Prozess gibt nur eine zum aktuellen Fall- und Nachrichtenstand passende Auswertung weiter. Ändert sich der Stand, prüft er erneut.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ein_Eingang_pro_gespeicherter_Nachricht_NOTE">
      <bpmn:text>Ein Eingang pro gespeicherter Nachricht; keine zweite Fallprozessinstanz.
Mitarbeiterprüfung: dieselbe Aufgabe bleibt offen, kein automatischer Abschluss.
Wiedervorlage: Hauptpfad sofort wecken; KI-Auswertung läuft danach parallel.
Doppelte oder überholte Ergebnisse ändern keine menschliche Entscheidung.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Lokale_Eingangs_ID_je_Ereignispfad_NOTE">
      <bpmn:text>Lokale Eingangs-ID je Ereignispfad;
Versionen im Hauptprozess; explizite Übergabe an zuständigen Kind-Scope.
Hauptpfad prüft aktuelle Eingänge vor Veröffentlichung oder Abschluss.
Ein normales Ende hier beendet nur diese Nachrichtenauswertung.
Dateigrenze: aktuelle Kindinstanz gezielt aktualisieren; keine gemeinsamen Call-Variablen.</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
