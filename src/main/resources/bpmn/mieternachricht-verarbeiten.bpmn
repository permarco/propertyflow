    <bpmn:sequenceFlow id="Mieternachricht_mit_LLM_zu_Nachrichtenauswertung_pruefen_SERVICE_FLOW" sourceRef="Gespraech_auswerten_Mieternachricht_CALL" targetRef="Nachrichtenauswertung_pruefen_SERVICE">
