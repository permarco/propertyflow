    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Auswertung_veraltet_BOUNDARY_zu_Nachrichtenauswertung_aktualisieren_SERVICE_FLOW" sourceRef="Auswertung_veraltet_BOUNDARY" targetRef="Gespraech_auswerten_Aktualisierung_CALL">
