<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Mitarbeiterbearbeitung_DEFINITIONS" targetNamespace="https://propertyflow.local/bpmn/draft" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Mitarbeiternachricht_als_Nebenaktion_senden_MESSAGE" name="Mitarbeiternachricht als Nebenaktion senden">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=entryContextRef" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Bestaetigter_Fallstand_geaendert_ERROR" name="Bestätigter Fallstand geändert" errorCode="STAFF_DECISION_STALE" />
