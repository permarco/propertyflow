    <bpmn:categoryValue id="Einstieg_und_Fallstand_CATEGORY_VALUE" value="Einstieg und Fallstand" />
  </bpmn:category>
  <bpmn:category id="Mitarbeiterpruefung_CATEGORY">
    <bpmn:categoryValue id="Mitarbeiterpruefung_CATEGORY_VALUE" value="Mitarbeiterpruefung" />
  </bpmn:category>
  <bpmn:category id="Laufende_Bearbeitung_CATEGORY">
    <bpmn:categoryValue id="Laufende_Bearbeitung_CATEGORY_VALUE" value="Laufende Bearbeitung" />
  </bpmn:category>
  <bpmn:category id="Externe_Rueckmeldung_CATEGORY">
    <bpmn:categoryValue id="Externe_Rueckmeldung_CATEGORY_VALUE" value="Externe Rueckmeldung" />
  </bpmn:category>
  <bpmn:category id="Wiedervorlage_CATEGORY">
