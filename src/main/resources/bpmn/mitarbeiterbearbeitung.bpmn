      <bpmn:linkEventDefinition id="Bestaetigte_Aktion_THROW_LINK_DEF" name="STAFF_DECISION" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Bestaetigte_Aktion_CATCH" name="Bestaetigte Aktion">
      <bpmn:categoryValueRef>Mitarbeiterpruefung_CATEGORY_VALUE</bpmn:categoryValueRef>
      <bpmn:outgoing>Bestaetigte_Aktion_CATCH_zu_Bestaetigte_Aktion_zusammenfuehren_XOR_FLOW</bpmn:outgoing>
