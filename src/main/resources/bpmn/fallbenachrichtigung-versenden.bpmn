<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_PropertyFlow_Mail_Draft" targetNamespace="https://propertyflow.local/bpmn/draft" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:error id="Error_MailClarification" name="Versand fachlich klären" errorCode="MAIL_CLARIFICATION_REQUIRED" />
  <bpmn:process id="PropertyFlow_Mail_Draft" name="Fallbenachrichtigung versenden · 0.23" isExecutable="true">
    <bpmn:documentation>BEN-03: Eigenständige Camunda-Versandinstanz je dauerhaftem Mailauftrag, kein führender Fallprozess und kein Call innerhalb des abbrechbaren ActiveCase. Der dauerhafte Starter übergibt nur mailOrderRef. CaseMailService koordiniert Registrierung, Versandversuche und Wiederholungsschutz. Höchstens fünf eindeutige technische Fehlversuche mit 30 Sekunden Job-Backoff; ein unklarer SMTP-Ausgang wird nicht automatisch erneut versendet. MailProblem speichert einen dauerhaften Prüfbedarf für den führenden Fallprozess; dessen separate Verarbeitung muss ebenfalls aktiv sein.</bpmn:documentation>
    <bpmn:startEvent id="MailStart" name="Dauerhafter Auftrag">
      <bpmn:documentation>Start erst nach Commit von Ereignis und Mailpflicht. Automatische Abschlussnachricht darf anschliessend unabhängig vom Fallabschluss versendet werden.</bpmn:documentation>
      <bpmn:outgoing>M01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="MailLoad" name="Mailauftrag prüfen&#10;Versandart bestimmen">
      <bpmn:documentation>mailOrderRef laden, Ereignis/Empfänger prüfen und exklusiven Versandversuch koordinieren. Keine Abschlussstatusmail, Memo-Mail oder zusätzliche Mail zur Ursprungsmeldung. Bereits erledigter Auftrag liefert SKIP. Neue fachliche Ereignisse liefern CHANGE oder MESSAGE. Ungültiger technischer Vertrag darf keinen Default-Versand auslösen. Keine Adressen, Tokens, Nachrichtentexte oder SMTP-Zugangsdaten in Camunda-Variablen.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="propertyflow.mail.prepare" />
      </bpmn:extensionElements>
      <bpmn:incoming>M01</bpmn:incoming>
      <bpmn:outgoing>M02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="MailRoute" name="Versandart">
      <bpmn:documentation>CHANGE: Status oder Dringlichkeit. MESSAGE: Annahme oder veröffentlichte externe Nachricht. SKIP: kein neuer Versand nötig. Andere Werte technischer Vertragsfehler.</bpmn:documentation>
      <bpmn:incoming>M02</bpmn:incoming>
      <bpmn:outgoing>M03</bpmn:outgoing>
      <bpmn:outgoing>M04</bpmn:outgoing>
      <bpmn:outgoing>M05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="MailSendChange" name="Status-/Dringlichkeitsmail&#10;Mail-Worker beauftragen">
      <bpmn:documentation>Camunda stellt Job propertyflow.mail.send bereit. Mail-Worker lädt anhand mailOrderRef die Ereignisdaten, bestätigte Kontaktadresse und gültigen Fall-Link über PropertyFlow-Anwendungsdienste; Versand über SMTP, lokal Mailpit. Gleiche logische Auftragskennung bei Wiederholung. Bekannter erfolgreicher Versuch wird nicht erneut gesendet. SMTP-Annahme ist keine Zustell-/Lesegarantie. Unklarer Ausgang nach BEN-04, keine behauptete Exactly-once-SMTP-Garantie. Technischer Fehler: Job-Retry/Incident, keine Rücknahme fachlicher Änderung. Klärungsbedürftiger fachlicher Versandfehler ausdrücklich MAIL_CLARIFICATION_REQUIRED.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="propertyflow.mail.send" />
      </bpmn:extensionElements>
      <bpmn:incoming>M03</bpmn:incoming>
      <bpmn:outgoing>M06</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:boundaryEvent id="MailSendChangeProblem" name="Versand klären" attachedToRef="MailSendChange">
      <bpmn:documentation>Fachliche Einstufung durch Versanddienst; ein Retry allein löst dies nicht aus. Nach ausgeschöpften technischen Retries bleibt Incident sichtbar; Wiederholungsgrenzen und Überführung in fachlichen Klärbedarf vor Ausführung konkretisieren.</bpmn:documentation>
      <bpmn:outgoing>M08</bpmn:outgoing>
      <bpmn:errorEventDefinition id="MailSendChangeProblem_definition" errorRef="Error_MailClarification" />
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="MailSendMessage" name="Annahme-/Nachrichtenmail&#10;Mail-Worker beauftragen">
      <bpmn:documentation>Camunda stellt Job propertyflow.mail.send bereit. Mail-Worker lädt anhand mailOrderRef die Ereignisdaten, bestätigte Kontaktadresse und gültigen Fall-Link über PropertyFlow-Anwendungsdienste; Versand über SMTP, lokal Mailpit. Gleiche logische Auftragskennung bei Wiederholung. Bekannter erfolgreicher Versuch wird nicht erneut gesendet. SMTP-Annahme ist keine Zustell-/Lesegarantie. Unklarer Ausgang nach BEN-04, keine behauptete Exactly-once-SMTP-Garantie. Technischer Fehler: Job-Retry/Incident, keine Rücknahme fachlicher Änderung. Klärungsbedürftiger fachlicher Versandfehler ausdrücklich MAIL_CLARIFICATION_REQUIRED.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="propertyflow.mail.send" />
      </bpmn:extensionElements>
      <bpmn:incoming>M04</bpmn:incoming>
      <bpmn:outgoing>M07</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:boundaryEvent id="MailSendMessageProblem" name="Versand klären" attachedToRef="MailSendMessage">
      <bpmn:documentation>Fachliche Einstufung durch Versanddienst; ein Retry allein löst dies nicht aus. Nach ausgeschöpften technischen Retries bleibt Incident sichtbar; Wiederholungsgrenzen und Überführung in fachlichen Klärbedarf vor Ausführung konkretisieren.</bpmn:documentation>
      <bpmn:outgoing>M09</bpmn:outgoing>
      <bpmn:errorEventDefinition id="MailSendMessageProblem_definition" errorRef="Error_MailClarification" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Merge_MailEnd" gatewayDirection="Converging">
      <bpmn:incoming>M05</bpmn:incoming>
      <bpmn:incoming>M06</bpmn:incoming>
      <bpmn:incoming>M07</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_MailEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="MailEnd" name="Versandauftrag erledigt">
      <bpmn:documentation>Nach dokumentierter SMTP-Annahme oder bereits erfolgreich erledigtem identischen Auftrag. Kein Fallabschluss und kein Statuswechsel durch dieses Ende.</bpmn:documentation>
      <bpmn:incoming>Flow_Merge_MailEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Merge_MailEnd" sourceRef="Merge_MailEnd" targetRef="MailEnd" />
    <bpmn:exclusiveGateway id="Merge_MailProblem" gatewayDirection="Converging">
      <bpmn:incoming>M08</bpmn:incoming>
      <bpmn:incoming>M09</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_MailProblem</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="MailProblem" name="Versandproblem speichern&#10;Prüfbedarf bereitstellen">
      <bpmn:documentation>Auftrag nicht als erfolgreich markieren. Aktiver Fall: neuen fachlichen Grund E-Mail-Versand klären über den unabhängigen Prüfbedarf-Eingang bereitstellen. Bereits offene Prüfung ergänzen, identische oder berücksichtigte Erkenntnis nicht erneut eskalieren. Abgeschlossener Fall: nur interner Hinweis, keine Wiedereröffnung. Keine automatische Neuanlage identischer Statusmail-Aufträge durch Wiederholung.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="propertyflow.mail.record-problem" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Merge_MailProblem</bpmn:incoming>
      <bpmn:outgoing>M10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Merge_MailProblem" sourceRef="Merge_MailProblem" targetRef="MailProblem" />
    <bpmn:endEvent id="MailProblemEnd" name="Klärbedarf dokumentiert">
      <bpmn:documentation>Versand nicht als erfolgreich deklarieren; gespeicherter Auftrag bleibt nachvollziehbar.</bpmn:documentation>
      <bpmn:incoming>M10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="M01" name="" sourceRef="MailStart" targetRef="MailLoad" />
    <bpmn:sequenceFlow id="M02" name="" sourceRef="MailLoad" targetRef="MailRoute" />
    <bpmn:sequenceFlow id="M03" name="Status / Dringlichkeit" sourceRef="MailRoute" targetRef="MailSendChange">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= mailRoute = "CHANGE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M04" name="Annahme / Nachricht" sourceRef="MailRoute" targetRef="MailSendMessage">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= mailRoute = "MESSAGE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M05" name="Bereits erledigt / keine neue Mail" sourceRef="MailRoute" targetRef="Merge_MailEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= mailRoute = "SKIP"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="M06" name="" sourceRef="MailSendChange" targetRef="Merge_MailEnd" />
    <bpmn:sequenceFlow id="M07" name="" sourceRef="MailSendMessage" targetRef="Merge_MailEnd" />
    <bpmn:sequenceFlow id="M08" name="" sourceRef="MailSendChangeProblem" targetRef="Merge_MailProblem" />
    <bpmn:sequenceFlow id="M09" name="" sourceRef="MailSendMessageProblem" targetRef="Merge_MailProblem" />
    <bpmn:sequenceFlow id="M10" name="" sourceRef="MailProblem" targetRef="MailProblemEnd" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Mail_diagram">
