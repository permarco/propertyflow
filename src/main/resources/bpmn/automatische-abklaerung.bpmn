      <bpmn:categoryValueRef>Zulaessige_Rueckfrage_oder_Abschluss_CATEGORY_VALUE</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Grundlage_veraltet_Abschlussnachricht_schreiben_zu_Abschlussnachricht_erneut_auswerten_zusammenfuehren_FLOW" sourceRef="Grundlage_veraltet_Abschlussnachricht_schreiben_BOUNDARY" targetRef="LLM_Auswertung_aktualisieren_Abschlussnachricht_schreiben_THROW">
      <bpmn:categoryValueRef>Zulaessige_Rueckfrage_oder_Abschluss_CATEGORY_VALUE</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Grundlage_veraltet_Abschlussnachricht_pruefen_zu_Abschlussnachricht_erneut_auswerten_zusammenfuehren_FLOW" sourceRef="Grundlage_veraltet_Abschlussnachricht_pruefen_BOUNDARY" targetRef="LLM_Auswertung_aktualisieren_Abschlussnachricht_pruefen_THROW">
      <bpmn:categoryValueRef>Zulaessige_Rueckfrage_oder_Abschluss_CATEGORY_VALUE</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Abschluss_veraltet_BOUNDARY_Antwort_bleibt_erhalten_erneut_pruefen_zu_LLM_Auswertung_aktualisieren_zusammenfuehren_FLOW" name="Antwort bleibt erhalten; erneut pruefen" sourceRef="Abschluss_veraltet_BOUNDARY" targetRef="LLM_Auswertung_aktualisieren_THROW">
      <bpmn:categoryValueRef>Zulaessige_Rueckfrage_oder_Abschluss_CATEGORY_VALUE</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Abschlussnachricht_schreiben_zu_Abschlussnachricht_pruefen_FLOW" sourceRef="Abschlussnachricht_schreiben_SERVICE" targetRef="Abschlussnachricht_pruefen_SERVICE">
      <bpmn:categoryValueRef>Zulaessige_Rueckfrage_oder_Abschluss_CATEGORY_VALUE</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Abschlussnachricht_pruefen_zu_Automatischen_Abschluss_speichern_FLOW" sourceRef="Abschlussnachricht_pruefen_SERVICE" targetRef="Automatischen_Abschluss_speichern_SERVICE">
      <bpmn:categoryValueRef>Zulaessige_Rueckfrage_oder_Abschluss_CATEGORY_VALUE</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:startEvent id="Aufruf_empfangen_START" name="Aufruf empfangen">
      <bpmn:categoryValueRef>Fallstand_und_Einstieg_CATEGORY_VALUE</bpmn:categoryValueRef>
      <bpmn:outgoing>Aufruf_empfangen_START_zu_Eintritt_und_aktuellen_Fallstand_FLOW</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Eintritt_und_aktuellen_Fallstand_pruefen_SERVICE" name="Eintritt und aktuellen&#10;Fallstand pruefen">
      <bpmn:documentation>Fall und führenden Prozess sowie aktuellen Call-Bezug anhand Engine-Metadaten prüfen/registrieren; entryContextRef laden. INITIAL nur bei bestätigter Erstanlage: Clarification. QUESTION oder CLOSE stammen aus aktuellem replyDecisionRef und führen über CurrentAnalysis/Validate zur erneuten Prüfung, ohne Status auf In Abklärung zu setzen. Ungültige/veraltete Grundlage nicht als Freigabe verwenden. Bereits veröffentlichte Antwort bei erneutem Einstieg erhalten. Kein zweiter Mieternachrichtenempfang; Auswertung aus zentraler Verarbeitung übernehmen. Aktuellen automaticCallRef und nachholbare Ergebniszustellung koordinieren, keine neue führende Instanz.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="propertyflow-register-automatic" />
        <zeebe:ioMapping>
          <zeebe:output source="= entryKind" target="entryKind" />
          <zeebe:output source="= entryKind != &#34;INITIAL&#34;" target="evaluationRefresh" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:categoryValueRef>Fallstand_und_Einstieg_CATEGORY_VALUE</bpmn:categoryValueRef>
      <bpmn:incoming>Aufruf_empfangen_START_zu_Eintritt_und_aktuellen_Fallstand_FLOW</bpmn:incoming>
      <bpmn:outgoing>Eintritt_und_aktuellen_zu_Erstanlage_oder_Fortsetzung_XOR_FLOW</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Erstanlage_oder_Fortsetzung_XOR" name="Erstanlage oder&#10;Fortsetzung?">
      <bpmn:categoryValueRef>Fallstand_und_Einstieg_CATEGORY_VALUE</bpmn:categoryValueRef>
      <bpmn:incoming>Eintritt_und_aktuellen_zu_Erstanlage_oder_Fortsetzung_XOR_FLOW</bpmn:incoming>
      <bpmn:outgoing>Erstanlage_oder_Fortsetzung_INITIAL_zu_Status_speichern_In_Abklaerung_FLOW</bpmn:outgoing>
      <bpmn:outgoing>Erstanlage_oder_Fortsetzung_QUESTION_CLOSE_zu_Automatische_Abklaerung_zusammenfuehren_Automatische_FLOW</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Aufruf_empfangen_START_zu_Eintritt_und_aktuellen_Fallstand_FLOW" name="" sourceRef="Aufruf_empfangen_START" targetRef="Eintritt_und_aktuellen_Fallstand_pruefen_SERVICE">
      <bpmn:categoryValueRef>Fallstand_und_Einstieg_CATEGORY_VALUE</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Eintritt_und_aktuellen_zu_Erstanlage_oder_Fortsetzung_XOR_FLOW" name="" sourceRef="Eintritt_und_aktuellen_Fallstand_pruefen_SERVICE" targetRef="Erstanlage_oder_Fortsetzung_XOR">
      <bpmn:categoryValueRef>Fallstand_und_Einstieg_CATEGORY_VALUE</bpmn:categoryValueRef>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Erstanlage_oder_Fortsetzung_INITIAL_zu_Status_speichern_In_Abklaerung_FLOW" name="INITIAL" sourceRef="Erstanlage_oder_Fortsetzung_XOR" targetRef="Status_speichern_In_Abklaerung_SERVICE">
      <bpmn:categoryValueRef>Fallstand_und_Einstieg_CATEGORY_VALUE</bpmn:categoryValueRef>
