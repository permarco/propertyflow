<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" targetNamespace="https://propertyflow.local/test">
 <bpmn:message id="Contact" name="propertyflow.follow-up.contact"><bpmn:extensionElements><zeebe:subscription correlationKey="=activeWaitRef" /></bpmn:extensionElements></bpmn:message>
<bpmn:message id="Message_StaffQuestion" name="Mitarbeiternachricht während Wiedervorlage angefordert"><bpmn:extensionElements><zeebe:subscription correlationKey="=followUpScopeRef" /></bpmn:extensionElements></bpmn:message>
  
<bpmn:error id="Error_FollowUpChangeStale" errorCode="FOLLOW_UP_CHANGE_STALE" />
 <bpmn:message id="Change" name="Wiedervorlage ändern"><bpmn:extensionElements><zeebe:subscription correlationKey="=activeWaitRef" /></bpmn:extensionElements></bpmn:message><bpmn:message id="Delete" name="Wiedervorlage löschen"><bpmn:extensionElements><zeebe:subscription correlationKey="=activeWaitRef" /></bpmn:extensionElements></bpmn:message>
<bpmn:message id="CloseMessage" name="Mitarbeiterabschluss bestätigt"><bpmn:extensionElements><zeebe:subscription correlationKey="=activeWaitRef" /></bpmn:extensionElements></bpmn:message><bpmn:process id="PropertyFlow_FollowUp_Draft" isExecutable="true">
  <bpmn:startEvent id="WStart"><bpmn:outgoing>W01</bpmn:outgoing></bpmn:startEvent><bpmn:sequenceFlow id="W01" sourceRef="WStart" targetRef="WSave" />
  <bpmn:serviceTask id="WSave"><bpmn:extensionElements><zeebe:taskDefinition type="propertyflow.follow-up.save" /></bpmn:extensionElements><bpmn:incoming>W01</bpmn:incoming><bpmn:outgoing>W02</bpmn:outgoing></bpmn:serviceTask>
  <bpmn:sequenceFlow id="W02" sourceRef="WSave" targetRef="Gateway_0z8028n" /><bpmn:exclusiveGateway id="Gateway_0z8028n"><bpmn:incoming>WUpdateRetry</bpmn:incoming><bpmn:incoming>WDeleteTaskRetry</bpmn:incoming><bpmn:incoming>WCloseTaskRetry</bpmn:incoming><bpmn:incoming>W02</bpmn:incoming><bpmn:incoming>AfterChange</bpmn:incoming><bpmn:outgoing>Flow_1azuihh</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sequenceFlow id="Flow_1azuihh" sourceRef="Gateway_0z8028n" targetRef="WEvents" /><bpmn:eventBasedGateway id="WEvents"><bpmn:incoming>Flow_1azuihh</bpmn:incoming><bpmn:outgoing>ToClose</bpmn:outgoing><bpmn:outgoing>W03</bpmn:outgoing><bpmn:outgoing>WContact</bpmn:outgoing><bpmn:outgoing>ToChange</bpmn:outgoing><bpmn:outgoing>ToDelete</bpmn:outgoing></bpmn:eventBasedGateway>
  <bpmn:sequenceFlow id="W03" sourceRef="WEvents" targetRef="WTimer" />
  <bpmn:intermediateCatchEvent id="WTimer"><bpmn:incoming>W03</bpmn:incoming><bpmn:outgoing>W09</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDate xsi:type="bpmn:tFormalExpression">=followUpDueAt</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
  <bpmn:sequenceFlow id="W09" sourceRef="WTimer" targetRef="WClearTimer" />
  <bpmn:serviceTask id="WClearTimer"><bpmn:extensionElements><zeebe:taskDefinition type="propertyflow.follow-up.timer" /></bpmn:extensionElements><bpmn:incoming>W09</bpmn:incoming><bpmn:outgoing>W10</bpmn:outgoing></bpmn:serviceTask>
  <bpmn:sequenceFlow id="W10" sourceRef="WClearTimer" targetRef="WReviewEnd" />
  <bpmn:sequenceFlow id="WContact" sourceRef="WEvents" targetRef="ContactReceived" />
  <bpmn:intermediateCatchEvent id="ContactReceived"><bpmn:incoming>WContact</bpmn:incoming><bpmn:outgoing>ContactClear</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Contact" /></bpmn:intermediateCatchEvent>
  <bpmn:sequenceFlow id="ContactClear" sourceRef="ContactReceived" targetRef="WClearContact" />
  <bpmn:serviceTask id="WClearContact"><bpmn:extensionElements><zeebe:taskDefinition type="propertyflow.follow-up.contact" /></bpmn:extensionElements><bpmn:incoming>ContactClear</bpmn:incoming><bpmn:outgoing>ContactEnd</bpmn:outgoing></bpmn:serviceTask>
  <bpmn:sequenceFlow id="ContactEnd" sourceRef="WClearContact" targetRef="WReviewEnd" /><bpmn:endEvent id="WReviewEnd"><bpmn:incoming>W10</bpmn:incoming><bpmn:incoming>ContactEnd</bpmn:incoming></bpmn:endEvent>
<bpmn:subProcess id="WQuestionSide" name="Nachricht als Nebenaktion – Timer läuft weiter" triggeredByEvent="true">
      <bpmn:documentation>0.33 / KOM-AK-31: Nicht unterbrechende Nebenaktion für Information oder Rückfrage. Nachricht setzt, beendet oder verlängert keinen Timer; Terminversion und Wartephase bleiben unverändert. Keine lokalen Hauptpfad-Ergebnisse überschreiben. Aktuellen Fallstand und zuständigen Wiedervorlage-Aufruf prüfen; Konkurrenz mit Timer, Mieterkontakt und Mitarbeiterentscheidung koordinieren.</bpmn:documentation>
      <bpmn:startEvent id="WQuestionStart" name="Sendeauftrag eingegangen" isInterrupting="false">
        <bpmn:documentation>
Nach Auslagerung Zielinstanz serverseitig über die aktuelle Wiedervorlage-Zuordnung bestimmen. Keine Korrelation allein an den führenden Hauptprozess. Bestehende Mitarbeiterberechtigungen und Versionsschutz bleiben verbindlich; kein zusätzlicher externer Mieternachrichteneingang.</bpmn:documentation>
        <bpmn:outgoing>W20</bpmn:outgoing><bpmn:messageEventDefinition id="WQuestionStart_definition" messageRef="Message_StaffQuestion" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="WPublish" name="Nachricht mit optionalem Antwortbedarf&#10;veröffentlichen – Termin bleibt">
        <bpmn:documentation>BEN-03 / 0.23: Bei tatsächlicher benachrichtigungspflichtiger Änderung Ereignis und Mailpflicht dauerhaft zusammen sichern. Der dauerhafte Starter startet fallbenachrichtigung-versenden.bpmn mit mailOrderRef; dort beauftragen Camunda-Send-Tasks den Mail-Worker. Hier kein direkter SMTP-Aufruf und kein Warten auf SMTP. Unveränderte Werte und identische Wiederholungen erzeugen keine neue Mailpflicht.
0.33: Berechtigung, aktuellen führenden Durchlauf, Wiedervorlage-Call/Kindinstanz, Terminversion, Status und bestätigte Fallversion vor Speicherung prüfen. Text und Antwortbedarf aus bestätigtem Auftrag. Ohne Antwortbedarf nur Information, mit Bedarf zusätzliche offene Rückfrage; bestehende Fragen erhalten. Nachricht, optionalen Bedarf und Mailpflicht konsistent sichern, ohne Status-/Termin-/Timeränderung. Alter unveröffentlichter Auftrag nach Timerablauf, Kontakt oder anderer Fortsetzung ohne Wirkung ablehnen und Text erhalten. Identischer erfolgreicher Retry ohne Duplikat oder neue Mailpflicht. Technische Fehler Retry/Incident; bereits gespeicherter Versand bleibt bei späterer Fortsetzung bestehen. Neue zwingende Prüfgründe über bestehenden separaten Pfad behandeln.</bpmn:documentation>
        <bpmn:extensionElements><zeebe:taskDefinition type="propertyflow.staff-message.publish" /></bpmn:extensionElements>
        <bpmn:incoming>W20</bpmn:incoming><bpmn:outgoing>W21</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="WQuestionEnd" name="Nebenaktion beendet">
        <bpmn:incoming>W21</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="W20" sourceRef="WQuestionStart" targetRef="WPublish" />
      <bpmn:sequenceFlow id="W21" sourceRef="WPublish" targetRef="WQuestionEnd" />
    </bpmn:subProcess>
    
 <bpmn:sequenceFlow id="ToChange" sourceRef="WEvents" targetRef="WChange" /><bpmn:intermediateCatchEvent id="WChange"><bpmn:incoming>ToChange</bpmn:incoming><bpmn:outgoing>ApplyChange</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Change" /></bpmn:intermediateCatchEvent><bpmn:sequenceFlow id="ApplyChange" sourceRef="WChange" targetRef="WUpdate" /><bpmn:serviceTask id="WUpdate"><bpmn:extensionElements><zeebe:taskDefinition type="propertyflow.follow-up.change" /></bpmn:extensionElements><bpmn:incoming>ApplyChange</bpmn:incoming><bpmn:outgoing>AfterChange</bpmn:outgoing></bpmn:serviceTask><bpmn:sequenceFlow id="AfterChange" sourceRef="WUpdate" targetRef="Gateway_0z8028n" /><bpmn:sequenceFlow id="ToDelete" sourceRef="WEvents" targetRef="WDelete" /><bpmn:intermediateCatchEvent id="WDelete"><bpmn:incoming>ToDelete</bpmn:incoming><bpmn:outgoing>ApplyDelete</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Delete" /></bpmn:intermediateCatchEvent><bpmn:sequenceFlow id="ApplyDelete" sourceRef="WDelete" targetRef="WDeleteTask" /><bpmn:serviceTask id="WDeleteTask"><bpmn:extensionElements><zeebe:taskDefinition type="propertyflow.follow-up.change" /></bpmn:extensionElements><bpmn:incoming>ApplyDelete</bpmn:incoming><bpmn:outgoing>AfterDelete</bpmn:outgoing></bpmn:serviceTask><bpmn:sequenceFlow id="AfterDelete" sourceRef="WDeleteTask" targetRef="WProgressEnd" /><bpmn:endEvent id="WProgressEnd"><bpmn:incoming>AfterDelete</bpmn:incoming></bpmn:endEvent><bpmn:boundaryEvent id="WUpdateStale" attachedToRef="WUpdate"><bpmn:outgoing>WUpdateRetry</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_FollowUpChangeStale" /></bpmn:boundaryEvent><bpmn:sequenceFlow id="WUpdateRetry" sourceRef="WUpdateStale" targetRef="Gateway_0z8028n" />
  <bpmn:boundaryEvent id="WDeleteTaskStale" attachedToRef="WDeleteTask"><bpmn:outgoing>WDeleteTaskRetry</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_FollowUpChangeStale" /></bpmn:boundaryEvent><bpmn:sequenceFlow id="WDeleteTaskRetry" sourceRef="WDeleteTaskStale" targetRef="Gateway_0z8028n" />
  <bpmn:sequenceFlow id="ToClose" sourceRef="WEvents" targetRef="WClose" />
<bpmn:intermediateCatchEvent id="WClose"><bpmn:incoming>ToClose</bpmn:incoming><bpmn:outgoing>ApplyClose</bpmn:outgoing><bpmn:messageEventDefinition messageRef="CloseMessage" /></bpmn:intermediateCatchEvent>
<bpmn:sequenceFlow id="ApplyClose" sourceRef="WClose" targetRef="WCloseTask" />
<bpmn:serviceTask id="WCloseTask"><bpmn:extensionElements><zeebe:taskDefinition type="propertyflow.follow-up.close" /></bpmn:extensionElements><bpmn:incoming>ApplyClose</bpmn:incoming><bpmn:outgoing>AfterClose</bpmn:outgoing></bpmn:serviceTask>
<bpmn:sequenceFlow id="AfterClose" sourceRef="WCloseTask" targetRef="WCloseEnd" /><bpmn:endEvent id="WCloseEnd"><bpmn:incoming>AfterClose</bpmn:incoming></bpmn:endEvent><bpmn:boundaryEvent id="WCloseTaskStale" attachedToRef="WCloseTask"><bpmn:outgoing>WCloseTaskRetry</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_FollowUpChangeStale" /></bpmn:boundaryEvent><bpmn:sequenceFlow id="WCloseTaskRetry" sourceRef="WCloseTaskStale" targetRef="Gateway_0z8028n" /></bpmn:process>
</bpmn:definitions>