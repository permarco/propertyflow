<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="https://propertyflow.local/test">
  <bpmn:error id="EvaluationStale" errorCode="TENANT_EVALUATION_STALE" />
  <bpmn:process id="PropertyFlow_TenantMessage_Draft" isExecutable="true">
    <bpmn:documentation>Central evaluation fixture: durable input, shared model evaluation and guarded application.</bpmn:documentation>
    <bpmn:startEvent id="NProcessingStart" />
    <bpmn:sequenceFlow id="N01" sourceRef="NProcessingStart" targetRef="NIdentify" />
    <bpmn:serviceTask id="NIdentify">
      <bpmn:extensionElements><zeebe:taskDefinition type="propertyflow.tenant-message.identify" /></bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="N02" sourceRef="NIdentify" targetRef="NAccept" />
    <bpmn:exclusiveGateway id="NAccept" default="N03" />
    <bpmn:sequenceFlow id="N03" sourceRef="NAccept" targetRef="NNoOpEnd" />
    <bpmn:endEvent id="NNoOpEnd" />
    <bpmn:sequenceFlow id="N04" sourceRef="NAccept" targetRef="NAnalyze">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= tenantMessageAccepted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="NAnalyze"><bpmn:extensionElements><zeebe:taskDefinition type="propertyflow.conversation.evaluate" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="ToApply" sourceRef="NAnalyze" targetRef="NApply" />
    <bpmn:serviceTask id="NApply"><bpmn:extensionElements><zeebe:taskDefinition type="propertyflow.conversation.apply" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:boundaryEvent id="NApplyStale" attachedToRef="NApply"><bpmn:errorEventDefinition errorRef="EvaluationStale" /></bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="ToCurrent" sourceRef="NApplyStale" targetRef="NCurrentEvaluation" />
    <bpmn:serviceTask id="NCurrentEvaluation"><bpmn:extensionElements><zeebe:taskDefinition type="propertyflow.conversation.evaluate" /></bpmn:extensionElements></bpmn:serviceTask>
    <bpmn:sequenceFlow id="CurrentApply" sourceRef="NCurrentEvaluation" targetRef="NApply" />
    <bpmn:sequenceFlow id="TestEndFlow" sourceRef="NApply" targetRef="TestEnd" />
    <bpmn:endEvent id="TestEnd" />
  </bpmn:process>
</bpmn:definitions>
