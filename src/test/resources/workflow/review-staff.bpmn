<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="https://propertyflow.local/test">
  <bpmn:process id="PropertyFlow_Staff_Draft" isExecutable="true">
    <bpmn:documentation>Review entry integration fixture. Staff decisions beyond SReview are deliberately not implemented here.</bpmn:documentation>
    <bpmn:startEvent id="SStart" />
    <bpmn:sequenceFlow id="S01" sourceRef="SStart" targetRef="SEntryCheck" />
    <bpmn:serviceTask id="SEntryCheck">
      <bpmn:extensionElements><zeebe:taskDefinition type="propertyflow.staff.register" /></bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="EntryRoute" sourceRef="SEntryCheck" targetRef="SEntryRoute" />
    <bpmn:exclusiveGateway id="SEntryRoute" />
    <bpmn:sequenceFlow id="S_EntryReview" sourceRef="SEntryRoute" targetRef="SReviewStatus">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffEntryKind = "REVIEW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="SReviewStatus">
      <bpmn:extensionElements><zeebe:taskDefinition type="propertyflow.staff.start-review" /></bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="S02" sourceRef="SReviewStatus" targetRef="SReview" />
    <bpmn:userTask id="SReview" name="Fall prüfen und Vorgehen entscheiden">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="TestStop" sourceRef="SReview" targetRef="UnimplementedDecision" />
    <bpmn:serviceTask id="UnimplementedDecision">
      <bpmn:extensionElements><zeebe:taskDefinition type="propertyflow-test-unimplemented-staff-decision" /></bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="TestEndFlow" sourceRef="UnimplementedDecision" targetRef="TestEnd" />
    <bpmn:endEvent id="TestEnd" />
  </bpmn:process>
</bpmn:definitions>
