<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" targetNamespace="https://propertyflow.local/test">
  <bpmn:error id="Error_StaffDecisionStale" errorCode="STAFF_DECISION_STALE" />
  <bpmn:process id="PropertyFlow_Staff_Draft" isExecutable="true">
    <bpmn:documentation>Integration fixture for review, explicit continuation and staff closure. Other staff decisions are not implemented here.</bpmn:documentation>
    <bpmn:startEvent id="SStart">
      <bpmn:outgoing>S01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="S01" sourceRef="SStart" targetRef="SEntryCheck" />
    <bpmn:serviceTask id="SEntryCheck">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="propertyflow.staff.register" />
      </bpmn:extensionElements>
      <bpmn:incoming>S01</bpmn:incoming>
      <bpmn:outgoing>EntryRoute</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="EntryRoute" sourceRef="SEntryCheck" targetRef="SEntryRoute" />
    <bpmn:exclusiveGateway id="SEntryRoute">
      <bpmn:incoming>EntryRoute</bpmn:incoming>
      <bpmn:outgoing>S_EntryReview</bpmn:outgoing>
      <bpmn:outgoing>S_EntryWork</bpmn:outgoing>
      <bpmn:outgoing>DirectToFollow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="S_EntryReview" sourceRef="SEntryRoute" targetRef="SReviewStatus">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffEntryKind = "REVIEW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="SReviewStatus">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="propertyflow.staff.start-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>S_EntryReview</bpmn:incoming>
      <bpmn:incoming>SProgressRetry</bpmn:incoming>
      <bpmn:incoming>SQuestionRetry</bpmn:incoming>
      <bpmn:incoming>FollowRetry</bpmn:incoming>
      <bpmn:incoming>ContactReview</bpmn:incoming>
      <bpmn:incoming>WaitToReview</bpmn:incoming>
      <bpmn:outgoing>S02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="S02" sourceRef="SReviewStatus" targetRef="SReview" />
    <bpmn:userTask id="SReview" name="Fall prüfen und Vorgehen entscheiden">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>S02</bpmn:incoming>
      <bpmn:outgoing>S03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="S03" sourceRef="SReview" targetRef="SDecision" />
    <bpmn:exclusiveGateway id="SDecision">
      <bpmn:incoming>S03</bpmn:incoming>
      <bpmn:outgoing>S04</bpmn:outgoing>
      <bpmn:outgoing>S08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="S04" sourceRef="SDecision" targetRef="SProgress">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffDecision = "CONTINUE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="S08" sourceRef="SDecision" targetRef="SCloseEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffDecision = "CLOSE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="SProgress">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="propertyflow.staff.progress" />
      </bpmn:extensionElements>
      <bpmn:incoming>S04</bpmn:incoming>
      <bpmn:incoming>WaitToWork</bpmn:incoming>
      <bpmn:outgoing>S05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="SProgressStale" attachedToRef="SProgress">
      <bpmn:outgoing>SProgressRetry</bpmn:outgoing>
      <bpmn:errorEventDefinition id="SProgressStale_definition" errorRef="Error_StaffDecisionStale" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="SProgressRetry" sourceRef="SProgressStale" targetRef="SReviewStatus" />
    <bpmn:sequenceFlow id="S05" sourceRef="SProgress" targetRef="SWork" />
    <bpmn:userTask id="SWork">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>S05</bpmn:incoming>
      <bpmn:incoming>S_EntryWork</bpmn:incoming>
      <bpmn:outgoing>S06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="S06" sourceRef="SWork" targetRef="SWorkDecision" />
    <bpmn:exclusiveGateway id="SWorkDecision">
      <bpmn:incoming>S06</bpmn:incoming>
      <bpmn:outgoing>S11</bpmn:outgoing>
      <bpmn:outgoing>S09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="S11" sourceRef="SWorkDecision" targetRef="SCloseEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffDecision = "CLOSE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="SCloseEnd">
      <bpmn:incoming>S08</bpmn:incoming>
      <bpmn:incoming>S11</bpmn:incoming>
      <bpmn:incoming>WaitToClose</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="SQuestion">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="propertyflow.staff-question.publish" />
      </bpmn:extensionElements>
      <bpmn:incoming>S09</bpmn:incoming>
      <bpmn:outgoing>S10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="S09" sourceRef="SWorkDecision" targetRef="SQuestion">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffDecision = "QUESTION"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="SReplyEnd">
      <bpmn:incoming>S10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="S10" sourceRef="SQuestion" targetRef="SReplyEnd" />
    <bpmn:boundaryEvent id="SQuestionStale" attachedToRef="SQuestion">
      <bpmn:outgoing>SQuestionRetry</bpmn:outgoing>
      <bpmn:errorEventDefinition id="SQuestionStale_definition" errorRef="Error_StaffDecisionStale" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="SQuestionRetry" sourceRef="SQuestionStale" targetRef="SReviewStatus" />
    <bpmn:sequenceFlow id="S_EntryWork" sourceRef="SEntryRoute" targetRef="SWork">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffEntryKind = "WORK"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:callActivity id="FollowUp">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="PropertyFlow_FollowUp_Draft" propagateAllChildVariables="false" propagateAllParentVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=caseId" target="caseId" />
          <zeebe:input source="=leadingProcessInstanceKey" target="leadingProcessInstanceKey" />
          <zeebe:input source="=staffDecisionRef" target="staffDecisionRef" />
          <zeebe:output source="=outcome" target="waitOutcome" />
          <zeebe:input source="= followUpEntryContextRef" target="activeWaitRef" />
          <zeebe:input source="= followUpEntryContextRef" target="followUpScopeRef" />
          <zeebe:output source="= outcome" target="outcome" />
          <zeebe:output source="= decisionRef" target="decisionRef" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>DirectToFollow</bpmn:incoming>
      <bpmn:outgoing>FollowReview</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="SFollowResult">
      <bpmn:incoming>FollowReview</bpmn:incoming>
      <bpmn:outgoing>WaitToClose</bpmn:outgoing>
      <bpmn:outgoing>WaitToReview</bpmn:outgoing>
      <bpmn:outgoing>WaitToWork</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="SContactDuringFollowUp" attachedToRef="FollowUp">
      <bpmn:outgoing>ContactStop</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="ContactFollowUp_definition">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">=pendingTenantContactFollowUpVersion != null and pendingTenantContactFollowUpVersion = activeFollowUpVersion</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="SFollowUpReviewNeeded" attachedToRef="FollowUp">
      <bpmn:outgoing>SFollowUpReviewNeededFlow</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="SFollowUpReviewNeeded_definition">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">= pendingReviewFollowUpVersion != null and pendingReviewFollowUpVersion = activeFollowUpVersion</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="SStopFollowUp">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="propertyflow.follow-up.stop-contact" />
      </bpmn:extensionElements>
      <bpmn:incoming>ContactStop</bpmn:incoming>
      <bpmn:incoming>SFollowUpReviewNeededFlow</bpmn:incoming>
      <bpmn:outgoing>ContactReview</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="FollowStale" attachedToRef="FollowUp">
      <bpmn:outgoing>FollowRetry</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_StaffDecisionStale" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="FollowReview" sourceRef="FollowUp" targetRef="SFollowResult" />
    <bpmn:sequenceFlow id="FollowRetry" sourceRef="FollowStale" targetRef="SReviewStatus" />
    <bpmn:sequenceFlow id="ContactStop" sourceRef="SContactDuringFollowUp" targetRef="SStopFollowUp" />
    <bpmn:sequenceFlow id="ContactReview" sourceRef="SStopFollowUp" targetRef="SReviewStatus" />
    <bpmn:sequenceFlow id="SFollowUpReviewNeededFlow" sourceRef="SFollowUpReviewNeeded" targetRef="SStopFollowUp" />
    <bpmn:sequenceFlow id="WaitToClose" sourceRef="SFollowResult" targetRef="SCloseEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=waitOutcome = "CLOSE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="WaitToReview" sourceRef="SFollowResult" targetRef="SReviewStatus">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=waitOutcome = "REVIEW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="WaitToWork" sourceRef="SFollowResult" targetRef="SProgress">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=waitOutcome = "CONTINUE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="DirectToFollow" sourceRef="SEntryRoute" targetRef="FollowUp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= staffEntryKind = "FOLLOW_UP"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
</bpmn:definitions>