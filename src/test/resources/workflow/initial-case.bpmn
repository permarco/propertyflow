<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="https://propertyflow.local/test">
  <bpmn:message id="TenantMessage" name="propertyflow-test-tenant-message">
    <bpmn:extensionElements><zeebe:subscription correlationKey="=processInstanceKey" /></bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="PropertyFlow_Case_Draft" isExecutable="true">
    <bpmn:documentation>Integration fixture for INITIAL only. Mirrors the canonical entry and call scopes.
      This is not the deployable full case process. Unimplemented processing stays at a waiting test job.</bpmn:documentation>
    <bpmn:startEvent id="ProcessStart" />
    <bpmn:sequenceFlow id="K1" sourceRef="ProcessStart" targetRef="PrepareProcessKey" />
    <bpmn:serviceTask id="PrepareProcessKey">
      <bpmn:extensionElements><zeebe:taskDefinition type="propertyflow-prepare-process-key" /></bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="K2" sourceRef="PrepareProcessKey" targetRef="ActiveCase" />
    <bpmn:subProcess id="ActiveCase">
      <bpmn:startEvent id="Start" />
      <bpmn:sequenceFlow id="F_Initial" sourceRef="Start" targetRef="Register" />
      <bpmn:serviceTask id="Register">
        <bpmn:extensionElements><zeebe:taskDefinition type="propertyflow-register-case" /></bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="F02" sourceRef="Register" targetRef="PrepareInitialAuto" />
      <bpmn:serviceTask id="PrepareInitialAuto">
        <bpmn:extensionElements><zeebe:taskDefinition type="propertyflow-prepare-initial" /></bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="InitialAutomatic" sourceRef="PrepareInitialAuto" targetRef="Automatic" />
      <bpmn:callActivity id="Automatic">
        <bpmn:extensionElements>
          <zeebe:calledElement processId="PropertyFlow_Automatic_Draft" bindingType="deployment"
                               propagateAllChildVariables="false" propagateAllParentVariables="false" />
          <zeebe:ioMapping>
            <zeebe:input source="=caseId" target="caseId" />
            <zeebe:input source="=processInstanceKey" target="leadingProcessInstanceKey" />
            <zeebe:input source="=automaticEntryContextRef" target="entryContextRef" />
            <zeebe:input source="=automaticCallRef" target="automaticCallRef" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="AutomaticEnd" sourceRef="Automatic" targetRef="ActiveEnd" />
      <bpmn:endEvent id="ActiveEnd" />
      <bpmn:subProcess id="TenantMessageSide" triggeredByEvent="true">
        <bpmn:startEvent id="TenantMessageStart" isInterrupting="false">
          <bpmn:messageEventDefinition messageRef="TenantMessage" />
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="MessageWait" sourceRef="TenantMessageStart" targetRef="MessageTestBoundary" />
        <bpmn:serviceTask id="MessageTestBoundary">
          <bpmn:extensionElements><zeebe:taskDefinition type="propertyflow-test-unimplemented-message" /></bpmn:extensionElements>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="MessageEndFlow" sourceRef="MessageTestBoundary" targetRef="MessageEnd" />
        <bpmn:endEvent id="MessageEnd" />
      </bpmn:subProcess>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="EndFlow" sourceRef="ActiveCase" targetRef="End" />
    <bpmn:endEvent id="End" />
  </bpmn:process>
</bpmn:definitions>
