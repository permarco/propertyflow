        <dc:Bounds x="795" y="655" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="832.0" y="717.0" width="130.0" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NWake_di" bpmnElement="NWake" bioc:stroke="#1e3a5f" bioc:fill="#e2ecff">
        <dc:Bounds x="985" y="630" width="250" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NKeepReview_di" bpmnElement="NKeepReview" bioc:stroke="#1e3a5f" bioc:fill="#e2ecff">
        <dc:Bounds x="985" y="440" width="250" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NRefresh_di" bpmnElement="NRefresh" bioc:stroke="#1e3a5f" bioc:fill="#e2ecff">
        <dc:Bounds x="985" y="820" width="250" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NJoin_di" bpmnElement="NJoin" isMarkerVisible="true" bioc:stroke="#334155" bioc:fill="#f1f5f9">
        <dc:Bounds x="1325" y="655" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1362.0" y="717.0" width="104.0" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NFailure_di" bpmnElement="NFailure" bioc:stroke="#1e3a5f" bioc:fill="#e2ecff">
        <dc:Bounds x="1974" y="820" width="250" height="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2030.75" y="932.0" width="136.5" height="36" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Merge_NApply_di" bpmnElement="Merge_NApply" isMarkerVisible="true">
