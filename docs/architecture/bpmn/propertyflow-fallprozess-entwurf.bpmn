      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="SQ_Takeover_CurrentAnalysis" sourceRef="StaffQuestionAtCurrentAnalysis" targetRef="StaffQuestionJoin" />
      <bpmn:boundaryEvent id="StaffQuestionAtQuestion" attachedToRef="Question" cancelActivity="true">
        <bpmn:documentation>Fachlicher Unterbrechungsmarker nur für bestätigte Mitarbeiterrückfrage aus In Abklärung im aktuellen Durchlauf. Bedingung und Zustellung sind Entwurf, keine zugesicherte Engine-Ausführung. Nicht für reguläre spätere Mieterwarte- oder Mitarbeiterpfade aktivieren.</bpmn:documentation>
        <bpmn:outgoing>SQ_Takeover_Question</bpmn:outgoing>
        <bpmn:conditionalEventDefinition id="StaffQuestionAtQuestion_definition">
          <bpmn:condition xsi:type="bpmn:tFormalExpression">= staffQuestionTakeoverReady = true</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="SQ_Takeover_Question" sourceRef="StaffQuestionAtQuestion" targetRef="StaffQuestionJoin" />
      <bpmn:boundaryEvent id="StaffQuestionAtAutoAnswer" attachedToRef="AutoAnswer" cancelActivity="true">
        <bpmn:documentation>Fachlicher Unterbrechungsmarker nur für bestätigte Mitarbeiterrückfrage aus In Abklärung im aktuellen Durchlauf. Bedingung und Zustellung sind Entwurf, keine zugesicherte Engine-Ausführung. Nicht für reguläre spätere Mieterwarte- oder Mitarbeiterpfade aktivieren.</bpmn:documentation>
        <bpmn:outgoing>SQ_Takeover_AutoAnswer</bpmn:outgoing>
