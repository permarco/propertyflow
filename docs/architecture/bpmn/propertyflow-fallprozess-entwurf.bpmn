      <bpmn:sequenceFlow id="SQ_Takeover_Validate" sourceRef="StaffQuestionAtValidate" targetRef="StaffQuestionJoin" />
      <bpmn:boundaryEvent id="StaffQuestionAtCurrentAnalysis" attachedToRef="CurrentAnalysis" cancelActivity="true">
        <bpmn:documentation>Fachlicher Unterbrechungsmarker nur für bestätigte Mitarbeiterrückfrage aus In Abklärung im aktuellen Durchlauf. Bedingung und Zustellung sind Entwurf, keine zugesicherte Engine-Ausführung. Nicht für reguläre spätere Mieterwarte- oder Mitarbeiterpfade aktivieren.</bpmn:documentation>
        <bpmn:outgoing>SQ_Takeover_CurrentAnalysis</bpmn:outgoing>
        <bpmn:conditionalEventDefinition id="StaffQuestionAtCurrentAnalysis_definition">
