    <bpmn:sequenceFlow id="W10" sourceRef="WClearTimer" targetRef="WReviewEnd" />
    <bpmn:sequenceFlow id="W14" sourceRef="WChange" targetRef="WUpdate" />
    <bpmn:sequenceFlow id="W15" sourceRef="WUpdate" targetRef="Gateway_0z8028n" />
    <bpmn:sequenceFlow id="W16" sourceRef="WDelete" targetRef="WDeleteTask" />
    <bpmn:sequenceFlow id="W17" sourceRef="WDeleteTask" targetRef="WProgressEnd" />
